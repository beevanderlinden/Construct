@using Eurocode.BetonConstructies
@using Eurocode.Belastingen
@using CommonLibrary.Models
@using Profielen.Staal
@using System.Globalization

<PageTitle>@PageTitel</PageTitle>

<div class="page-container">
    <div class="demo-grid">

        <div class="visualisatie-panel">
            <h3>Doorsnede visualisatie</h3>

            @if (MateriaalType == DoorsneeDemoMateriaalType.Staal && _huidigStaalProfiel != null)
            {
                <!-- I/H profiel doorsnede met maatlijnen (exacte geometrie via ProfielIH.SvgPath) -->
                <svg viewBox="@GetIHProfielViewBox(_huidigStaalProfiel)"
                     preserveAspectRatio="xMidYMid meet"
                     style="width:100%;height:auto;max-width:900px;max-height:900px;border:1px solid var(--neutral-stroke-rest);">
                    <path d="@_huidigStaalProfiel.SvgPath"
                          fill="#b0bec5" fill-opacity="0.85" fill-rule="evenodd"
                          stroke="#37474f" stroke-width="1.5" />
                    @((MarkupString)GetIHDimensieSvg(_huidigStaalProfiel))
                </svg>
            }
            else
            {
                <BetonBalkDoorsnedeEditor
                    @bind-Breedte="breedte"
                    @bind-Hoogte="hoogte"
                    BreedteMin="@BreedteMinVal" BreedteMax="@BreedteMaxVal" BreedteStep="@BreedteStepVal"
                    HoogteMin="@HoogteMinVal"  HoogteMax="@HoogteMaxVal"  HoogteStep="@HoogteStepVal"
                    BeugelWapening="@beugelWapening"
                    WapeningBoven="@wapeningBoven"
                    WapeningOnder="@wapeningOnder"
                    WapeningZijLinks="@wapeningZijLinks"
                    WapeningZijRechts="@wapeningZijRechts"
                    ToonLegenda="@(MateriaalType == DoorsneeDemoMateriaalType.Beton && toonLegenda)"
                    FocusElement="@focusElement"
                    InteractieveMaatlijnen="@MaatlijnenInteractief"
                    ToonHoutPatroon="@(MateriaalType == DoorsneeDemoMateriaalType.Hout)" />
            }

        </div>

        <!-- Verticale tab menu -->
        <div class="tab-menu">
            <button class="tab-btn @(activeTab == "geometrie" ? "active" : "")" @onclick='() => activeTab = "geometrie"'>
                <span class="tab-label">Geometrie</span>
            </button>
            @if (MateriaalType == DoorsneeDemoMateriaalType.Beton)
            {
                <button class="tab-btn @(activeTab == "beugels" ? "active" : "")" @onclick='() => activeTab = "beugels"'>
                    <span class="tab-label">Beugels</span>
                </button>
                <button class="tab-btn @(activeTab == "langswapening" ? "active" : "")" @onclick='() => activeTab = "langswapening"'>
                    <span class="tab-label">Langs</span>
                </button>
            }
            <button class="tab-btn @(activeTab == "krachten" ? "active" : "")" @onclick='() => activeTab = "krachten"'>
                <span class="tab-label">Krachten</span>
            </button>
            <button class="tab-btn @(activeTab == "resultaten" ? "active" : "")" @onclick='() => activeTab = "resultaten"'>
                <span class="tab-label">Resultaten</span>
            </button>
        </div>

        <div class="controls-panel">
            <h3>Parameters</h3>

            <!-- ?? GEOMETRIE ?????????????????????????????????????????????? -->
            @if (activeTab == "geometrie")
            {

            @* ?? Staal: profiel-keuze bepaalt de afmetingen ?? *@
            @if (MateriaalType == DoorsneeDemoMateriaalType.Staal)
            {
            <div class="control-section">
                <h4>Staalprofiel</h4>
                <label>
                    <span>Profieltype:</span>
                    <select @bind="staalProfielType" @bind:after="OnStaalProfielTypeChanged">
                        <option value="IPE">IPE</option>
                        <option value="HEA">HEA</option>
                        <option value="HEB">HEB</option>
                        <option value="HEM">HEM</option>
                    </select>
                    <span></span>
                </label>
                <label>
                    <span>Profiel:</span>
                    <select @bind="staalProfielNaam" @bind:after="OnStaalProfielMaatChanged">
                        @foreach (var p in GetProfielenVoorType(staalProfielType))
                        {
                            <option value="@p.Naam">@p.Naam</option>
                        }
                    </select>
                    <span></span>
                </label>
                @if (_huidigStaalProfiel != null)
                {
                    <label>
                        <span>h × b:</span>
                        <span class="profiel-dims">@_huidigStaalProfiel.H × @_huidigStaalProfiel.B mm</span>
                        <span></span>
                    </label>
                    <label>
                        <span>t<sub>f</sub> / t<sub>w</sub>:</span>
                        <span class="profiel-dims">@_huidigStaalProfiel.Tf / @_huidigStaalProfiel.Tw mm</span>
                        <span></span>
                    </label>
                    <label>
                        <span>A:</span>
                        <span class="profiel-dims">@($"{_huidigStaalProfiel.A / 100.0:F2}") cm²</span>
                        <span></span>
                    </label>
                    <label>
                        <span>I<sub>y</sub>:</span>
                        <span class="profiel-dims">@($"{_huidigStaalProfiel.Iy / 1e4:F0}") cm^4</span>
                        <span></span>
                    </label>
                    <label>
                        <span>W<sub>y,el</sub>:</span>
                        <span class="profiel-dims">@($"{_huidigStaalProfiel.WelY / 1e3:F0}") cm³</span>
                        <span></span>
                    </label>
                    <label>
                        <span>W<sub>y,pl</sub>:</span>
                        <span class="profiel-dims">@($"{_huidigStaalProfiel.WplY / 1e3:F0}") cm³</span>
                        <span></span>
                    </label>
                }
            </div>
            }

            @* ?? Beton / Hout: vrije afmeting-invoer ?? *@
            @if (MateriaalType != DoorsneeDemoMateriaalType.Staal)
            {
            <div class="control-section">
                <h4>Doorsnede afmetingen</h4>
                <label>
                    <span>Breedte (B):</span>
                    <input type="number" @bind="breedte" min="@BreedteMinVal" max="@BreedteMaxVal" step="@BreedteStepVal"
                           @onfocus='() => focusElement = "geometrie-breedte"'
                           @onblur='() => focusElement = ""' />
                    <span>mm</span>
                </label>
                <label>
                    <span>Hoogte (H):</span>
                    <input type="number" @bind="hoogte" min="@HoogteMinVal" max="@HoogteMaxVal" step="@HoogteStepVal"
                           @onfocus='() => focusElement = "geometrie-hoogte"'
                           @onblur='() => focusElement = ""' />
                    <span>mm</span>
                </label>
            </div>
            }

            <div class="control-section">
                <h4>Materiaal</h4>
                @if (MateriaalType == DoorsneeDemoMateriaalType.Beton)
                {
                    <label>
                        <span>Betonklasse:</span>
                        <select @bind="betonContext.Betonsterkteklasse">
                            <option value="@BetonsterkteklasseEnum.C12_15">C12/15</option>
                            <option value="@BetonsterkteklasseEnum.C16_20">C16/20</option>
                            <option value="@BetonsterkteklasseEnum.C20_25">C20/25</option>
                            <option value="@BetonsterkteklasseEnum.C25_30">C25/30</option>
                            <option value="@BetonsterkteklasseEnum.C30_37">C30/37</option>
                            <option value="@BetonsterkteklasseEnum.C35_45">C35/45</option>
                            <option value="@BetonsterkteklasseEnum.C40_50">C40/50</option>
                            <option value="@BetonsterkteklasseEnum.C45_55">C45/55</option>
                            <option value="@BetonsterkteklasseEnum.C50_60">C50/60</option>
                        </select>
                        <span></span>
                    </label>
                    <label>
                        <span>Wapeningsklasse:</span>
                        <select @bind="betonContext.BetonStaal.BetonStaalKwaliteit">
                            <option value="@BetonStaalKwaliteitEnum.B400A">B400A</option>
                            <option value="@BetonStaalKwaliteitEnum.B500A">B500A</option>
                        </select>
                        <span></span>
                    </label>
                }
                else if (MateriaalType == DoorsneeDemoMateriaalType.Staal)
                {
                    <label>
                        <span>Staalklasse:</span>
                        <select @bind="staalKlasse">
                            <option value="S235">S235</option>
                            <option value="S275">S275</option>
                            <option value="S355">S355</option>
                            <option value="S420">S420</option>
                            <option value="S460">S460</option>
                        </select>
                        <span></span>
                    </label>
                }
                else if (MateriaalType == DoorsneeDemoMateriaalType.Hout)
                {
                    <label>
                        <span>Houtklasse:</span>
                        <select @bind="houtKlasse">
                            <option value="C16">C16</option>
                            <option value="C18">C18</option>
                            <option value="C24">C24</option>
                            <option value="C27">C27</option>
                            <option value="C30">C30</option>
                            <option value="C35">C35</option>
                            <option value="GL24h">GL24h</option>
                            <option value="GL28h">GL28h</option>
                            <option value="GL32h">GL32h</option>
                        </select>
                        <span></span>
                    </label>
                }
            </div>
            }

            <!-- ?? BEUGELS (beton only) ??????????????????????????????????? -->
            @if (activeTab == "beugels" && MateriaalType == DoorsneeDemoMateriaalType.Beton && beugelWapening != null)
            {
            <div class="control-section">
                <h4>Beugels</h4>
                <label>
                    <span>Diameter:</span>
                    <select @bind="beugelWapening.Diameter" @bind:after="UpdateBuigstraal"
                            @onfocus='() => focusElement = "beugel-diameter"'
                            @onblur='() => focusElement = ""'>
                        <option value="5">Ø5</option>
                        <option value="6">Ø6</option>
                        <option value="8">Ø8</option>
                        <option value="10">Ø10</option>
                        <option value="12">Ø12</option>
                    </select>
                    <span></span>
                </label>
                <label>
                    <span>Aantal sneden:</span>
                    <select @bind="beugelWapening.AantalSneden"
                            @onfocus='() => focusElement = "beugel-sneden"'
                            @onblur='() => focusElement = ""'>
                        <option value="2">2-snedig</option>
                        <option value="3">3-snedig</option>
                        <option value="4">4-snedig</option>
                    </select>
                    <span></span>
                </label>
                <label>
                    <span>Hart-op-hart (s):</span>
                    <input type="number" @bind="beugelWapening.Hoh" min="50" max="400" step="10"
                           @onfocus='() => focusElement = "beugel-hoh"'
                           @onblur='() => focusElement = ""' />
                    <span>mm</span>
                </label>
                <label>
                    <span>Asw:</span>
                    <span>@($"{beugelWapening.Asw:F1}") mm²/m</span>
                    <span></span>
                </label>
                <label>
                    <span>Dekking:</span>
                    <input type="number" @bind="beugelDekking" @bind:after="UpdateBeugelDekking" min="20" max="50" step="5"
                           @onfocus='() => focusElement = "beugel-dekking"'
                           @onblur='() => focusElement = ""' />
                    <span>mm</span>
                </label>
            </div>
            }

            <!-- ?? LANGSWAPENING (beton only) ???????????????????????????? -->
            @if (activeTab == "langswapening" && MateriaalType == DoorsneeDemoMateriaalType.Beton)
            {
            <div class="control-section">
                <h4>Bovenwapening</h4>
                <label>
                    <span>Aantal (n):</span>
                    <input type="number" @bind="aantalBovenStaven" @bind:after="UpdateBovenWapening" min="2" max="10" step="1"
                           @onfocus='() => focusElement = "wapening-boven-aantal"'
                           @onblur='() => focusElement = ""' />
                    <span></span>
                </label>
                <label>
                    <span>Diameter (Ø):</span>
                    <select @bind="diameterBovenStaven" @bind:after="UpdateBovenWapening"
                            @onfocus='() => focusElement = "wapening-boven-diameter"'
                            @onblur='() => focusElement = ""'>
                        <option value="6">Ø6</option>
                        <option value="8">Ø8</option>
                        <option value="10">Ø10</option>
                        <option value="12">Ø12</option>
                        <option value="16">Ø16</option>
                        <option value="20">Ø20</option>
                        <option value="25">Ø25</option>
                        <option value="32">Ø32</option>
                        <option value="40">Ø40</option>
                    </select>
                    <span></span>
                </label>
                <label>
                    <span>Dekking:</span>
                    <input type="number" @bind="wapeningBoven!.DekkingToegepast" min="0" max="52" step="1" disabled="@autoUpdateDekking"
                           @onfocus='() => focusElement = "wapening-boven-dekking"'
                           @onblur='() => focusElement = ""' />
                    <span>mm</span>
                </label>
            </div>

            <div class="control-section">
                <h4>Onderwapening</h4>
                <label>
                    <span>Aantal (n):</span>
                    <input type="number" @bind="aantalOnderStaven" @bind:after="UpdateOnderWapening" min="2" max="10" step="1"
                           @onfocus='() => focusElement = "wapening-onder-aantal"'
                           @onblur='() => focusElement = ""' />
                    <span></span>
                </label>
                <label>
                    <span>Diameter (Ø):</span>
                    <select @bind="diameterOnderStaven" @bind:after="UpdateOnderWapening"
                            @onfocus='() => focusElement = "wapening-onder-diameter"'
                            @onblur='() => focusElement = ""'>
                        <option value="6">Ø6</option>
                        <option value="8">Ø8</option>
                        <option value="10">Ø10</option>
                        <option value="12">Ø12</option>
                        <option value="16">Ø16</option>
                        <option value="20">Ø20</option>
                        <option value="25">Ø25</option>
                        <option value="32">Ø32</option>
                        <option value="40">Ø40</option>
                    </select>
                    <span></span>
                </label>
                <label>
                    <span>Dekking:</span>
                    <input type="number" @bind="wapeningOnder!.DekkingToegepast" min="0" max="52" step="1" disabled="@autoUpdateDekking"
                           @onfocus='() => focusElement = "wapening-onder-dekking"'
                           @onblur='() => focusElement = ""' />
                    <span>mm</span>
                </label>
            </div>

            <div class="control-section">
                <h4>Zijwapening</h4>
                <label class="checkbox-label">
                    <input type="checkbox" @bind="toonZijwapening" @bind:after="UpdateZijwapening" />
                    <span>Toon zijwapening</span>
                </label>
                @if (toonZijwapening)
                {
                    <label>
                        <span>Aantal per zijde:</span>
                        <input type="number" @bind="aantalZijwapening" @bind:after="UpdateZijwapening" min="0" max="4" step="1"
                               @onfocus='() => focusElement = "wapening-zij-aantal"'
                               @onblur='() => focusElement = ""' />
                        <span></span>
                    </label>
                    <label>
                        <span>Diameter:</span>
                        <select @bind="diameterZijwapening" @bind:after="UpdateZijwapening"
                                @onfocus='() => focusElement = "wapening-zij-diameter"'
                                @onblur='() => focusElement = ""'>
                            <option value="8">Ø8</option>
                            <option value="10">Ø10</option>
                            <option value="12">Ø12</option>
                        </select>
                        <span></span>
                    </label>
                }
            </div>

            <div class="control-section">
                <h4>Opties</h4>
                <label class="checkbox-label">
                    <input type="checkbox" @bind="autoUpdateDekking" />
                    <span>Auto-update dekking langswapening</span>
                </label>
                <small class="help-text">Bij wijziging beugel automatisch dekking aanpassen</small>
                <button class="btn btn-secondary" @onclick="WijzigDekkingAutomatisch" style="margin-top: 0.5rem;">
                    Wijzig dekking automatisch
                </button>
                <small class="help-text">Past dekking langswapening aan naar beugeldekking + beugeldiameter</small>
            </div>
            }

            <!-- ?? KRACHTEN ??????????????????????????????????????????????? -->
            @if (activeTab == "krachten")
            {
            <div class="control-section">
                <h4>Interne krachten</h4>
                @foreach (var entry in krachtenLijst)
                {
                    var e = entry;
                    <div class="krachtentry" @key="e">
                        <div class="krachtentry-header">
                            <input type="text" class="naam-input" @bind="e.Naam" @bind:event="oninput" placeholder="Naam" />
                            <button class="btn-delete" @onclick="() => krachtenLijst.Remove(e)" title="Verwijder">&#x2715;</button>
                        </div>
                        <label>
                            <span>M<sub>y</sub>:</span>
                            <input type="number" @bind="e.My" step="0.1" />
                            <span>kNm</span>
                        </label>
                        <label>
                            <span>V<sub>z</sub>:</span>
                            <input type="number" @bind="e.Vz" step="0.1" />
                            <span>kN</span>
                        </label>
                    </div>
                }
                <button class="btn btn-secondary" style="margin-top:0.5rem;" @onclick="VoegKrachtToe">+ Kracht toevoegen</button>
            </div>

            <div class="control-section" style="opacity:0.5;pointer-events:none;">
                <h4>?? Buiging in Y-vlak <small>(later)</small></h4>
                <label><span>M<sub>z</sub>:</span><input type="number" value="0" readonly /><span>kNm</span></label>
                <label><span>V<sub>y</sub>:</span><input type="number" value="0" readonly /><span>kN</span></label>
            </div>

            <div class="control-section" style="opacity:0.5;pointer-events:none;">
                <h4>? Normaalkracht &amp; Torsie <small>(later)</small></h4>
                <label><span>N (normaalkracht):</span><input type="number" value="0" readonly /><span>kN</span></label>
                <label><span>T (torsie):</span><input type="number" value="0" readonly /><span>kNm</span></label>
            </div>
            }

            <!-- ?? RESULTATEN ????????????????????????????????????????????? -->
            @if (activeTab == "resultaten")
            {
            <div class="control-section">
                <h4>Weergave opties</h4>
                <label class="checkbox-label">
                    <input type="checkbox" @bind="toonMaatvoering" />
                    <span>Toon maatvoering</span>
                </label>
                <label class="checkbox-label">
                    <input type="checkbox" @bind="toonLegenda" />
                    <span>Toon legenda</span>
                </label>
            </div>

            @if (krachtenLijst.Count > 0)
            {
            <div class="control-section">
                <h4>Toetsen</h4>
                @foreach (var entry in krachtenLijst)
                {
                    var e = entry;
                    <div class="krachtentry-toets" @key="e">
                        <span class="krachtentry-naam">@e.Naam</span>
                        <div class="toets-buttons-inline">
                            <button class="btn btn-toets-small" @onclick="() => ToetsM(e.ToInternalForces(), e.Naam)" title="Toets momentweerstand (@EcLabel)">
                                <span class="toets-icon">M</span>
                            </button>
                            <button class="btn btn-toets-small" @onclick="() => ToetsV(e.ToInternalForces(), e.Naam)" title="Toets dwarskrachtweerstand (@EcLabel)">
                                <span class="toets-icon">V</span>
                            </button>
                            @if (MateriaalType == DoorsneeDemoMateriaalType.Beton)
                            {
                                <button class="btn btn-toets-small btn-toets-disabled" disabled title="Scheurwijdte toets (later)">
                                    <span class="toets-icon">Sw</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
            }

            @if (MateriaalType == DoorsneeDemoMateriaalType.Beton)
            {
            <div class="control-section">
                <h4>Doorsnede capaciteit</h4>
                <button class="btn btn-accent" @onclick="BerekenBuigweerstand">
                    Bereken M<sub>y,Rd</sub>
                </button>
                @if (bendingResults != null)
                {
                    <div class="resultaten-box">
                        <h5>Buigweerstand</h5>
                        <div class="resultaat-rij">
                            <span class="label"></span>
                            <span class="waarde">BOVEN</span>
                            <span class="waarde">ONDER</span>
                        </div>
                        <div class="resultaat-rij">
                            <span class="label">M<sub>y,Rd</sub>:</span>
                            <span class="waarde">@($"{bendingResults.MRd:F2}") kNm</span>
                            <span class="waarde">@($"{-bendingResultsOnder?.MRd:F2}") kNm</span>
                        </div>
                        <div class="resultaat-rij">
                            <span class="label">x<sub>u</sub>:</span>
                            <span class="waarde">@($"{bendingResults.Xu:F1}") mm</span>
                            <span class="waarde">@($"{bendingResultsOnder?.Xu:F1}") mm</span>
                        </div>
                        <div class="resultaat-rij">
                            <span class="label">z:</span>
                            <span class="waarde">@($"{bendingResults.Z:F1}") mm</span>
                            <span class="waarde">@($"{bendingResultsOnder?.Z:F1}") mm</span>
                        </div>
                        <div class="resultaat-rij">
                            <span class="label">d:</span>
                            <span class="waarde">@($"{bendingResults.D:F1}")</span>
                            <span class="waarde">@($"{bendingResultsOnder?.D:F1}") mm</span>
                        </div>
                        <div class="resultaat-rij">
                            <span class="label">A<sub>s,prov</sub>:</span>
                            <span class="waarde">@($"{bendingResults.AsApplied:F1}")</span>
                            <span class="waarde">@($"{bendingResultsOnder?.AsApplied:F1}") mm�</span>
                        </div>
                        <div class="detail-buttons">
                            <button class="btn btn-secondary" @onclick="ShowBendingDetailsTop">Details boven</button>
                            <button class="btn btn-secondary" @onclick="ShowBendingDetailsBottom">Details onder</button>
                        </div>
                    </div>
                }
            </div>

            <div class="control-section">
                <button class="btn btn-accent" @onclick="BerekenDwarskrachtweerstand">
                    Bereken V<sub>Rd</sub>
                </button>
                @if (shearResult != null)
                {
                    <div class="resultaten-box">
                        <h5>Dwarskrachtweerstand</h5>
                        <div class="resultaat-rij">
                            <span class="label">V<sub>Rd,c</sub>:</span>
                            <span class="waarde">@($"{shearResult.DwarskrachtWeerstandBeton:F2}") kN</span>
                        </div>
                        <div class="resultaat-rij">
                            <span class="label">V<sub>Rd,s</sub>:</span>
                            <span class="waarde">@($"{shearResult.DwarskrachtWeerstandStaal:F2}") kN</span>
                        </div>
                        <div class="resultaat-rij">
                            <span class="label">V<sub>Rd,max</sub>:</span>
                            <span class="waarde">@($"{shearResult.DwarskrachtWeerstandMax:F2}") kN</span>
                        </div>
                        <div class="detail-buttons">
                            <button class="btn btn-secondary" @onclick="ShowShearDetails">Alle details</button>
                        </div>
                    </div>
                }
            </div>
            }
            else
            {
            <div class="control-section">
                <div class="ec-placeholder">
                    <span class="ec-badge">@EcLabel</span>
                    <p>@EcLabel berekeningen zijn nog niet ge�mplementeerd.</p>
                </div>
            </div>
            }
            }

            <div class="control-section">
