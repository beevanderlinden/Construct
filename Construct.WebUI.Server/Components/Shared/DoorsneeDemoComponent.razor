    // ?? Gedeelde interne krachten ???????????????????????????????????????

    // SVG helpers: viewBox + maatlijnen voor I/H staalprofiel
    private static string GetIHProfielViewBox(ProfielIH p)
    {
        const double m = 70;
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        return string.Format(ci, "{0:F1} {1:F1} {2:F1} {3:F1}",
            -p.B / 2.0 - m, -p.H / 2.0 - m, p.B + 2 * m, p.H + 2 * m);
    }

    private static string GetIHDimensieSvg(ProfielIH p)
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        string F(double v) => v.ToString("F3", ci);
        double h2  = p.H / 2.0;
        double b2  = p.B / 2.0;
        double fs  = Math.Max(8.0, Math.Min(p.H, p.B) / 12.0);
        double sw  = Math.Max(0.6, p.H / 220.0);
        double off = 22.0;
        double ts  = sw * 4;
        const string col  = "#444";
        const string font = "font-family='sans-serif'";
        double by = h2 + off;
        double rx = b2 + off;
        double tx = rx + fs * 1.6;
        string rotateAttr = "transform='rotate(-90," + F(tx) + ",0)'";
        var sb = new System.Text.StringBuilder();
        sb.Append("<line x1='" + F(-b2) + "' y1='" + F(by) + "' x2='" + F(b2) + "' y2='" + F(by) + "' stroke='" + col + "' stroke-width='" + F(sw) + "'/>");
        sb.Append("<line x1='" + F(-b2) + "' y1='" + F(by-ts) + "' x2='" + F(-b2) + "' y2='" + F(by+ts) + "' stroke='" + col + "' stroke-width='" + F(sw) + "'/>");
        sb.Append("<line x1='" + F(b2)  + "' y1='" + F(by-ts) + "' x2='" + F(b2)  + "' y2='" + F(by+ts) + "' stroke='" + col + "' stroke-width='" + F(sw) + "'/>");
        sb.Append("<text x='0' y='" + F(by + fs * 1.5) + "' font-size='" + F(fs) + "' text-anchor='middle' fill='" + col + "' " + font + ">b = " + p.B + " mm</text>");
        sb.Append("<line x1='" + F(rx) + "' y1='" + F(-h2) + "' x2='" + F(rx) + "' y2='" + F(h2) + "' stroke='" + col + "' stroke-width='" + F(sw) + "'/>");
        sb.Append("<line x1='" + F(rx-ts) + "' y1='" + F(-h2) + "' x2='" + F(rx+ts) + "' y2='" + F(-h2) + "' stroke='" + col + "' stroke-width='" + F(sw) + "'/>");
        sb.Append("<line x1='" + F(rx-ts) + "' y1='" + F(h2)  + "' x2='" + F(rx+ts) + "' y2='" + F(h2)  + "' stroke='" + col + "' stroke-width='" + F(sw) + "'/>");
        sb.Append("<text " + rotateAttr + " x='" + F(tx) + "' y='0' font-size='" + F(fs) + "' text-anchor='middle' fill='" + col + "' " + font + ">h = " + p.H + " mm</text>");
        return sb.ToString();
    }

    private sealed class KrachtEntry
    {
        public string Naam { get; set; }
        public double My   { get; set; }
        public double Vz   { get; set; }

        public KrachtEntry(string naam, double my = 0, double vz = 0)
        {
            Naam = naam; My = my; Vz = vz;
        }

        public InternalForces ToInternalForces() =>
            new(N: 0, My: My, Mz: 0, Vy: 0, Vz: Vz, T: 0);
    }

    private List<KrachtEntry> krachtenLijst = new()
    {
        new("Steunpunt",  my:  30, vz: 100),
        new("Veldmoment", my: -50, vz:   0),
    };

    private void VoegKrachtToe() =>
        krachtenLijst.Add(new("Nieuw"));

    // ?? Staal / Hout materiaalklasse ????????????????????????????????????
    private string staalKlasse = "S275";
    private string houtKlasse  = "C24";

    // ?? Beton: materiaal ????????????????????????????????????????????????
    private BetonContext betonContext = new() { Betonsterkteklasse = BetonsterkteklasseEnum.C30_37 };

    // ?? Beton: wapening (null voor niet-beton) ??????????????????????????
    private BeugelWapeningContext? beugelWapening;
    private WapeningContext?       wapeningBoven;
    private WapeningContext?       wapeningOnder;
    private WapeningContext?       wapeningZijLinks;
    private WapeningContext?       wapeningZijRechts;

    private double beugelDekking     = 30;
    private bool   toonZijwapening   = true;
    private int    aantalZijwapening = 1;
    private double diameterZijwapening = 8;
    private bool   autoUpdateDekking = true;

    private int    aantalBovenStaven    = 3;
    private double diameterBovenStaven  = 10;
    private int    aantalOnderStaven    = 3;
    private double diameterOnderStaven  = 12;

    // ?? Beton: berekeningsresultaten ????????????????????????????????????
    private BendingResults?         bendingResults      = null;
    private BendingResults?         bendingResultsOnder = null;
    private DwarskrachtWapContext?  shearResult         = null;

    // ?? Beton: detail-popup state ???????????????????????????????????????
    private bool           showBendingDetails = false;
    private bool           showShearDetails   = false;
    private BendingResults? selectedBendingResult = null;
    private string         bendingDetailsTitle = "";

    // ?? Lifecycle ???????????????????????????????????????????????????????
    protected override void OnInitialized()
    {
        switch (MateriaalType)
        {
            case DoorsneeDemoMateriaalType.Beton:
                breedte = 300; hoogte = 400;
                InitBetonWapening();
                break;
            case DoorsneeDemoMateriaalType.Staal:
                staalProfielNaam = "IPE200";
                UpdateAfmetingenFromProfiel(); // IPE200 ? 200�100
                break;
            case DoorsneeDemoMateriaalType.Hout:
                breedte = 75; hoogte = 225;
                break;
        }
    }

    private void InitBetonWapening()
    {
        beugelWapening = new()
        {
            AantalSneden = 2, Diameter = 8,
            DekkingLinks = 30, DekkingRechts = 30, DekkingBoven = 30, DekkingOnder = 30,
            Buigstraal = 20, Linksom = true, HaakHoek = 135, HaakLengte = 40, Hoh = 100
        };
        beugelDekking = 30;

        wapeningBoven = new() { Tekst = "3r10", ReferentieLengte = breedte, DekkingToegepast = 38 };
        wapeningOnder = new() { Tekst = "3r12", ReferentieLengte = breedte, DekkingToegepast = 38 };

        toonZijwapening = true;
        aantalZijwapening = 1;
        diameterZijwapening = 8;
        UpdateZijwapening();
    }

    // ?? Beton: beugel helpers ???????????????????????????????????????????
    private void UpdateBeugelDekking()
    {
        if (beugelWapening == null) return;
        beugelWapening.DekkingLinks = beugelDekking;
        beugelWapening.DekkingRechts = beugelDekking;
        beugelWapening.DekkingBoven = beugelDekking;
        beugelWapening.DekkingOnder = beugelDekking;
        if (autoUpdateDekking) WijzigDekkingAutomatisch();
    }

    private void UpdateBuigstraal()
    {
        if (beugelWapening == null) return;
        beugelWapening.Buigstraal = beugelWapening.Diameter * 2.5;
        if (autoUpdateDekking) WijzigDekkingAutomatisch();
    }

    private void WijzigDekkingAutomatisch()
    {
        if (beugelWapening == null) return;
        if (wapeningBoven  != null) wapeningBoven.DekkingToegepast  = beugelWapening.DekkingBoven  + beugelWapening.Diameter;
        if (wapeningOnder  != null) wapeningOnder.DekkingToegepast  = beugelWapening.DekkingOnder  + beugelWapening.Diameter;
        if (wapeningZijLinks  != null) wapeningZijLinks.DekkingToegepast  = beugelWapening.DekkingLinks + beugelWapening.Diameter;
        if (wapeningZijRechts != null) wapeningZijRechts.DekkingToegepast = beugelWapening.DekkingRechts + beugelWapening.Diameter;
        StateHasChanged();
    }

    // ?? Beton: langswapening helpers ????????????????????????????????????
    private void UpdateBovenWapening()
    {
        if (wapeningBoven != null)
            wapeningBoven.Tekst = $"{aantalBovenStaven}r{diameterBovenStaven}";
        StateHasChanged();
    }

    private void UpdateOnderWapening()
    {
        if (wapeningOnder != null)
            wapeningOnder.Tekst = $"{aantalOnderStaven}r{diameterOnderStaven}";
        StateHasChanged();
    }

    private void UpdateZijwapening()
    {
        if (toonZijwapening && aantalZijwapening > 0)
        {
            double dekZij = (beugelWapening?.DekkingLinks ?? 30) + (beugelWapening?.Diameter ?? 8);
            wapeningZijLinks ??= new();
            wapeningZijLinks.Tekst = $"{aantalZijwapening}r{diameterZijwapening}";
            wapeningZijLinks.ReferentieLengte = hoogte;
            wapeningZijLinks.DekkingToegepast = dekZij;

            wapeningZijRechts ??= new();
            wapeningZijRechts.Tekst = $"{aantalZijwapening}r{diameterZijwapening}";
            wapeningZijRechts.ReferentieLengte = hoogte;
            wapeningZijRechts.DekkingToegepast = dekZij;
        }
        else
        {
            wapeningZijLinks  = null;
            wapeningZijRechts = null;
        }
    }

    // ?? Beton: berekeningen ?????????????????????????????????????????????
    private void BerekenBuigweerstand()
    {
        if (MateriaalType != DoorsneeDemoMateriaalType.Beton) return;
        try
        {
            bendingResults = new() { Beton = betonContext, Wapening = wapeningBoven,
                Profiel = new Profielen.Beton.BetonProfiel { Breedte = breedte, Hoogte = hoogte } };
            bendingResultsOnder = new() { Beton = betonContext, Wapening = wapeningOnder,
                Profiel = new Profielen.Beton.BetonProfiel(breedte, hoogte) };
            StateHasChanged();
        }
        catch (Exception ex) { Console.WriteLine($"Fout bij berekening: {ex.Message}"); bendingResults = null; }
    }

    private void BerekenDwarskrachtweerstand()
    {
        if (MateriaalType != DoorsneeDemoMateriaalType.Beton || wapeningBoven == null) return;
        try
        {
            shearResult = new()
            {
                Beton = betonContext,
                Profiel = new Profielen.Beton.BetonProfiel(breedte, hoogte),
                AsLangs = (wapeningBoven?.As ?? 0) + (wapeningOnder?.As ?? 0),
                NutHoogte = hoogte - (wapeningBoven?.ZRef ?? 38),
                AswToegepast = beugelWapening?.Asw ?? 0
            };
            StateHasChanged();
        }
        catch (Exception ex) { Console.WriteLine($"Fout bij dwarskracht berekening: {ex.Message}"); shearResult = null; }
    }

    // ?? Toetsen ?????????????????????????????????????????????????????????
    private void ToetsM(InternalForces krachten, string positie)
    {
        if (MateriaalType != DoorsneeDemoMateriaalType.Beton) return; // EC3/EC5: TODO

        bendingResults = new() { PosLabel = positie, Beton = betonContext, Wapening = wapeningBoven,
            Profiel = new Profielen.Beton.BetonProfiel { Breedte = breedte, Hoogte = hoogte },
            Snedekrachten = new SectionForces { My = krachten.My } };
        bendingResults.BerekenEnValideer();

        bendingResultsOnder = new() { PosLabel = positie, Beton = betonContext, Wapening = wapeningOnder,
            Profiel = new Profielen.Beton.BetonProfiel(breedte, hoogte),
            Snedekrachten = new SectionForces { My = krachten.My } };
        bendingResultsOnder.BerekenEnValideer();

        selectedBendingResult = krachten.My > 0 ? bendingResults : bendingResultsOnder;
        bendingDetailsTitle   = $"Momentweerstand - {positie}";
        showBendingDetails    = true;
    }

    private void ToetsV(InternalForces krachten, string positie)
    {
        if (MateriaalType != DoorsneeDemoMateriaalType.Beton) return; // EC3/EC5: TODO

        shearResult = new()
        {
            Beton = betonContext,
            Profiel = new Profielen.Beton.BetonProfiel(breedte, hoogte),
            AsLangs = (wapeningBoven?.As ?? 0) + (wapeningOnder?.As ?? 0),
            NutHoogte = hoogte - (wapeningBoven?.ZRef ?? 38),
            AswToegepast = beugelWapening?.Asw ?? 0,
            Snedekrachten = new SectionForces { Vz = Math.Abs(krachten.Vz) }
        };
        shearResult.BerekenEnValideer();

        bendingDetailsTitle = $"Dwarskrachtweerstand - {positie}";
        showShearDetails    = true;
    }

    // ?? Detail popup helpers ????????????????????????????????????????????
    private void ShowBendingDetailsTop()    { selectedBendingResult = bendingResults;      bendingDetailsTitle = "Buigweerstand Details - Bovenwapening"; showBendingDetails = true; }
    private void ShowBendingDetailsBottom() { selectedBendingResult = bendingResultsOnder; bendingDetailsTitle = "Buigweerstand Details - Onderwapening";  showBendingDetails = true; }
    private void ShowShearDetails()         { showShearDetails = true; }

    // ?? Reset ???????????????????????????????????????????????????????????
    private void ResetToDefault()
    {
        betonContext = new() { Betonsterkteklasse = BetonsterkteklasseEnum.C30_37 };
        staalKlasse = "S275";
        houtKlasse  = "C24";
        toonZijwapening   = true;
        autoUpdateDekking = true;
        toonMaatvoering   = true;
        toonLegenda       = true;
        krachtenLijst = new()
        {
            new("Steunpunt",  my:  30, vz: 100),
            new("Veldmoment", my: -50, vz:   0),
        };
        bendingResults      = null;
        bendingResultsOnder = null;
        shearResult         = null;

        switch (MateriaalType)
        {
            case DoorsneeDemoMateriaalType.Beton:
                breedte = 300; hoogte = 400;
                InitBetonWapening();
                break;
            case DoorsneeDemoMateriaalType.Staal:
                staalProfielType = "IPE";
                staalProfielNaam = "IPE200";
                UpdateAfmetingenFromProfiel();
                break;
            case DoorsneeDemoMateriaalType.Hout:
                breedte = 75; hoogte = 225;
                break;
        }
    }
}

