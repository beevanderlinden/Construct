@using System.Globalization
@inject IProjectStateService ProjectState


@if (Plaat != null)
{
    <KitInputNumberWithUnit Label="lengte <i>L</i>"
                            T="double" Min="500" Max="20000" Step="100"
                            @bind-Value="Plaat.Lengte"
                            Units="UnitSets.LengteMM" OnValueChanged="OnModelChanged" />

    <KitInputNumberWithUnit Label="breedte <i>B</i>"
                            T="double" Min="200" Max="10000" Step="100"
                            @bind-Value="Plaat.Breedte"
                            Units="UnitSets.LengteMM" OnValueChanged="OnModelChanged" />

    @if (Plaat.MainSlab != null)
    {
        <KitInputNumberWithUnit Label="dikte <i>h</i>"
                                T="double" Min="60" Max="600" Step="10"
                                @bind-Value="Plaat.MainSlab.Dikte"
                                Units="UnitSets.LengteMM" OnValueChanged="OnModelChanged" />

        if(Plaat is GalerijplaatEntity gp)
        {
            <KitInputNumberWithUnit Label="dikte <i>h2</i>"
                                    T="double" Min="60" Max="600" Step="10"
                                    @bind-Value="gp.Hoogte2"
                                    Units="UnitSets.LengteMM" OnValueChanged="OnModelChanged" />
        }

    }

    <br />

    <TreeViewSection Title="Opleggingen" 
                     Badge="@(Plaat.Opleggingen.Count > 0 ? Plaat.Opleggingen.Count.ToString() : null)"
                     @bind-IsExpanded="_opleggingenExpanded">
        <PlaatOpleggingenDetails Opleggingen="Plaat.Opleggingen"
                                 Preset="_preset"
                                 OnModelChanged="OnModelChanged"
                                 OnPresetChanged="OnPresetChanged"
                                 OnAddRandOplegging="AddRandOplegging"
                                 OnAddPuntOplegging="AddPuntOplegging"
                                 OnRemoveOplegging="RemoveOplegging" />
    </TreeViewSection>

    <TreeViewSection Title="Lijnlasten" 
                     Badge="@(Plaat.Lijnlasten.Count > 0 ? Plaat.Lijnlasten.Count.ToString() : null)"
                     @bind-IsExpanded="_lijnlastenExpanded">
        <PlaatLijnlastenDetails Lijnlasten="Plaat.Lijnlasten"
                                PlaatLengte="Plaat.Lengte"
                                PlaatBreedte="Plaat.Breedte"
                                BelastingGevallen="Plaat.Belastingen.BelastingGevallen"
                                OnModelChanged="OnModelChanged"
                                OnAddLijnlast="AddLijnlast"
                                OnRemoveLijnlast="RemoveLijnlast" />
    </TreeViewSection>

    <TreeViewSection Title="Puntlasten" 
                     Badge="@(Plaat.Puntlasten.Count > 0 ? Plaat.Puntlasten.Count.ToString() : null)"
                     @bind-IsExpanded="_puntlastenExpanded">
        <PlaatPuntlastenDetails Puntlasten="Plaat.Puntlasten"
                                PlaatLengte="Plaat.Lengte"
                                PlaatBreedte="Plaat.Breedte"
                                BelastingGevallen="Plaat.Belastingen.BelastingGevallen"
                                OnModelChanged="OnModelChanged"
                                OnAddPuntlast="AddPuntlast"
                                OnRemovePuntlast="RemovePuntlast" />
    </TreeViewSection>

}


@code {
    [Parameter] public PlaatEntity? Plaat { get; set; }
    [Parameter] public EventCallback<PlaatEntity> PlaatChanged { get; set; }
    [CascadingParameter] public Action? RequestParentRefresh { get; set; }

    private PlaatOpleggingPreset? _preset;
    private bool _opleggingenExpanded = true;
    private bool _lijnlastenExpanded = true;
    private bool _puntlastenExpanded = true;

    void OnModelChanged() => RequestParentRefresh?.Invoke();

    private void OnPresetChanged(PlaatOpleggingPreset? preset)
    {
        if (Plaat == null || !preset.HasValue) return;
        _preset = preset;
        Plaat.PasOpleggingPresetToe(preset.Value);
        OnModelChanged();
    }

    private void RemoveOplegging(int idx)
    {
        if (Plaat == null || idx < 0 || idx >= Plaat.Opleggingen.Count) return;
        Plaat.Opleggingen.RemoveAt(idx);
        OnModelChanged();
    }

    private void AddRandOplegging()
    {
        Plaat?.Opleggingen.Add(new PlaatRandOplegging());
        OnModelChanged();
    }

    private void AddPuntOplegging()
    {
        if (Plaat == null) return;
        Plaat.Opleggingen.Add(new PlaatPuntOplegging
        {
            PositieOpRand = Plaat.Breedte / 2,
            Breedte = 200,
        });
        OnModelChanged();
    }

    private void AddLijnlast()
    {
        if (Plaat == null) return;
        var bg1 = Plaat.Belastingen.BelastingGevallen.FirstOrDefault();
        var ll = new PlaatRandLijnlast
        {
            Rand             = PlaatRand.Boven,
            A                = 0,
            B                = 0,
            MagnitudeA       = -5.0,
            MagnitudeB       = -5.0,
            BelastingGevalNr = bg1?.Nr ?? 1,
            BelastingGeval   = bg1,
            Naam = $"q",
            Omschrijving = "gevel",

        };
        ll.BerekenPunten(Plaat.Lengte, Plaat.Breedte);
        Plaat.Lijnlasten.Add(ll);
        OnModelChanged();
    }

    private void RemoveLijnlast(int idx)
    {
        if (Plaat == null || idx < 0 || idx >= Plaat.Lijnlasten.Count) return;
        Plaat.Lijnlasten.RemoveAt(idx);
        OnModelChanged();
    }

    private void RemovePuntlast(int idx)
    {
        if (Plaat == null || idx < 0 || idx >= Plaat.Puntlasten.Count) return;
        Plaat.Puntlasten.RemoveAt(idx);
        OnModelChanged();
    }

    private void AddPuntlast()
    {
        if (Plaat == null) return;
        var bg = Plaat.Belastingen.BelastingGevallen.LastOrDefault();
        var pl = new PlaatPuntlast
        {
            PosX             = Plaat.Lengte / 2,
            PosY             = Plaat.Breedte / 2,
            Magnitude        = -20.0,
            BelastingGevalNr = bg?.Nr ?? 1,
            BelastingGeval   = bg,
            Naam             = "Pz",
            Omschrijving     = "hijslus",
        };
        Plaat.Puntlasten.Add(pl);
        OnModelChanged();
    }
}
