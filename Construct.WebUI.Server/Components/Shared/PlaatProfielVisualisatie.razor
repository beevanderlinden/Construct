@using Eurocode.BetonConstructies
@using Construct.Domain.Entities
@using System.Globalization


<div class="plaat-profiel-container" style="width: 100%; max-width: 1000px; margin: 20px auto;">
    @if (Wapening?.Boven != null || Wapening?.Onder != null)
    {
        <svg viewBox="@GetViewBox()" 
             preserveAspectRatio="xMidYMid meet" 
             class="plaat-profiel-svg"
             style="width: 100%; max-height: @(MaxDisplayHeight)px; height: auto; border: 1px solid var(--neutral-stroke-rest);">
            
            <defs>
                @* ✅ Unieke IDs per component instance *@
                <pattern id="concrete-@_instanceId" patternUnits="userSpaceOnUse" width="4" height="4">
                    <rect width="4" height="4" fill="#f5f5f5"/>
                </pattern>
                <pattern id="concrete-dark-@_instanceId" patternUnits="userSpaceOnUse" width="4" height="4">
                    <rect width="4" height="4" fill="#2a2a2a"/>
                </pattern>
                <marker id="arrowhead-@_instanceId" markerWidth="10" markerHeight="7" 
                        refX="9" refY="3.5" orient="auto-start-reverse">
                    <polygon points="0 0, 10 3.5, 0 7" fill="#666" />
                </marker>
                <marker id="dimension-@_instanceId" markerWidth="8" markerHeight="8" 
                        refX="4" refY="4" orient="auto">
                    <circle cx="4" cy="4" r="3" fill="none" stroke="#666" stroke-width="1"/>
                    <line x1="1" y1="4" x2="7" y2="4" stroke="#666" stroke-width="1"/>
                    <line x1="4" y1="1" x2="4" y2="7" stroke="#666" stroke-width="1"/>
                </marker>
            </defs>

            @foreach (var element in BuildSvgElements())
            {
                @((MarkupString)element.Render())
            }
        </svg>
    }
    else
    {
        <p class="text-muted">Geen wapening gedefinieerd</p>
    }
</div>

@code {
    [Parameter] public PlaatWapening? Wapening { get; set; }
    [Parameter] public double RibDiamBoven {get;set;} = 10;
    [Parameter] public double RibDiamOnder { get; set; } = 10;
    [Parameter] public int RibAantalOnder { get; set; } = 2;


    [Parameter] public double RibBreedte{ get; set; } = 60;
    [Parameter] public double RibHoogte { get; set; } = 300;
    [Parameter] public bool ToonRibben { get; set; } = !true;
    [Parameter] public double RibAfschuining { get; set; } = 10; // in graden
    [Parameter] public double Breedte { get; set; } = 1000;

    [Parameter] public double Hoogte { get; set; } = 200;
    [Parameter] public double Hoogte2 { get; set; } = 200;



    [Parameter] public double MaxDisplayHeight { get; set; } = 300;

    private int RibAantalBoven => 1;
    private double Marge => 80;
    private double Scale => 0.8;
    private double Pts => 12;

    // ✅ Unieke ID per component instance
    private string _instanceId = Guid.NewGuid().ToString("N").Substring(0, 8);

    private string GetViewBox()
    {
        var totalWidth  = Breedte + (Marge * 2) + 100;
        var totalHeight = (ToonRibben ? RibHoogte : Hoogte) + (Marge * 2) + 50;
        return $"0 0 {totalWidth.ToString("F0", CultureInfo.InvariantCulture)} {totalHeight.ToString("F0", CultureInfo.InvariantCulture)}";
    }

    private List<BaseSvg> BuildSvgElements()
    {
        var elements = new List<BaseSvg>();

        // Betonprofiel
        if (!ToonRibben)
        {
            if (Hoogte2 != Hoogte)
            {
                // Ribben niet tonen, maar Hoogte2 is anders → trapeziumvormige plaat tekenen
                double m = Marge;
                double b = Breedte;
                double h1 = Hoogte;
                double h2 = Hoogte2;
                string P(double x, double y) =>
                    $"{(m + x).ToString("F2", CultureInfo.InvariantCulture)},{(m + y).ToString("F2", CultureInfo.InvariantCulture)}";
                var points = string.Join(" ",
                    P(0, h1-h2),
                    P(0, h1),
                    P(b, h1),
                    P(b, 0)
                    );
                elements.Add(new SvgPolygon
                {
                    Points = points,
                    Fill = $"none",
                    Stroke = "#999",
                    StrokeWidth = 1
                });


                // hier een offset stippellijn tekenen met lijn 1,2,3 met een offset van dekking.Onder.BasisWapening.ReferentieDekking.
                // en lijn 4 met een offset van dekking.Boven.BasisWapening.ReferentieDekking.
                // ...na het tekenen van de trapeziumvorm...
                // if (Wapening?.Onder?.BasisWapening != null && Wapening?.Boven?.BasisWapening != null)
                // {
                //     double dekOnder = Wapening.Onder.VerdeelWapening.ReferentieDekking;
                //     double dekBoven = Wapening.Boven.VerdeelWapening.ReferentieDekking;

                //     var offsetPoints = string.Join(" ",
                //         P(0 + dekOnder, h1 - h2 + dekBoven),
                //         P(0 + dekOnder, h1 - dekOnder),
                //         P(b - dekOnder, h1 - dekOnder),
                //         P(b - dekBoven, 0 + dekBoven)
                //     );

                //     elements.Add(new SvgPolygon
                //     {
                //         Points = offsetPoints,
                //         Fill = "none",
                //         Stroke = "red",
                //         StrokeWidth = 0.1,
                //     });
                //}

            }
            else
            {
                elements.Add(new SvgRect
                {
                    X = Marge,
                    Y = Marge,
                    Width = Breedte,
                    Height = Hoogte,
                    Fill = $"none",
                    //Fill = $"url(#concrete-{_instanceId})",

                    Stroke = "#999",
                    StrokeWidth = 1
                });
            }
        }
        else
        {
            // Ribben polygon: 0,0 0,ribH b,ribH b,0 b-ribB,ribH-plaatH ribB,ribH-plaatH ribB,0
            double m     = Marge;
            double b     = Breedte;
            double ribH  = RibHoogte;
            double ribB  = RibBreedte;
            double plaatH = Hoogte;
            double deltaY = RibHoogte - Hoogte;
            double deltaX = Math.Sin(RibAfschuining * Math.PI / 180) * deltaY; // schuine zijde van 15 graden)

            string P(double x, double y) =>
                $"{(m + x).ToString("F2", CultureInfo.InvariantCulture)},{(m + y).ToString("F2", CultureInfo.InvariantCulture)}";

            var ribPoints = string.Join(" ",
                P(0,        0),
                P(0,        ribH),
                P(b,        ribH),
                P(b,        0),
                P(b - ribB, 0),
                P(b - ribB -deltaX, ribH - plaatH),
                P(ribB + deltaX,     ribH - plaatH),
                P(ribB,     0));

            elements.Add(new SvgPolygon
            {
                Points     = ribPoints,
                Fill       = $"url(#concrete-{_instanceId})",
                Stroke     = "#999",
                StrokeWidth = 1
            });

            // Wapeningsstaven in de ribben
            double ribDek = 20.0 + 6.0;
            double ribDekEind = 30.0;

            // RibDiamBoven: 1 staafdoorsnede per rib bovenin (drukzone)
            if (RibDiamBoven > 0)
            {
                double rB = RibDiamBoven / 2.0;
                elements.Add(new SvgCircle { Cx = m + ribDek + rB,     Cy = m + ribDekEind + rB, R = rB, Fill = "black", Stroke = "#555", StrokeWidth = 0.1, Opacity = 0.9 });
                elements.Add(new SvgCircle { Cx = m + b - ribDek - rB, Cy = m + ribDekEind + rB, R = rB, Fill = "black", Stroke = "#555", StrokeWidth = 0.1, Opacity = 0.9 });
            }

            // RibDiamOnder: RibAantalOnder staafdoorsneden per rib onderin (trekzone)
            if (RibDiamOnder > 0 && RibAantalOnder > 0 && deltaY > 0)
            {
                double rO   = RibDiamOnder / 2.0;
                double yBar = m + RibHoogte - ribDek - rO;

                // Linker rib-binnenrand op de y-hoogte van de staven (lineair geïnterpoleerd)
                double frac       = (deltaY - ribDek - rO) / deltaY;
                double innerLeft  = ribB + deltaX * frac;
                double xStart     = ribDek + rO;
                double xEnd       = innerLeft - ribDek - rO;

                if (xEnd > xStart)
                {
                    for (int i = 0; i < RibAantalOnder; i++)
                    {
                        double xRel = RibAantalOnder == 1
                            ? (xStart + xEnd) / 2.0
                            : xStart + i * (xEnd - xStart) / (RibAantalOnder - 1);
                        elements.Add(new SvgCircle { Cx = m + xRel,     Cy = yBar, R = rO, Fill = "black", Stroke = "#555", StrokeWidth = 0.1, Opacity = 0.9 });
                        elements.Add(new SvgCircle { Cx = m + b - xRel, Cy = yBar, R = rO, Fill = "black", Stroke = "#555", StrokeWidth = 0.1, Opacity = 0.9 });
                    }
                }
            }
        }


        double wapeningOffset = ToonRibben ? (RibHoogte - Hoogte) : 0;
        double alphaDeg = Math.Atan2(Hoogte - Hoogte2, Breedte) * 180.0 / Math.PI;

        // Bovenwapening (blauwige kleur)
        if (Wapening?.Boven?.BasisWapening != null)
        {
            var wap = Wapening.Boven.BasisWapening;
            var dekkingToe = Wapening.Boven.BasisWapening.ReferentieDekking;
            var dekkingLinks = dekkingToe;
            var dekkingRechts = dekkingToe;
            var dekkingBoven = dekkingToe;
            var dh = Hoogte - Hoogte2;

            var yPosHart = Marge + wapeningOffset + dh + dekkingBoven + (wap.GemiddeldeDiameter / 2.0);
            var yPos = yPosHart - (wap.GemiddeldeDiameter / 2.0);

            // Parse wapening tekst om hoh-maat te krijgen (bijv. "r8-150" → diameter=8, hoh=150)
            var parsed = ParseWapeningTekst(wap.Tekst);
            var diameter = parsed?.diameter ?? wap.GemiddeldeDiameter;
            var hoh = parsed?.hoh ?? 150; // fallback 150mm

            // Bereken aantal staven en posities
            var beschikbareBreedte = Breedte - dekkingLinks - dekkingRechts;
            var aantalStaven = (int)Math.Floor(beschikbareBreedte / hoh) + 1;
            var aantalAfstanden = aantalStaven - 1;
            var totaleAfstand = aantalAfstanden * hoh;
            var extraRuimte = beschikbareBreedte - totaleAfstand;
            var startX = Marge + dekkingLinks + extraRuimte / 2.0;

            // Teken individuele wapeningsstaven als cirkels
            for (int i = 0; i < aantalStaven; i++)
            {
                var xPos = startX + (i * hoh);

                // Stop als we buiten de plaat komen
                if (xPos > Marge + Breedte - dekkingRechts)
                    break;

                elements.Add(new SvgCircle
                {
                    Cx = xPos,
                    Cy = yPosHart,
                    R = diameter / 2.0,
                    Fill = "#4A90E2",
                    Stroke = "#2E5C8A",
                    StrokeWidth = 0.8,
                    Opacity = 0.9,
                    Transform = $"rotate({-alphaDeg}, {100.0},{0.0})" // kleine rotatie voor visuele duidelijkheid
                });
            }

            // Label bovenwapening (in het midden, over de wapening)
            var textBoven = new SvgText
            {
                X = Marge + Breedte / 2,
                Y = Marge - 20,
                Text = wap.ToString(),
                Anchor = "middle",
                DominantBaseLine = "middle",
                Pts = 20,
                Scale = Scale,
                Fill = "#2E5C8A",
            };
            textBoven.Content.Title = $"= {wap.As:F0} mm²";
            elements.Add(textBoven);

            // Verdeelwapening boven — rechte staaf (net als onder)
            if (Wapening.Boven.VerdeelWapening != null)
            {
                var verdeelWap = Wapening.Boven.VerdeelWapening;
                var verdeelParsed = ParseWapeningTekst(verdeelWap.Tekst);
                var verdeelDiameter = verdeelParsed?.diameter ?? verdeelWap.GemiddeldeDiameter;

                double d     = verdeelDiameter;
                var yTop     = Marge + wapeningOffset + verdeelWap.ReferentieDekking;
                var yTop2    = yTop + (Hoogte - Hoogte2);
                var xLinks   = Marge + dekkingLinks;
                var xRechts  = Marge + Breedte - dekkingRechts;
                var rotateDeg = 0.0; // geen rotatie, want we tekenen een horizontale staaf
                rotateDeg = -2.0; // kleine rotatie voor visuele duidelijkheid
                rotateDeg = -alphaDeg; // rotatie evenwijdig aan de schuine plaatkant

                elements.Add(new SvgRect
                {
                    X           = xLinks,
                    Y           = yTop2,
                    Width       = xRechts - xLinks,
                    Height      = d,
                    Fill        = "none",
                    Stroke      = "#2E5C8A",
                    StrokeWidth = 0.5,
                    Opacity     = 0.85,
                    Transform = $"rotate({rotateDeg}, {xLinks},{yTop2})" // verschuif omhoog naar de bovenkant van de plaat
                });

                // C-vormige haarspelden links (⊂) en rechts (⊃)
                // dekking rand + onder = dekking onderwapening; dekking boven = verdeelWap.ReferentieDekking
                var cDekkingRand  = Wapening.Onder?.BasisWapening?.ReferentieDekking ?? dekkingBoven;
                var cYTop         = yTop;
                var cYBottom      = Marge + Hoogte + wapeningOffset - cDekkingRand;
                double rIn        = d > 12 ? 2.5 * d : 2.0 * d;
                double rOut       = rIn + d;
                double armLen     = cDekkingRand; // arm-lengte voorbij de bocht
                const int carcN   = 8;

                string CPoints(List<(double x, double y)> p) =>
                    string.Join(" ", p.Select(q => $"{q.x.ToString("F1", CultureInfo.InvariantCulture)},{q.y.ToString("F1", CultureInfo.InvariantCulture)}"));

                // Linker C (⊂): buitenkant links op x = Marge + cDekkingRand, armen gaan naar rechts
                {
                    double xL   = Marge + cDekkingRand;
                    double xArm = xL + rOut + armLen;
                    double cxTL = xL + rOut; double cyTL = cYTop    + rOut;
                    double cxBL = xL + rOut; double cyBL = cYBottom - rOut;

                    var p = new List<(double x, double y)>();
                    // buitenrand: top arm → linkerbocht boven (270°→180°) → linkerkant → linkerbocht onder (180°→90°) → bottom arm
                    p.Add((xArm, cYTop));
                    for (int i = 0; i <= carcN; i++) { double a = (270.0 - 90.0 * i / carcN) * Math.PI / 180.0; p.Add((cxTL + rOut * Math.Cos(a), cyTL + rOut * Math.Sin(a))); }
                    for (int i = 0; i <= carcN; i++) { double a = (180.0 - 90.0 * i / carcN) * Math.PI / 180.0; p.Add((cxBL + rOut * Math.Cos(a), cyBL + rOut * Math.Sin(a))); }
                    p.Add((xArm, cYBottom));
                    // binnenrand: bottom arm → binnenbocht onder (90°→180°) → binnenkant → binnenbocht boven (180°→270°) → top arm
                    p.Add((xArm, cYBottom - d));
                    double cxBLi = xL + d + rIn; double cyBLi = cYBottom - d - rIn;
                    for (int i = 0; i <= carcN; i++) { double a = (90.0 + 90.0 * i / carcN) * Math.PI / 180.0; p.Add((cxBLi + rIn * Math.Cos(a), cyBLi + rIn * Math.Sin(a))); }
                    double cxTLi = xL + d + rIn; double cyTLi = cYTop + d + rIn;
                    for (int i = 0; i <= carcN; i++) { double a = (180.0 + 90.0 * i / carcN) * Math.PI / 180.0; p.Add((cxTLi + rIn * Math.Cos(a), cyTLi + rIn * Math.Sin(a))); }
                    p.Add((xArm, cYTop + d));

                    //elements.Add(new SvgPolygon { Points = CPoints(p), Fill = "#4A90E2", Stroke = "#1A3F6A", StrokeWidth = 0.8, Opacity = 0.6 });
                }

                // Rechter C (⊃): buitenkant rechts op x = Marge + Breedte - cDekkingRand, armen gaan naar links
                {
                    double xR   = Marge + Breedte - cDekkingRand;
                    double xArm = xR - rOut - armLen;
                    double cxTR = xR - rOut; double cyTR = cYTop    + rOut;
                    double cxBR = xR - rOut; double cyBR = cYBottom - rOut;

                    var p = new List<(double x, double y)>();
                    // buitenrand: top arm → rechterbocht boven (270°→360°) → rechterkant → rechterbocht onder (360°→450°) → bottom arm
                    p.Add((xArm, cYTop));
                    for (int i = 0; i <= carcN; i++) { double a = (270.0 + 90.0 * i / carcN) * Math.PI / 180.0; p.Add((cxTR + rOut * Math.Cos(a), cyTR + rOut * Math.Sin(a))); }
                    for (int i = 0; i <= carcN; i++) { double a = (360.0 + 90.0 * i / carcN) * Math.PI / 180.0; p.Add((cxBR + rOut * Math.Cos(a), cyBR + rOut * Math.Sin(a))); }
                    p.Add((xArm, cYBottom));
                    // binnenrand: bottom arm → binnenbocht onder (90°→0°) → binnenkant → binnenbocht boven (360°→270°) → top arm
                    p.Add((xArm, cYBottom - d));
                    double cxBRi = xR - d - rIn; double cyBRi = cYBottom - d - rIn;
                    for (int i = 0; i <= carcN; i++) { double a = (90.0 - 90.0 * i / carcN) * Math.PI / 180.0; p.Add((cxBRi + rIn * Math.Cos(a), cyBRi + rIn * Math.Sin(a))); }
                    double cxTRi = xR - d - rIn; double cyTRi = cYTop + d + rIn;
                    for (int i = 0; i <= carcN; i++) { double a = (360.0 - 90.0 * i / carcN) * Math.PI / 180.0; p.Add((cxTRi + rIn * Math.Cos(a), cyTRi + rIn * Math.Sin(a))); }
                    p.Add((xArm, cYTop + d));

                    //elements.Add(new SvgPolygon { Points = CPoints(p), Fill = "#4A90E2", Stroke = "#1A3F6A", StrokeWidth = 0.8, Opacity = 0.6 });
                }
            }

            // Maatlijn links: van onderkant profiel tot hart bovenwapening
            var dimLineLinksTotaal = new SvgDimLine
            {
                X1 = Marge,
                Y1 = Marge + Hoogte,
                X2 = Marge,
                Y2 = Marge + (Hoogte-Hoogte2),
                Offset = 40,
                Mode = DimLineMode.Vertical,
                ShowExtensionLines = true,
                StrokeWidth = 0.8,
                Scale = Scale,
                StringFormat = "0.#",
                MarkerStart = $"arrowhead-{_instanceId}",
                MarkerEnd = $"arrowhead-{_instanceId}"
            };
            elements.Add(dimLineLinksTotaal);

           

           
        }

        // Onderwapening (oranje kleur)
        if (Wapening?.Onder?.BasisWapening != null)
        {
            var wap = Wapening.Onder.BasisWapening;
            var dekkingToe = Wapening.Onder.BasisWapening.ReferentieDekking;
            var dekkingLinks = dekkingToe;
            var dekkingRechts = dekkingToe;
            var dekkingOnder = dekkingToe;
            
            var yPosHart = Marge + Hoogte + wapeningOffset - dekkingOnder - (wap.GemiddeldeDiameter / 2.0);
            var yPos = yPosHart - (wap.GemiddeldeDiameter / 2.0);
            
            // Parse wapening tekst om hoh-maat te krijgen
            var parsed = ParseWapeningTekst(wap.Tekst);
            var diameter = parsed?.diameter ?? wap.GemiddeldeDiameter;
            var hoh = parsed?.hoh ?? 150; // fallback 150mm
            
            // Bereken aantal staven en posities
            var beschikbareBreedte = Breedte - dekkingLinks - dekkingRechts;
            var aantalStaven = (int)Math.Floor(beschikbareBreedte / hoh) + 1;
            var aantalAfstanden = aantalStaven - 1;
            var totaleAfstand = aantalAfstanden * hoh;
            var extraRuimte = beschikbareBreedte - totaleAfstand;
            var startX = Marge + dekkingLinks + extraRuimte / 2.0;
            
            // Teken individuele wapeningsstaven als cirkels
            for (int i = 0; i < aantalStaven; i++)
            {
                var xPos = startX + (i * hoh);
                
                // Stop als we buiten de plaat komen
                if (xPos > Marge + Breedte)
                    break;
                
                elements.Add(new SvgCircle
                {
                    Cx = xPos,
                    Cy = yPosHart,
                    R = diameter / 2.0,
                    Fill = "#FF8C42",
                    Stroke = "#D4621F",
                    StrokeWidth = 0.8,
                    Opacity = 0.9
                });
            }
            
            // Label onderwapening (in het midden, over de wapening)
            var textOnder = new SvgText
            {
                X = Marge + Breedte / 2,
                Y = Marge + Hoogte + wapeningOffset + 20,
                Text = wap.ToString(),
                
                Anchor = "middle",
                DominantBaseLine = "hanging",
                Pts = 20,
                Scale = Scale,
                Fill = "#D4621F"
            };
            textOnder.Content.Title = $"= {wap.As:F0} mm²";
            elements.Add(textOnder);

            // Verdeelwapening onder
            if (Wapening.Onder.VerdeelWapening != null)
            {
                var verdeelWap = Wapening.Onder.VerdeelWapening;
                var verdeelParsed = ParseWapeningTekst(verdeelWap.Tekst);
                var verdeelDiameter = verdeelParsed?.diameter ?? verdeelWap.GemiddeldeDiameter;

                if (ToonRibben)
                {
                    // Bij ribben: U-beugel polygon met afgeronde bochten
                    var yLijn1  = Marge + Hoogte + wapeningOffset - verdeelWap.ReferentieDekking;
                    var yLijn2  = yLijn1 - verdeelDiameter;
                    var xLinks  = Marge + verdeelWap.ReferentieDekking;
                    var xRechts = Marge + Breedte - verdeelWap.ReferentieDekking;

                    var yTop = Marge + dekkingOnder;
                    double d    = verdeelDiameter;
                    double rIn  = d > 12 ? 2.5 * d : 2.0 * d;
                    double rOut = rIn + d;

                    double cxL = xLinks  + rOut, cyB = yLijn1 - rOut;
                    double cxR = xRechts - rOut;
                    const int arcN = 8;

                    var pts = new List<(double x, double y)>();
                    pts.Add((xLinks, yTop));
                    pts.Add((xLinks, cyB));
                    for (int i = 0; i <= arcN; i++) { double a = (180.0 - 90.0 * i / arcN) * Math.PI / 180.0; pts.Add((cxL + rOut * Math.Cos(a), cyB + rOut * Math.Sin(a))); }
                    pts.Add((cxR, yLijn1));
                    for (int i = 0; i <= arcN; i++) { double a = (90.0  - 90.0 * i / arcN) * Math.PI / 180.0; pts.Add((cxR + rOut * Math.Cos(a), cyB + rOut * Math.Sin(a))); }
                    pts.Add((xRechts, yTop));
                    pts.Add((xRechts - d, yTop));
                    pts.Add((xRechts - d, cyB));
                    for (int i = 0; i <= arcN; i++) { double a = (0.0   + 90.0 * i / arcN) * Math.PI / 180.0; pts.Add((cxR + rIn  * Math.Cos(a), cyB + rIn  * Math.Sin(a))); }
                    pts.Add((cxL, yLijn2));
                    for (int i = 0; i <= arcN; i++) { double a = (90.0  + 90.0 * i / arcN) * Math.PI / 180.0; pts.Add((cxL + rIn  * Math.Cos(a), cyB + rIn  * Math.Sin(a))); }
                    pts.Add((xLinks + d, yTop));

                    elements.Add(new SvgPolygon
                    {
                        Points      = string.Join(" ", pts.Select(p => $"{p.x.ToString("F1", CultureInfo.InvariantCulture)},{p.y.ToString("F1", CultureInfo.InvariantCulture)}")),
                        Fill        = "#FF8C42",
                        Stroke      = "#D4621F",
                        StrokeWidth = 0.5,
                        Opacity     = 0.85
                    });
                }
                else
                {
                    // Bij platte plaat: verdeelwapening loopt als rechte staaf over de breedte
                    var r            = verdeelDiameter / 2.0;
                    var yVerdeelHart = Marge + Hoogte + wapeningOffset - verdeelWap.ReferentieDekking - r;
                    var xLinks       = Marge + verdeelWap.ReferentieDekking;
                    var staafBreedte = Breedte - 2 * verdeelWap.ReferentieDekking;

                    elements.Add(new SvgRect
                    {
                        X           = xLinks,
                        Y           = yVerdeelHart - r,
                        Width       = staafBreedte,
                        Height      = verdeelDiameter,
                        Fill        = "none",
                        Stroke      = "#D4621F",
                        StrokeWidth = 0.5,
                        Opacity     = 0.75
                    });
                }
            }

            // Maatlijn rechts: van bovenkant profiel tot hart onderwapening
            var dimLineRechtsTotaal = new SvgDimLine
            {
                X1 = Marge + Breedte,
                Y1 = Marge,
                X2 = Marge + Breedte,
                Y2 = yPosHart,
                Offset = -40,
                Mode = DimLineMode.Vertical,
                ShowExtensionLines = true,
                StrokeWidth = 0.8,
                Scale = Scale,
                StringFormat = "0.#",
                MarkerStart = $"arrowhead-{_instanceId}",
                MarkerEnd = $"arrowhead-{_instanceId}"
            };
            //elements.Add(dimLineRechtsTotaal);

            // Maatlijn rechts: van hart onderwapening tot onderkant profiel
            var dimRechtsDeelOnder = new SvgDimLine
            {
                X1 = Marge + Breedte,
                Y1 = yPosHart,
                X2 = Marge + Breedte,
                Y2 = Marge + Hoogte,
                Offset = -40,
                Mode = DimLineMode.Vertical,
                ShowExtensionLines = true,
                StrokeColor = "#D4621F",
                StrokeWidth = 0.8,
                Scale = Scale,
                StringFormat = "0.#",
                MarkerStart = $"arrowhead-{_instanceId}",
                MarkerEnd = $"arrowhead-{_instanceId}"
            };
            //elements.Add(dimRechtsDeelOnder);

    
        }

        // Hoogte rechts (algemene maatvoering met SvgDimLine)
        var dimHoogte = new SvgDimLine
        {
            X1 = Marge + Breedte,
            Y1 = Marge + Hoogte + wapeningOffset,
            X2 = Marge + Breedte,
            Y2 = Marge + wapeningOffset,
            Offset = -40,
            Mode = DimLineMode.Vertical,
            ShowExtensionLines = true,
            StrokeColor = "#333",
            StrokeWidth = 1,
            Scale = Scale,
            Text = $"{Hoogte:F0}",
            MarkerStart = $"arrowhead-{_instanceId}",
            MarkerEnd = $"arrowhead-{_instanceId}"
        };
        elements.Add(dimHoogte);

        // Breedte onder (met SvgDimLine)
        var dimBreedte = new SvgDimLine
        {
            X1 = Marge,
            Y1 = Marge + Hoogte,
            X2 = Marge + Breedte,
            Y2 = Marge + Hoogte,
            Offset = -Marge,
            Mode = DimLineMode.Horizontal,
            ShowExtensionLines = true,
            StrokeColor = "#333",
            StrokeWidth = 1,
            Scale = Scale,
            Text = $"{Breedte:F0}",
            MarkerStart = $"arrowhead-{_instanceId}",
            MarkerEnd = $"arrowhead-{_instanceId}"
        };
        //elements.Add(dimBreedte);

        return elements;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
    }

    /// <summary>
    /// Parseert wapening tekst zoals "r6-150" naar (diameter, hoh).
    /// Gedeelde logic met BordesEntity.ParseWapeningTekst.
    /// </summary>
    private static (double diameter, double hoh)? ParseWapeningTekst(string? tekst)
    {
        if (string.IsNullOrWhiteSpace(tekst))
            return null;

        // Format: "r6-150" of "Ø8-200"
        var match = System.Text.RegularExpressions.Regex.Match(
            tekst,
            @"[rØø](\d+(?:[.,]\d+)?)-(\d+(?:[.,]\d+)?)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        if (match.Success)
        {
            string diamStr = match.Groups[1].Value.Replace(',', '.');
            string hohStr = match.Groups[2].Value.Replace(',', '.');
            double diameter = double.Parse(diamStr, CultureInfo.InvariantCulture);
            double hoh = double.Parse(hohStr, CultureInfo.InvariantCulture);
            return (diameter, hoh);
        }

        return null;
    }
}