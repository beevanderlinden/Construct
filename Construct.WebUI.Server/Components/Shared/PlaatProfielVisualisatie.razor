@using Eurocode.BetonConstructies
@using Construct.Domain.Entities
@using System.Globalization

<div class="plaat-profiel-container" style="width: 100%; max-width: 1000px; margin: 20px auto;">
    @if (Wapening?.Boven != null || Wapening?.Onder != null)
    {
        <svg viewBox="@GetViewBox()" 
             preserveAspectRatio="xMidYMid meet" 
             style="width: 100%; max-height: @(MaxDisplayHeight)px; height: auto; border: 1px solid #ddd; background: white;">
            
            <defs>
                <pattern id="concrete" patternUnits="userSpaceOnUse" width="4" height="4">
                    <rect width="4" height="4" fill="#f5f5f5"/>
                </pattern>
                <marker id="arrowhead" markerWidth="10" markerHeight="7" 
                        refX="9" refY="3.5" orient="auto-start-reverse">
                    <polygon points="0 0, 10 3.5, 0 7" fill="#666" />
                </marker>
                <marker id="arrowhead" markerWidth="8" markerHeight="8" 
                        refX="4" refY="4" orient="auto">
                    <circle cx="4" cy="4" r="3" fill="none" stroke="#666" stroke-width="1"/>
                    <line x1="1" y1="4" x2="7" y2="4" stroke="#666" stroke-width="1"/>
                    <line x1="4" y1="1" x2="4" y2="7" stroke="#666" stroke-width="1"/>
                </marker>
            </defs>

            @foreach (var element in BuildSvgElements())
            {
                @((MarkupString)element.Render())
            }
        </svg>
    }
    else
    {
        <p class="text-muted">Geen wapening gedefinieerd</p>
    }
</div>

@code {
    [Parameter] public PlaatWapening? Wapening { get; set; }
    [Parameter] public double Breedte { get; set; } = 1000;
    [Parameter] public double Hoogte { get; set; } = 200;
    [Parameter] public double MaxDisplayHeight { get; set; } = 300;

    private double Marge => 80;
    private double Scale => 0.8;
    private double Pts => 12;

    private string GetViewBox()
    {
        var totalWidth = Breedte + (Marge * 2) + 100;
        var totalHeight = Hoogte + (Marge * 2) + 50;
        return $"0 0 {totalWidth.ToString("F0", CultureInfo.InvariantCulture)} {totalHeight.ToString("F0", CultureInfo.InvariantCulture)}";
    }

    private List<BaseSvg> BuildSvgElements()
    {
        var elements = new List<BaseSvg>();

        // Betonprofiel
        elements.Add(new SvgRect
        {
            X = Marge,
            Y = Marge,
            Width = Breedte,
            Height = Hoogte,
            Fill = "url(#concrete)",
            Stroke = "#999",
            StrokeWidth = 1
        });

        // Bovenwapening (blauwige kleur)
        if (Wapening?.Boven?.BasisWapening != null)
        {
            var wap = Wapening.Boven.BasisWapening;
            var dekkingToe = Wapening.Boven.BasisWapening.ReferentieDekking;
            var dekkingLinks = 0;
            var dekkingRechts = 0;
            var dekkingBoven = dekkingToe;
            
            var yPosHart = Marge + dekkingBoven + (wap.GemiddeldeDiameter / 2.0);
            var yPos = yPosHart - (wap.GemiddeldeDiameter / 2.0);
            
            // Wapeningslaag bovenzijde
            elements.Add(new SvgRect
            {
                X = Marge + dekkingLinks,
                Y = yPos,
                Width = Breedte - dekkingLinks - dekkingRechts,
                Height = wap.GemiddeldeDiameter > 0 ? wap.GemiddeldeDiameter : 8,
                Fill = "#4A90E2",
                Stroke = "#2E5C8A",
                StrokeWidth = 0.5,
                Opacity = 0.8
            });
            
            // Label bovenwapening (in het midden, over de wapening)
            var textBoven = new SvgText
            {
                X = Marge + Breedte / 2,
                Y = Marge - 20,
                Text = wap.ToString(),
                Anchor = "middle",
                DominantBaseLine = "middle",
                Pts = 20,
                Scale = Scale,
                Fill = "#2E5C8A"
            };
            textBoven.Content.Title = $"= {wap.As:F0} mm²";
            elements.Add(textBoven);

            // Maatlijn links: van onderkant profiel tot hart bovenwapening
            var dimLineLinksTotaal = new SvgDimLine
            {
                X1 = Marge,
                Y1 = Marge + Hoogte,
                X2 = Marge,
                Y2 = yPosHart,
                Offset = 40,
                Mode = DimLineMode.Vertical,
                ShowExtensionLines = true,
                StrokeWidth = 0.8,
                Scale = Scale,
                StringFormat = "0.#",
                MarkerStart = "arrowhead",
                MarkerEnd = "arrowhead"
            };
            elements.Add(dimLineLinksTotaal);

           

           
        }

        // Onderwapening (oranje kleur)
        if (Wapening?.Onder?.BasisWapening != null)
        {
            var wap = Wapening.Onder.BasisWapening;
            var dekkingToe = Wapening.Onder.BasisWapening.ReferentieDekking;
            var dekkingLinks = 0;
            var dekkingRechts = 0;
            var dekkingOnder = dekkingToe;
            
            var yPosHart = Marge + Hoogte - dekkingOnder - (wap.GemiddeldeDiameter / 2.0);
            var yPos = yPosHart - (wap.GemiddeldeDiameter / 2.0);
            
            // Wapeningslaag onderzijde
            elements.Add(new SvgRect
            {
                X = Marge + dekkingLinks,
                Y = yPos,
                Width = Breedte - dekkingLinks - dekkingRechts,
                Height = wap.GemiddeldeDiameter > 0 ? wap.GemiddeldeDiameter : 8,
                Fill = "#FF8C42",
                Stroke = "#D4621F",
                StrokeWidth = 0.5,
                Opacity = 0.8
            });
            
            // Label onderwapening (in het midden, over de wapening)
            var textOnder = new SvgText
            {
                X = Marge + Breedte / 2,
                Y = Marge + Hoogte + 20,
                Text = wap.ToString(),
                
                Anchor = "middle",
                DominantBaseLine = "hanging",
                Pts = 20,
                Scale = Scale,
                Fill = "#D4621F"
            };
            textOnder.Content.Title = $"= {wap.As:F0} mm²";
            elements.Add(textOnder);

            // Maatlijn rechts: van bovenkant profiel tot hart onderwapening
            var dimLineRechtsTotaal = new SvgDimLine
            {
                X1 = Marge + Breedte,
                Y1 = Marge,
                X2 = Marge + Breedte,
                Y2 = yPosHart,
                Offset = -40,
                Mode = DimLineMode.Vertical,
                ShowExtensionLines = true,
                StrokeWidth = 0.8,
                Scale = Scale,
                StringFormat = "0.#",
                MarkerStart = "arrowhead",
                MarkerEnd = "arrowhead"
            };
            elements.Add(dimLineRechtsTotaal);

            // Maatlijn rechts: van hart onderwapening tot onderkant profiel
            var dimRechtsDeelOnder = new SvgDimLine
            {
                X1 = Marge + Breedte,
                Y1 = yPosHart,
                X2 = Marge + Breedte,
                Y2 = Marge + Hoogte,
                Offset = -40,
                Mode = DimLineMode.Vertical,
                ShowExtensionLines = true,
                StrokeColor = "#D4621F",
                StrokeWidth = 0.8,
                Scale = Scale,
                StringFormat = "0.#",
                MarkerStart = "arrowhead",
                MarkerEnd = "arrowhead"
            };
            //elements.Add(dimRechtsDeelOnder);

    
        }

        // Hoogte rechts (algemene maatvoering met SvgDimLine)
        var dimHoogte = new SvgDimLine
        {
            X1 = Marge + Breedte,
            Y1 = Marge + Hoogte,
            X2 = Marge + Breedte,
            Y2 = Marge,
            Offset = -Marge,
            Mode = DimLineMode.Vertical,
            ShowExtensionLines = true,
            StrokeColor = "#333",
            StrokeWidth = 1,
            Scale = Scale,
            Text = $"{Hoogte:F0}",
            MarkerStart = "arrowhead",
            MarkerEnd = "arrowhead"
        };
        elements.Add(dimHoogte);

        // Breedte onder (met SvgDimLine)
        var dimBreedte = new SvgDimLine
        {
            X1 = Marge,
            Y1 = Marge + Hoogte,
            X2 = Marge + Breedte,
            Y2 = Marge + Hoogte,
            Offset = -Marge,
            Mode = DimLineMode.Horizontal,
            ShowExtensionLines = true,
            StrokeColor = "#333",
            StrokeWidth = 1,
            Scale = Scale,
            Text = $"{Breedte:F0}",
            MarkerStart = "arrowhead",
            MarkerEnd = "arrowhead"
        };
        //elements.Add(dimBreedte);

        return elements;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
    }
}