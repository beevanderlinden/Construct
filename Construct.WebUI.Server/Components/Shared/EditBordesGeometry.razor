@using System.Globalization
@inject IProjectStateService ProjectState

@if (Model != null)
{
    <KaskonInputContainer Label="plaatdikte [mm]">
        <FluentNumberField TValue="double"
                           @bind-Value="Model.Dikte"
                           Step="10" Min="180" Max="400"></FluentNumberField>
    </KaskonInputContainer>


    <KaskonInputContainer Label="breedte [mm]">
        <FluentNumberField TValue="double" 
            @bind-Value="Model.Breedte" 
            @bind-Value:after="OnModelChanged"
            Step="100" Min="1000" Max="3000"></FluentNumberField>
    </KaskonInputContainer>

    <KaskonInputContainer Label="lengte [mm]">
        <FluentNumberField TValue="double" 
            @bind-Value="Model.Lengte" 
            @bind-Value:after="OnModelChanged"
            Step="100" Min="2000" Max="5000"></FluentNumberField>
    </KaskonInputContainer>

   

    <KaskonInputContainer Label="versterkte strookbreedte [mm]">
        <FluentNumberField TValue="double" 
                           @bind-Value="Model.BreedteVersterkteStrook"
                           @bind-Value:after="OnModelChanged"
                           Step="50" Min="200" Max="500"></FluentNumberField>
    </KaskonInputContainer>

    <KaskonInputContainer Label="afwerking [kN/m²]" >
        <FluentNumberField TValue="double"
                           @bind-Value="Model.AfwerkingVlaklast"
                           @bind-Value:after="OnModelChanged"
                           Step="0.1" Min="0" Max="5"></FluentNumberField>
    </KaskonInputContainer>


    <KaskonInputContainer Label="dekking c<sub>prov,boven</sub> [mm]">
        <FluentNumberField TValue="double"
                           @bind-Value="Model.PlaatDekking.Boven.DekkingToe"
                           @bind-Value:after="OnModelChanged"
                           Step="1" Min="15" Max="70"></FluentNumberField>
    </KaskonInputContainer>

    <KaskonInputContainer Label="dekking c<sub>prov,onder</sub> [mm]">
        <FluentNumberField TValue="double"
                           @bind-Value="Model.PlaatDekking.Onder.DekkingToe"
                           @bind-Value:after="OnModelChanged"
                           Step="1" Min="15" Max="70"></FluentNumberField>
    </KaskonInputContainer>





    <br/>
   
    <KaskonInputContainer Label="trap links">
        <select class="form-select" @onchange="@((ChangeEventArgs e) => OnKeuze1Changed(int.Parse(e.Value?.ToString() ?? "0")))">
            @for (int i = 0; i < _keuzes.Count; i++)
            {
                var keuze = _keuzes[i];
                <option value="@i" selected="@(SelectedKeuze1 == keuze)">
                    @keuze.Label
                </option>
            }
        </select>
    </KaskonInputContainer>


    if(Model.Trap1?.AansluitendElement != null)
    {
        <KaskonInputContainer Label="afstand links [mm]">
            <FluentNumberField TValue="double" 
                @bind-Value="Model.Trap1.Randafstand" 
                @bind-Value:after="OnModelChanged"
                Step="10" Min="0" Max="500"></FluentNumberField>
        </KaskonInputContainer>

        <KaskonInputContainer Label="trap.breedte">
            <FluentNumberField TValue="double" 
                @bind-Value="Model.Trap1.AansluitendElement.Breedte" 
                @bind-Value:after="OnModelChanged"
                Step="100" Min="800" Max="3000"></FluentNumberField>
        </KaskonInputContainer>

        <KaskonInputContainer Label="reactie">
            <FluentTextField Value="@_reactie1" Disabled="true">
            </FluentTextField>
        </KaskonInputContainer>
        <br />
    }

    <KaskonInputContainer Label="trap rechts">
        <select class="form-select" @onchange="@((ChangeEventArgs e) => OnKeuze2Changed(int.Parse(e.Value?.ToString() ?? "0")))">
            @for (int i = 0; i < _keuzes.Count; i++)
            {
                var keuze = _keuzes[i];
                <option value="@i" selected="@(SelectedKeuze2 == keuze)">
                    @keuze.Label
                </option>
            }
        </select>
    </KaskonInputContainer>
   
    if (Model.Trap2?.AansluitendElement != null)
    {
        <KaskonInputContainer Label="afstand rechts [mm]">
            <FluentNumberField TValue="double" 
                               @bind-Value="Model.Trap2.Randafstand"
                               @bind-Value:after="OnModelChanged"
                               Step="10" Min="0" Max="500"></FluentNumberField>
        </KaskonInputContainer>

        <KaskonInputContainer Label="trap.breedte">
            <FluentNumberField TValue="double"
                               @bind-Value="Model.Trap2.AansluitendElement.Breedte"
                               @bind-Value:after="OnModelChanged"
                               Step="100" Min="800" Max="3000"></FluentNumberField>
        </KaskonInputContainer>

        <KaskonInputContainer Label="reactie">
            <FluentTextField Value="@_reactie2" Disabled="true">
            </FluentTextField>
        </KaskonInputContainer>
        <br />
    }

