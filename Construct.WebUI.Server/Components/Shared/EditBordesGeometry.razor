@using System.Globalization
@inject IProjectStateService ProjectState

@if (Model != null)
{


    <KaskonInputContainer Label="plaatdikte">
        <KitInputNumber T="double"
                        @bind-Value="Model.Dikte"
                        Unit="mm" Step="10" Min="180" Max="400"
                        OnValueChanged="OnModelChanged" />
    </KaskonInputContainer>

    <KaskonInputContainer Label="breedte">
        <KitInputNumber T="double"
                        @bind-Value="Model.Breedte" 
                        Unit="mm" Step="100" Min="1000" Max="3000" 
                        OnValueChanged="OnModelChanged"/>
    </KaskonInputContainer>
    
    <KaskonInputContainer Label="lengte">
        <KitInputNumber T="double"
                        @bind-Value="Model.Lengte"
                        Unit="mm" Step="100" Min="2000" Max="7200"
                        OnValueChanged="OnModelChanged" />
    </KaskonInputContainer>
    

    <KaskonInputContainer Label="versterkte strookbreedte">
        <KitInputNumber T="double"
                        @bind-Value="Model.BreedteVersterkteStrook" 
                        Unit="mm" Step="50" Min="200" Max="500" 
                        OnValueChanged="OnModelChanged" />
    </KaskonInputContainer>

    <KaskonInputContainer Label="afwerking" >
        <KitInputNumber T="double"
                        @bind-Value="Model.AfwerkingVlaklast"
                        Unit="kN/m²" Step="0.1" Min="0" Max="5"
                        OnValueChanged="OnModelChanged" />
    </KaskonInputContainer>

    <KaskonMilieuklasseDekking 
        Boven="@Model.PlaatDekking.Boven" 
        Onder="@Model.PlaatDekking.Onder" 
        Merk="@Model.Merk"
        OnChanged="OnModelChanged" />

  


    <br/>
   
    <KaskonInputContainer Label="trap links">
        <select class="form-select" @onchange="@((ChangeEventArgs e) => OnKeuze1Changed(int.Parse(e.Value?.ToString() ?? "0")))">
            @for (int i = 0; i < _keuzes.Count; i++)
            {
                var keuze = _keuzes[i];
                <option value="@i" selected="@(SelectedKeuze1 == keuze)">
                    @keuze.Label
                </option>
            }
        </select>
    </KaskonInputContainer>


    <EditTrapOpleggingComponent TrapOplegging="@Model.Trap1"
                                MinimaleTandHoogte="@Model.MinimaleTandHoogte"
                                MaxRandafstand="@(Model.Lengte * 0.5)"
                                OnChanged="OnModelChanged" />



    <KaskonInputContainer Label="trap rechts">
        <select class="form-select" @onchange="@((ChangeEventArgs e) => OnKeuze2Changed(int.Parse(e.Value?.ToString() ?? "0")))">
            @for (int i = 0; i < _keuzes.Count; i++)
            {
                var keuze = _keuzes[i];
                <option value="@i" selected="@(SelectedKeuze2 == keuze)">
                    @keuze.Label
                </option>
            }
        </select>
    </KaskonInputContainer>
   
   
    <EditTrapOpleggingComponent TrapOplegging="@Model.Trap2"
                                MinimaleTandHoogte="@Model.MinimaleTandHoogte"
                                MaxRandafstand="@(Model.Lengte * 0.5)"
                                OnChanged="OnModelChanged" />






}



@code {
    [Parameter] public BordesEntity? Model{ get; set; }
    [Parameter] public EventCallback<BordesEntity> ModelChanged{ get; set; }
    [CascadingParameter] public Action? RequestParentRefresh { get; set; }

    // Dialog state
    private bool _dekkingDialogHidden = true;

    void OnModelChanged() => RequestParentRefresh?.Invoke();

    private List<AssemblageEntity?> _keuzeAansluitendeElementen = new();




    // Wrapper voor de keuze (zodat we ook NULL kunnen doorgeven!);
    public class AssemblageKeuze
    {
        public string Label { get; set; } = "";
        public AssemblageEntity? Value { get; set; }
    }

    private List<AssemblageKeuze> _keuzes = new();

    protected override void OnParametersSet()
    {
        // Bouw keuzes lijst (eenmalig)
        if (_keuzes.Count == 0)
        {
            _keuzes.Add(new AssemblageKeuze
            {
                Label = "(geen aansluiting)",
                Value = null
            });
             _keuzes.Add(new AssemblageKeuze
            {
                Label = "(eigen opgave)",
                Value = null // Speciaal geval, zie hieronder
            });

            _keuzes.AddRange(
                ProjectState.CurrentProject.Assemblages
                    .OfType<SteekTrapEntity>()
                    .Select(a => new AssemblageKeuze
                    {
                        Label = $"{a.Merk} ({a.Naam})",
                        Value = a
                    }));
        }

        // Update geselecteerde keuzes ELKE keer dat Model verandert
        UpdateSelectedChoices();
    }

    private void UpdateSelectedChoices()
    {
        if (_keuzes.Count == 0) return;

        // Update Trap1 selectie
        if (Model?.Trap1 != null)
        {
            if (Model.Trap1.AansluitendElement != null)
            {
                _selectedKeuze1 = _keuzes.FirstOrDefault(k => k.Value?.Id == Model.Trap1.AansluitendElement.Id);
            }
            else if (Model.Trap1.GebruikEigenOpgave)
            {
                _selectedKeuze1 = _keuzes[1]; // "(eigen opgave)"
            }
            else
            {
                _selectedKeuze1 = _keuzes[0]; // "(geen aansluiting)"
            }
        }

        // Update Trap2 selectie
        if (Model?.Trap2 != null)
        {
            if (Model.Trap2.AansluitendElement != null)
            {
                _selectedKeuze2 = _keuzes.FirstOrDefault(k => k.Value?.Id == Model.Trap2.AansluitendElement.Id);
            }
            else if (Model.Trap2.GebruikEigenOpgave)
            {
                _selectedKeuze2 = _keuzes[1]; // "(eigen opgave)"
            }
            else
            {
                _selectedKeuze2 = _keuzes[0]; // "(geen aansluiting)"
            }
        }
    }

    // koppel de keuze aan het model, zodat we ook null kunnen ondersteunen.
    private AssemblageKeuze? _selectedKeuze1;
    private AssemblageKeuze? SelectedKeuze1
    {
        get => _selectedKeuze1;
        set => _selectedKeuze1 = value;
    }

   private async Task OnKeuze1Changed(int index)
    {
        if (index >= 0 && index < _keuzes.Count)
        {
            var keuze = _keuzes[index];
            if (index == 1) // 'eigen opgave'
            {
                if (Model?.Trap1 is not null)
                {
                    Model.Trap1.AansluitendElement = null;
                    Model.Trap1.GebruikEigenOpgave = true;
                }
            }
            else
            {
                if (Model?.Trap1 is not null)
                {
                    Model.Trap1.AansluitendElement = keuze?.Value;
                    Model.Trap1.GebruikEigenOpgave = false;
                }
            }
            // Sla GUID op indien van toepassing
            Model.Trap1AansluitendElementGuid = keuze?.Value?.Id;
            OnModelChanged();
        }
        await Task.CompletedTask;
    }

    private AssemblageKeuze? _selectedKeuze2;
    private AssemblageKeuze? SelectedKeuze2
    {
        get => _selectedKeuze2;
        set => _selectedKeuze2 = value;
    }

       private async Task OnKeuze2Changed(int index)
    {
        if (index >= 0 && index < _keuzes.Count)
        {
            var keuze = _keuzes[index];
            if (index == 1) // 'eigen opgave'
            {
                if (Model?.Trap2 is not null)
                {
                    Model.Trap2.AansluitendElement = null;
                    Model.Trap2.GebruikEigenOpgave = true;
                }
            }
            else
            {
                if (Model?.Trap2 is not null)
                {
                    Model.Trap2.AansluitendElement = keuze?.Value;
                    Model.Trap2.GebruikEigenOpgave = false;
                }
            }
            // Sla GUID op indien van toepassing
            Model.Trap2AansluitendElementGuid = keuze?.Value?.Id;
            OnModelChanged();
        }
        await Task.CompletedTask;
    }

    // tekst voor universele regel
    private string universeleTekst { get; set; } = string.Empty;

    void SetTekst(PlaatWapeningGroep? groep, int laag, string tekst)
    {
        if (groep == null) return;
        var isHoofd = groep.LaagHoofdwapening == laag;
        if (isHoofd)
        {
            if (groep.BasisWapening == null)
                groep.BasisWapening = new WapeningContext();
            groep.BasisWapening.Tekst = tekst;
            groep.BasisWapening.SetZRef();
        }
        else
        {
            if (groep.VerdeelWapening == null)
                groep.VerdeelWapening = new WapeningContext();
            groep.VerdeelWapening.Tekst = tekst;
            groep.VerdeelWapening.SetZRef();
        }
        OnModelChanged();
    }

    void SetLaagHoofd(PlaatWapeningGroep groep, int laag)
    {
        if (groep == null) return;
        groep.LaagHoofdwapening = laag;
        // UpdateReferentieDekkingen will be triggered by setter in domain
        OnModelChanged();
    }

    void ApplyUniverseleTekst()
    {
        var pw = Model?.PlaatWapening;
        if (pw == null) return;

        void ApplyToGroup(PlaatWapeningGroep? g)
        {
            if (g == null) return;
            if (g.BasisWapening == null) g.BasisWapening = new WapeningContext();
            if (g.VerdeelWapening == null) g.VerdeelWapening = new WapeningContext();

            g.BasisWapening.Tekst = universeleTekst;
            g.VerdeelWapening.Tekst = universeleTekst;
            g.BasisWapening.SetZRef();
            g.VerdeelWapening.SetZRef();
        }

        ApplyToGroup(pw.Boven);
        ApplyToGroup(pw.Onder);
        OnModelChanged();
    }




    private IEnumerable<PlaatWapeningGroep?> GetPlaatWapRows()
    {
        var pw = Model?.PlaatWapening;

        var rows = new List<PlaatWapeningGroep?>();

        if (pw == null) return rows;


        var b = pw.Boven;

        rows.Add(b);

        var o = pw.Onder;
        rows.Add(o);

        return rows;
    }


    private IEnumerable<(string Vlak, int Laag, string Type, WapeningContext? Ctx, double? Dekking)> GetPlaatWapeningRows()
    {
        var pw = Model?.PlaatWapening;
        var rows = new List<(string Vlak, int Laag, string Type, WapeningContext? Ctx, double? Dekking)>();

        void AddRow(string vlak, object? gObj, int laag)
        {
            if (gObj == null)
            {
                rows.Add((vlak, laag, string.Empty, null, null));
                return;
            }

            var typeG = gObj.GetType();
            int laagHoofd = 1;
            var propLaag = typeG.GetProperty("LaagHoofdwapening");
            if (propLaag != null)
            {
                try { laagHoofd = (int)(propLaag.GetValue(gObj) ?? 1); } catch { laagHoofd = 1; }
            }

            WapeningContext? basis = null;
            var propBasis = typeG.GetProperty("BasisWapening");
            if (propBasis != null)
            {
                basis = propBasis.GetValue(gObj) as WapeningContext;
            }

            WapeningContext? verdeel = null;
            var propVerdeel = typeG.GetProperty("VerdeelWapening");
            if (propVerdeel != null)
            {
                verdeel = propVerdeel.GetValue(gObj) as WapeningContext;
            }

            bool isHoofd = laagHoofd == laag;
            var ctx = isHoofd ? basis : verdeel;
            string type = ctx == null ? string.Empty : (isHoofd ? "hoofdwapening" : "verdeel");

            double? dek = null;
            var propDekking = typeG.GetProperty("DekkingBuitensteLaag") ?? typeG.GetProperty("Dekking");
            if (propDekking != null)
            {
                var dekObj = propDekking.GetValue(gObj);
                if (dekObj != null)
                {
                    var propDekkingToe = dekObj.GetType().GetProperty("DekkingToe");
                    if (propDekkingToe != null)
                    {
                        try { dek = (double?)propDekkingToe.GetValue(dekObj); } catch { dek = null; }
                    }
                }
            }

            rows.Add((vlak, laag, type, ctx, dek));
        }

        AddRow("Boven", pw?.Boven, 1);
        AddRow("Boven", pw?.Boven, 2);
        AddRow("Onder", pw?.Onder, 2);
        AddRow("Onder", pw?.Onder, 1);

        return rows;
    }

    //private List<AssemblageEntity> KeuzeAansluitendeElementen => ProjectState.CurrentProject.Assemblages.Where(a => a.GetType() == typeof(SteekTrapEntity)).ToList();
}

