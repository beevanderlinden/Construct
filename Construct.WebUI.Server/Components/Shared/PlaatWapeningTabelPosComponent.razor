@using System
@using Eurocode.BetonConstructies

@if (Model == null)
{
    <p>Geen plaatwapening</p>
}
else
{
    <div class="table-wrap">
    <table class="ec-table col-head">
        <thead>
            <tr>
                <th>Positie</th>
                <th>Hoofdwapening</th>
                <th>Verdeelwapening</th>
                <th>Hoofdwap. in 1e laag?</th>
            </tr>
        </thead>
        <tbody>
            @RenderPosRow(Model.Boven, Model.Boven?.ReferentieVlak.ToString() ?? "?", "Boven", Model.Boven?.LaagHoofdwapening ?? 2)
                @RenderPosRow(Model.Onder, Model.Onder?.ReferentieVlak.ToString() ?? "?", "Onder", Model.Onder?.LaagHoofdwapening ?? 2)
        </tbody>
    </table>
    </div>
}

@code {
[Parameter] public PlaatWapening? Model { get; set; }
[Parameter] public EventCallback OnChanged { get; set; }
// Support @bind-Model
[Parameter] public EventCallback<PlaatWapening?> ModelChanged { get; set; }

protected override void OnParametersSet()
{
    base.OnParametersSet();
        
    // Detecteer of Boven en Onder dezelfde groep instantie zijn (dit zou NIET moeten gebeuren)
    if (Model?.Boven != null && Model?.Onder != null && ReferenceEquals(Model.Boven, Model.Onder))
    {
        Console.WriteLine("⚠️ WARNING: PlaatWapening.Boven en Onder delen dezelfde referentie!");
    }
        
    // Detecteer of BasisWapening gedeeld wordt tussen groepen (dit zou NIET moeten gebeuren)
    if (Model?.Boven?.BasisWapening != null && 
        Model?.Onder?.BasisWapening != null && 
        ReferenceEquals(Model.Boven.BasisWapening, Model.Onder.BasisWapening))
    {
        Console.WriteLine("⚠️ WARNING: BasisWapening wordt gedeeld tussen Boven en Onder!");
            
        // Fix: maak een clone voor Onder
        Model.Onder.BasisWapening = Model.Onder.BasisWapening.Clone();
    }
        
    // Detecteer of VerdeelWapening gedeeld wordt tussen groepen
    if (Model?.Boven?.VerdeelWapening != null && 
        Model?.Onder?.VerdeelWapening != null && 
        ReferenceEquals(Model.Boven.VerdeelWapening, Model.Onder.VerdeelWapening))
    {
        Console.WriteLine("⚠️ WARNING: VerdeelWapening wordt gedeeld tussen Boven en Onder!");
            
        // Fix: maak een clone voor Onder
        Model.Onder.VerdeelWapening = Model.Onder.VerdeelWapening.Clone();
    }
}

RenderFragment RenderPosRow(PlaatWapeningGroep? groep, string positie, string vlak, int laag) =>@<tr>
        <td>@positie</td>
        @{
            var basis = groep?.BasisWapening;
            var verdeel = groep?.VerdeelWapening;
        }
        <td>
            <FluentTextField Value="@(basis?.Tekst ?? string.Empty)" ValueChanged="@(v => SetHoofdTekst(groep, v))" />
        </td>
        <td>
            <FluentTextField Value="@(verdeel?.Tekst ?? string.Empty)" ValueChanged="@(v => SetVerdeelTekst(groep, v))" />
        </td>
        <td>
            @if (groep != null)
            {
                @groep.LaagHoofdwapening;
                // <div style="display:flex; gap:8px; align-items:center;">
                //     <input disabled type="checkbox" checked="@(groep.LaagHoofdwapening == 1)" @onchange="@(e => ToggleLaagHoofdCheckbox(groep, e))" />
                // </div>
            }
        </td>
    </tr>;

    void SetHoofdTekst(PlaatWapeningGroep? groep, string tekst)
    {
        if (groep == null) return;
        
        // Zorg dat we een nieuwe instantie hebben die niet gedeeld wordt
        if (groep.BasisWapening == null)
        {
            groep.BasisWapening = new WapeningContext();
        }
        
        groep.BasisWapening.Tekst = tekst;
        groep.BasisWapening.SetZRef();
        OnChanged.InvokeAsync();
        ModelChanged.InvokeAsync(Model);
    }

    void SetVerdeelTekst(PlaatWapeningGroep? groep, string tekst)
    {
        if (groep == null) return;
        
        // Zorg dat we een nieuwe instantie hebben die niet gedeeld wordt
        if (groep.VerdeelWapening == null)
        {
            groep.VerdeelWapening = new WapeningContext();
        }
        
        groep.VerdeelWapening.Tekst = tekst;
        groep.VerdeelWapening.SetZRef();
        OnChanged.InvokeAsync();
        ModelChanged.InvokeAsync(Model);
    }

    void SetLaagHoofd(PlaatWapeningGroep groep, int laag)
    {
        if (groep == null) return;
        groep.LaagHoofdwapening = laag;
        // domain logic updates dekkingen
        OnChanged.InvokeAsync();
        ModelChanged.InvokeAsync(Model);
    }

    void ToggleLaagHoofdCheckbox(PlaatWapeningGroep groep, ChangeEventArgs e)
    {
        if (groep == null) return;
        bool isChecked = false;
        try { isChecked = Convert.ToBoolean(e.Value); } catch { isChecked = e.Value != null; }
        groep.LaagHoofdwapening = isChecked ? 1 : 2;
        OnChanged.InvokeAsync();
        ModelChanged.InvokeAsync(Model);
    }
}
