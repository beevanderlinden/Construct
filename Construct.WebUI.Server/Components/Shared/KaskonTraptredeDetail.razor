    private static string SchemaUpArrow(double x, double tipY, double shaftH, double hw, double ah, double sw, string color)
    {
        double shaftBot  = tipY + shaftH;
        double arrowBase = tipY + ah;
        string shaft = $"<line x1=\"{x:F1}\" y1=\"{arrowBase:F1}\" x2=\"{x:F1}\" y2=\"{shaftBot:F1}\" stroke=\"{color}\" stroke-width=\"{sw:F1}\" />";
        string head  = $"<polygon points=\"{x:F1},{tipY:F1} {(x - hw):F1},{arrowBase:F1} {(x + hw):F1},{arrowBase:F1}\" fill=\"{color}\" stroke=\"none\" />";
        return shaft + head;
    }

    private static string SchemaHorDim(double x0, double x1, double y, double tickH, string label, double sw, double fs, string color)
    {
        double mx   = (x0 + x1) / 2;
        string line  = $"<line x1=\"{x0:F1}\" y1=\"{y:F1}\" x2=\"{x1:F1}\" y2=\"{y:F1}\" stroke=\"{color}\" stroke-width=\"{sw:F1}\" />";
        string tick0 = $"<line x1=\"{x0:F1}\" y1=\"{(y - tickH):F1}\" x2=\"{x0:F1}\" y2=\"{(y + tickH):F1}\" stroke=\"{color}\" stroke-width=\"{sw:F1}\" />";
        string tick1 = $"<line x1=\"{x1:F1}\" y1=\"{(y - tickH):F1}\" x2=\"{x1:F1}\" y2=\"{(y + tickH):F1}\" stroke=\"{color}\" stroke-width=\"{sw:F1}\" />";
        string text  = $"<text x=\"{mx:F1}\" y=\"{(y + fs * 1.2):F1}\" text-anchor=\"middle\" font-size=\"{fs:F1}\" fill=\"{color}\" font-family=\"sans-serif\">{label}</text>";
        return line + tick0 + tick1 + text;
    }

    // Berekent de soffit-knikpunten van het schema:
    // (x0,y0) = knik onderzijde = P0 van de geëxtrapoleerde onderste standaard-trede
    // (x1,y1) = knik bovenzijde = laatste soffit-punt van de bovenste trede
    private (double x0, double y0, double x1, double y1) ComputeSchemaKnikPunten()
    {
        if (SteekTrap is null) return (0, 0, 0, 0);
        double m        = TredeMargin;
        double aan      = SteekTrap.AantredeMaat;
        double op       = SteekTrap.OptredeMaat;
        double d        = SchilVertEff;
        double lb       = LengteBovenValue;
        double dikteBov = DikteBovenValue;

        double x0 = m;
        double y0 = m + 3 * op + d;   // P0 van virtuele onderste trede = soffit-start

        double p0x_last     = m + 2 * aan;
        double p0y_last     = m + op + d;
        double yHorizSoffit = p0y_last - d - op + dikteBov;
        double xSnijpunt    = LineIntersect(p0x_last, p0y_last, p0x_last + aan, p0y_last - op, 0, yHorizSoffit, 1, yHorizSoffit)?.x ?? p0x_last;

        var tand = SteekTrap.TandOpleggingBovenzijde;
        double x1, y1;
        if (tand != null)
        {
            double halsDikte   = lb - tand.TandLengte;
            double soffitHalsY = p0y_last - op * halsDikte / aan;
            double p8Y         = p0y_last - d - op + tand.TandHoogte;
            if (soffitHalsY < p8Y) { x1 = xSnijpunt;              y1 = yHorizSoffit; }
            else                   { x1 = p0x_last + halsDikte;   y1 = soffitHalsY;  }
        }
        else
        {
            double soffitRechtsY = p0y_last - op * lb / aan;
            if (soffitRechtsY < yHorizSoffit) { x1 = xSnijpunt;       y1 = yHorizSoffit;   }
            else                              { x1 = p0x_last + lb;   y1 = soffitRechtsY;  }
        }
        return (x0, y0, x1, y1);
    }

    // Bouwt de polygoonpunten van de gecombineerde doorsnede (3 treden):
    // Kloksgewijs van knik onderzijde (soffit-start onderste trede) via neuspunten +
    // tredevlakken naar knik bovenzijde (soffit-einde bovenste trede).
    // Het SVG-polygon sluit via de schuine soffit terug naar knik onderzijde.
    private string BuildSchemaDoorsnedePoints()
    {
        if (SteekTrap is null) return "";
        double m        = TredeMargin;
        double aan      = SteekTrap.AantredeMaat;
        double op       = SteekTrap.OptredeMaat;
        double d        = SchilVertEff;
        double lb       = LengteBovenValue;
        double dikteBov = DikteBovenValue;
        double p0x_last     = m + 2 * aan;
        double p0y_last     = m + op + d;
        double yHorizSoffit = p0y_last - d - op + dikteBov;
        double xSnijpunt    = LineIntersect(p0x_last, p0y_last, p0x_last + aan, p0y_last - op, 0, yHorizSoffit, 1, yHorizSoffit)?.x ?? p0x_last;

        var sb = new System.Text.StringBuilder();

        // knik onderzijde (soffit-zijde) → kloksgewijs via neuspunten + tredevlakken omhoog
        sb.Append($"{m:F1},{(m + 3 * op + d):F1} ");           // P0: knik onderzijde soffit
        sb.Append($"{m:F1},{(m + 2 * op):F1} ");               // P1: neuspunt trede 1
        sb.Append($"{(m + aan):F1},{(m + 2 * op):F1} ");       // P2: trede 1 naar rechts
        sb.Append($"{(m + aan):F1},{(m + op):F1} ");            // P3: neuspunt trede 2
        sb.Append($"{(m + 2 * aan):F1},{(m + op):F1} ");       // P4: trede 2 naar rechts
        sb.Append($"{(m + 2 * aan):F1},{m:F1} ");              // P5: neuspunt trede 3

        var tand = SteekTrap.TandOpleggingBovenzijde;
        if (tand != null)
        {
            double halsDikte   = lb - tand.TandLengte;
            double tandH       = tand.TandHoogte;
            double soffitHalsY = p0y_last - op * halsDikte / aan;
            double p8Y         = p0y_last - d - op + tandH;
            sb.Append($"{(m + 2 * aan + halsDikte):F1},{m:F1} ");              // P6: hals eind top
            sb.Append($"{(m + 2 * aan + lb):F1},{m:F1} ");                    // P7: tand top rechts
            sb.Append($"{(m + 2 * aan + lb):F1},{(m + tandH):F1} ");          // P8: tand rechtsonder
            sb.Append($"{(m + 2 * aan + halsDikte):F1},{p8Y:F1} ");           // P9: tand linksonder
            if (soffitHalsY < p8Y)
            {
                sb.Append($"{(m + 2 * aan + halsDikte):F1},{yHorizSoffit:F1} "); // P10: hor. soffit
                sb.Append($"{xSnijpunt:F1},{yHorizSoffit:F1}");                 // P11: knik bovenzijde
            }
            else
            {
                sb.Append($"{(m + 2 * aan + halsDikte):F1},{soffitHalsY:F1}");  // P10: knik bovenzijde
            }
        }
        else
        {
            double soffitRechtsY = p0y_last - op * lb / aan;
            sb.Append($"{(m + 2 * aan + lb):F1},{m:F1} ");     // P6: trede 3 naar rechts
            if (soffitRechtsY < yHorizSoffit)
            {
                sb.Append($"{(m + 2 * aan + lb):F1},{yHorizSoffit:F1} ");   // P7: hor. soffit
                sb.Append($"{xSnijpunt:F1},{yHorizSoffit:F1}");             // P8: knik bovenzijde
            }
            else
            {
                sb.Append($"{(m + 2 * aan + lb):F1},{soffitRechtsY:F1}");   // P7: knik bovenzijde
            }
        }

        return sb.ToString().TrimEnd();
    }

    // Berekent de bounding box van een of meer polygoon-punt-strings.
    private static (double xMin, double yMin, double xMax, double yMax) ComputeBoundingBox(params string[] pointsStrings)
    {
        double xMin = double.MaxValue, yMin = double.MaxValue;
        double xMax = double.MinValue, yMax = double.MinValue;
        foreach (var pointsStr in pointsStrings)
        {
            if (string.IsNullOrWhiteSpace(pointsStr)) continue;
            foreach (var pair in pointsStr.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries))
            {
                var parts = pair.Split(',');
                if (parts.Length != 2) continue;
                if (!double.TryParse(parts[0], System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double x)) continue;
                if (!double.TryParse(parts[1], System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double y)) continue;
                if (x < xMin) xMin = x;
                if (x > xMax) xMax = x;
                if (y < yMin) yMin = y;
                if (y > yMax) yMax = y;
            }
        }
        return (xMin, yMin, xMax, yMax);
    }

    // Snijpunt van lijn (x1,y1)→(x2,y2) met lijn (x3,y3)→(x4,y4). Geeft null als lijnen evenwijdig zijn.
    private static (double x, double y)? LineIntersect(
        double x1, double y1, double x2, double y2,
        double x3, double y3, double x4, double y4)
    {
        double denom = (x2 - x1) * (y4 - y3) - (y2 - y1) * (x4 - x3);
        if (Math.Abs(denom) < 1e-10) return null;
        double t = ((x3 - x1) * (y4 - y3) - (y3 - y1) * (x4 - x3)) / denom;
        return (x1 + t * (x2 - x1), y1 + t * (y2 - y1));
    }

    private static Punt? LineIntersect(Punt p1, Punt p2, Punt p3, Punt p4)
    {
        var r = LineIntersect(p1.X, p1.Y, p2.X, p2.Y, p3.X, p3.Y, p4.X, p4.Y);
        return r is { } pt ? new Punt(pt.x, pt.y) : null;
    }

    // Verwijdert opeenvolgende punten
    private static string DeduplicatePoints(string pointsStr, double tolerance = 1.0)
    {
        if (string.IsNullOrWhiteSpace(pointsStr)) return pointsStr;
        var pairs = pointsStr.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var result = new System.Collections.Generic.List<string>(pairs.Length);
        double prevX = double.NaN, prevY = double.NaN;
        foreach (var pair in pairs)
        {
            var parts = pair.Split(',');
            if (parts.Length != 2) continue;
            if (!double.TryParse(parts[0], System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double x)) continue;
            if (!double.TryParse(parts[1], System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double y)) continue;
            double dx = x - prevX, dy = y - prevY;
            if (!double.IsNaN(prevX) && Math.Sqrt(dx * dx + dy * dy) < tolerance)
                continue;
            result.Add(pair);
            prevX = x; prevY = y;
        }
        return string.Join(" ", result);
    }

    private static string RenderPointLabels(string pointsStr, double sc, string color = "red")
    {
        if (string.IsNullOrWhiteSpace(pointsStr)) return "";
        var sb = new System.Text.StringBuilder();
        double fs = 11.0 / sc;
        var pairs = pointsStr.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        for (int i = 0; i < pairs.Length; i++)
        {
            var parts = pairs[i].Split(',');
            if (parts.Length != 2) continue;
            if (!double.TryParse(parts[0], System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double x)) continue;
            if (!double.TryParse(parts[1], System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double y)) continue;
            sb.Append($"<circle cx=\"{x:F1}\" cy=\"{y:F1}\" r=\"{fs * 0.4:F1}\" fill=\"{color}\" />");
            sb.Append($"<text x=\"{x:F1}\" y=\"{y:F1}\" dy=\"{-fs * 0.4:F1}\" font-size=\"{fs:F1}\" fill=\"{color}\" font-family=\"monospace\">p{i}</text>");
        }
        return sb.ToString();
    }

    private readonly record struct Punt(double X, double Y)
    {
        public Punt AddX(double dx) => this with { X = X + dx };
        public Punt AddY(double dy) => this with { Y = Y + dy };
        public Punt Add(Punt other) => new(X + other.X, Y + other.Y);
    }
