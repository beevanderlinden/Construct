@typeparam TEnum where TEnum : struct, Enum

<div class="kit-field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="kit-field-label">@((MarkupString)Label)</span>
    }
    <div class="kit-input-group">
        <select class="kit-enum-select"
                value="@_selectedValue"
                @onchange="OnChanged"
                disabled="@Disabled">
            @foreach (var opt in _options)
            {
                <option value="@opt.Value">@opt.Text</option>
            }
        </select>
    </div>
</div>

@code {
    [Parameter] public TEnum? Value { get; set; }
    [Parameter] public EventCallback<TEnum?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private record EnumOption(string Value, string Text);
    private List<EnumOption> _options = [];
    private string? _selectedValue;

    protected override void OnInitialized()
    {
        _options = Enum.GetValues<TEnum>()
            .Select(e => new EnumOption(((int)(object)e).ToString(), e.ToString()))
            .ToList();
    }

    protected override void OnParametersSet()
    {
        _selectedValue = Value.HasValue ? ((int)(object)Value.Value).ToString() : null;
    }

    private async Task OnChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int intValue))
            await ValueChanged.InvokeAsync((TEnum)(object)intValue);
        else
            await ValueChanged.InvokeAsync(null);
    }
}
