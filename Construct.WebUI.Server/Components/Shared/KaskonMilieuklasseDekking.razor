@using System.Collections.Generic
@using Microsoft.AspNetCore.Components
@using Eurocode.BetonConstructies


@if (Boven != null && Onder != null)
{
    <span class="row-label">BOVEN</span>

    <KitTextField Label="milieuklasse" Value="@Boven?.MilieuklassenUserFriendlyName" />
    <KitInputNumberWithUnit Label="dekking nominaal" Value="@Boven?.DekkingNom" Units="UnitSets.LengteMM" Format="0" Disabled="true" />
    <KitInputNumberWithUnit Label="dekking toegepast" @bind-Value="@Boven!.DekkingToe" Units="UnitSets.LengteMM" Format="0"  />
    <span>
        <FluentButton Appearance="Appearance.Stealth"
                      Title="Toon details"
                      OnClick="@(() => _dekkingBovenDialogHidden = false)"
                      IconStart="@(new Icons.Regular.Size28.MoreHorizontal())">
        </FluentButton>
    </span>

    <br />
    <span class="row-label">ONDER</span>

    <KitTextField Label="milieuklasse" Value="@Onder?.MilieuklassenUserFriendlyName" />
    <KitInputNumberWithUnit Label="dekking nominaal" Value="@Onder?.DekkingNom" Units="UnitSets.LengteMM" Format="0" Disabled="true" />
    <KitInputNumberWithUnit Label="dekking toegepast" @bind-Value="@Onder!.DekkingToe" Units="UnitSets.LengteMM" Format="0" />
    <span>
        <FluentButton Appearance="Appearance.Stealth"
                      Title="Toon details"
                      OnClick="@(() => _dekkingOnderDialogHidden = false)"
                      IconStart="@(new Icons.Regular.Size28.MoreHorizontal())">
        </FluentButton>
    </span>

}







@if ((Onder?.Meldingen?.Count ?? 0) > 0 || (Boven?.Meldingen?.Count ?? 0) > 0)
{
    <KaskonInputContainer Label="meldingen">
        @foreach (var melding in Boven?.Meldingen ?? [])
        {
            <div>
                boven: @((MarkupString)melding.Bericht)
            </div>
        }
        @foreach (var melding in Onder?.Meldingen ?? [])
        {
            <div>
                onder: @((MarkupString)melding.Bericht)
            </div>
        }
    </KaskonInputContainer>
}


@if (!_dekkingBovenDialogHidden)
{
    <div class="modal-backdrop custom-blur" @onclick="@(() => _dekkingBovenDialogHidden = true)">
        <div class="modal-content-base modal-content-wide" style="margin-left: 350px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h1>Betondekking boven - @Merk</h1>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => _dekkingBovenDialogHidden = true)">
                    ×
                </button>
            </div>
            <div class="modal-body">
                <BetonDekkingEditor Dekking="@Boven" OnChanged="OnChanged" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="@(() => _dekkingBovenDialogHidden = true)">
                    Sluiten
                </button>
            </div>
        </div>
    </div>
}

@if (!_dekkingOnderDialogHidden)
{
    <div class="modal-backdrop custom-blur" @onclick="@(() => _dekkingOnderDialogHidden = true)">
        <div class="modal-content-base modal-content-wide" style="margin-left: 350px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h1>Betondekking onder - @Merk</h1>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => _dekkingOnderDialogHidden = true)">
                    ×
                </button>
            </div>
            <div class="modal-body">
                <BetonDekkingEditor Dekking="@Onder" OnChanged="OnChanged" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="@(() => _dekkingOnderDialogHidden = true)">
                    Sluiten
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public BetonDekkingContext? Boven { get; set; }
    [Parameter] public BetonDekkingContext? Onder { get; set; }
    [Parameter] public string? Merk { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _dekkingBovenDialogHidden = true;
    private bool _dekkingOnderDialogHidden = true;
}
