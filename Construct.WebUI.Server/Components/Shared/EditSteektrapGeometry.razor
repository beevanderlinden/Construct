@using System.Globalization
@inject IProjectStateService ProjectState


@if(SteekTrap is HoekTrapEntity hoektrap)
{
    <KitInputNumberWithUnit Label="L1" 
                            Min="hoektrap.B2"
                            Step="100"
                            T="double" @bind-Value="hoektrap.L1" Units="UnitSets.LengteMM" OnValueChanged="OnModelChanged" />
    <KitInputNumberWithUnit Label="L2"
                            Step="100"
                            Min="hoektrap.B1"           
                            T="double" @bind-Value="hoektrap.L2" Units="UnitSets.LengteMM" OnValueChanged="OnModelChanged" />
    <KitInputNumberWithUnit Label="B1" 
                            Min="600"
                            Max="hoektrap.L2"
                            Step="100"
                            T="double" @bind-Value="hoektrap.B1" Units="UnitSets.LengteMM" OnValueChanged="OnModelChanged" />
    <KitInputNumberWithUnit Label="B2" 
                            Min="600"       
                            Max="hoektrap.L1"
                            Step="100"  
                            T="double" @bind-Value="hoektrap.B2" Units="UnitSets.LengteMM" OnValueChanged="OnModelChanged" />


}



@if(SteekTrap != null)
{
    




       
    <KitInputNumberWithUnit Label="lengte <i>L<sub>t,proj.Z</sub></i>" 
                            Disabled="@(!SteekTrap.GebruikEigenLengte)"
                            T="double" Min="800" Max="8000" Step="50" @bind-Value="SteekTrap.LtProjZ" 
                            Units="UnitSets.LengteMM" OnValueChanged="OnModelChanged" />
    <FluentSwitch Value="SteekTrap.GebruikEigenLengte" ValueChanged="OnGebruikEigenLengteChanged"
                  CheckedMessage="lengte opgave gebruiker" UncheckedMessage="lengte automatisch"></FluentSwitch>
   
                  <br />

                  @if(!SteekTrap.GebruikEigenLengte)
                  {
        <KitInputNumberWithUnit Label="aantal treden"
                                Disabled="@(SteekTrap.GebruikEigenLengte)"
                                T="int" Min="3" Max="23"
                                Units="UnitSets.Geen" @bind-Value="SteekTrap.OptredeAantal1" OnValueChanged="OnModelChanged" />

        <br />
    }

             


   



        

    <KitInputNumberWithUnit Label="hoogte <i>H<sub>t</sub></i>"
                            Disabled="@(!SteekTrap.GebruikEigenLengte)"
                            T="double" Min="0" Max="5000" Step="50" @bind-Value="SteekTrap.HoogteTotaal"
                            Units="UnitSets.LengteMM" OnValueChanged="OnModelChanged" />

    <FluentSwitch Value="SteekTrap.GebruikEigenHoogte" ValueChanged="OnGebruikEigenHoogteChanged"
                  CheckedMessage="hoogte opgave gebruiker" UncheckedMessage="hoogte automatisch"
                  Disabled="@(!SteekTrap.GebruikEigenLengte)"></FluentSwitch>
                  <br />




    <KaskonTraptredeDetail SteekTrap="SteekTrap" OnChanged="OnModelChanged" />


    <KitInputNumberWithUnit Label="optrede" Units="UnitSets.LengteMM" T="double" @bind-Value="SteekTrap.OptredeMaat" /> 
    <KitInputNumberWithUnit Label="aantrede" Units="UnitSets.LengteMM" T="double" @bind-Value="SteekTrap.AantredeMaat" />
    <KitInputNumberWithUnit Label="schildikte" Units="UnitSets.LengteMM" T="double" @bind-Value="SteekTrap.SchilDikte" />
    <KitInputNumberWithUnit Label="adviesdikte" T="double" Value="SteekTrap.AdviesSchildikteMin" Units="UnitSets.LengteMM" Disabled=true />
    <KitInputNumberWithUnit Label="trapbreedte" T="double" Min="600" Max="4000" Step="100" @bind-Value="SteekTrap.Breedte" Units="UnitSets.LengteMM" />
    <KitInputNumberWithUnit Label="afwerking" T="double" Min="0" Max="50" Step="0.5" @bind-Value="SteekTrap.AfwerkingVlaklast" Units="UnitSets.KrachtPerOppervlak" />



    @*   <KaskonInputContainer Label="dragende bomen?">
         <FluentCheckbox @bind-Value="SteekTrap.DragendeTrapBomen" Disabled="!true">

         </FluentCheckbox>
     </KaskonInputContainer> *@

     @if (SteekTrap.DragendeTrapBomen){
         <p>Dragende bomen UNDER CONSTRUCTION.</p>


        
            <KitInputNumberWithUnit Label="boomhoogte" Min="200" Max="500" Step="10" T="double" @bind-Value="SteekTrap.TrapBomenHoogte" Units="UnitSets.LengteMM" />
            <KitInputNumberWithUnit Label="boombreedte" T="double" Min="60" Max="400" Step="10" @bind-Value="SteekTrap.TrapBoomBreedte" Units="UnitSets.LengteMM" />


     }
    
    <br />
    <br />
    <FluentCheckbox Value="SteekTrap.HeeftBoventand" Label="boventand" ValueChanged="@OnHeeftBoventandChanged" />
    <br />
    <FluentCheckbox Value="SteekTrap.HeeftOndertand" Label="ondertand" ValueChanged="@OnHeeftOndertandChanged" />
    <br />

    
   

    @if(SteekTrap.TandOpleggingBovenzijde != null)
    {
        <KitTextBox Label="wapening boven" @bind-Value="SteekTrap.TandOpleggingBovenzijde!.WapeningAlgemeen.Tekst"></KitTextBox>
    }

    @if (SteekTrap.TandOpleggingOnderzijde != null)
    {
        <KitTextBox Label="wapening onder" @bind-Value="SteekTrap.TandOpleggingOnderzijde!.WapeningAlgemeen.Tekst"></KitTextBox>
    }







}


@code 
{
    [Parameter] public SteekTrapEntity? SteekTrap{ get; set; }
    [Parameter] public EventCallback<SteekTrapEntity> SteekTrapChanged{ get; set; }
    [CascadingParameter] public Action? RequestParentRefresh { get; set; }
    void OnModelChanged() => RequestParentRefresh?.Invoke();

    private void OnGebruikEigenLengteChanged(bool value)
    {
        if (SteekTrap == null) return;
        SteekTrap.GebruikEigenLengte = value;
        if (!value)
            SteekTrap.GebruikEigenHoogte = false;
        OnModelChanged();
    }

    private void OnGebruikEigenHoogteChanged(bool value)
    {
        if (SteekTrap == null) return;
        SteekTrap.GebruikEigenHoogte = value;
        OnModelChanged();
    }

    // Nog geen raamwerk -> tot die tijd deze vormen uitsluiten
    private List<SteekTrapTypeEnum> excludedSteekTrapTypen { get; set; } = [
        SteekTrapTypeEnum.TrapBordes,
        SteekTrapTypeEnum.BordesTrap,
        SteekTrapTypeEnum.BordesTrapBordes,
        SteekTrapTypeEnum.TrapBordesTrap,
        SteekTrapTypeEnum.BordesTrapBordesTrap,
        SteekTrapTypeEnum.TrapBordesTrapBordes,
        SteekTrapTypeEnum.BordesTrapBordesTrapBordes,
    ];

    private string _bovensteAantredeMode = "standaard";
    private string BovensteAantredeMode => _bovensteAantredeMode;
    private SteekTrapEntity? _previousSteekTrap;

    protected override void OnParametersSet()
    {
        if (SteekTrap == _previousSteekTrap) return;
        _previousSteekTrap = SteekTrap;

        var tand = SteekTrap?.TandOpleggingBovenzijde;
        if (tand == null) { _bovensteAantredeMode = "standaard"; return; }
        if (tand.HalsDikteOpgave.HasValue) _bovensteAantredeMode = "halsdikte";
        else if (tand.BovensteAantredeLengteOpgave.HasValue) _bovensteAantredeMode = "lengte";
        else _bovensteAantredeMode = "standaard";
    }

    private void OnHeeftBoventandChanged(bool value)
    {
        if (SteekTrap == null) return;
        SteekTrap.HeeftBoventand = value;
        if (value && SteekTrap.TandOpleggingBovenzijde == null)
        {
            SteekTrap.TandOpleggingBovenzijde = new(SteekTrap, new())
            {
                TandLengte = 100,
                TandHoogte = 100,
                WapeningAlgemeen = new WapeningContext() { Tekst = "6-75" },
                VoegBreedte = 10,
            };
            SteekTrap.TandOpleggingBovenzijde.HalsDikte = SteekTrap.TandOpleggingBovenzijde.BerekenHalsDikte(SteekTrap.LengteBovenNetto);
            _bovensteAantredeMode = "standaard";
        }
        else if (!value)
        {
            SteekTrap.TandOpleggingBovenzijde = null;
        }
        SteekTrap.IsAkkoord();
        OnModelChanged();
    }

    private void OnHeeftOndertandChanged(bool value)
    {
        if (SteekTrap == null) return;
        SteekTrap.HeeftOndertand = value;
        if (value && SteekTrap.TandOpleggingOnderzijde == null)
        {
            SteekTrap.TandOpleggingOnderzijde = new(SteekTrap, new())
            {
                TandLengte = 100,
                TandHoogte = 100,
                WapeningAlgemeen = new WapeningContext() { Tekst = "6-75" },
                VoegBreedte = 10,
            };
            SteekTrap.TandOpleggingOnderzijde.HalsDikte = SteekTrap.TandOpleggingOnderzijde.BerekenHalsDikte(SteekTrap.LengteBovenNetto);
            _bovensteAantredeMode = "standaard";
        }
        else if (!value)
        {
            SteekTrap.TandOpleggingOnderzijde = null;
        }
        SteekTrap.IsAkkoord();
        OnModelChanged();
    }



    private void OnBovensteAantredeModeChanged(string mode)
    {
        if (SteekTrap?.TandOpleggingBovenzijde == null) return;
        _bovensteAantredeMode = mode;
        SteekTrap.TandOpleggingBovenzijde.HalsDikteOpgave = null;
        SteekTrap.TandOpleggingBovenzijde.BovensteAantredeLengteOpgave = null;
        SteekTrap.TandOpleggingBovenzijde.HalsDikte = SteekTrap.TandOpleggingBovenzijde.BerekenHalsDikte(SteekTrap.LengteBovenNetto);
        SteekTrap.IsAkkoord();
        OnModelChanged();
    }

    private double HalsDikteOpgaveValue
    {
        get => SteekTrap?.TandOpleggingBovenzijde?.HalsDikteOpgave
               ?? SteekTrap?.TandOpleggingBovenzijde?.HalsDikte
               ?? 0;
        set
        {
            if (SteekTrap?.TandOpleggingBovenzijde == null) return;
            SteekTrap.TandOpleggingBovenzijde.HalsDikteOpgave = value;
            SteekTrap.TandOpleggingBovenzijde.HalsDikte = SteekTrap.TandOpleggingBovenzijde.BerekenHalsDikte(SteekTrap.LengteBovenNetto);
            SteekTrap.IsAkkoord();
        }
    }

    private double BovensteAantredeLengteOpgaveValue
    {
        get => SteekTrap?.TandOpleggingBovenzijde?.BovensteAantredeLengteOpgave
               ?? SteekTrap?.AantredeMaat
               ?? 0;
        set
        {
            if (SteekTrap?.TandOpleggingBovenzijde == null) return;
            SteekTrap.TandOpleggingBovenzijde.BovensteAantredeLengteOpgave = value;
            SteekTrap.LengteBoven = value;
            SteekTrap.TandOpleggingBovenzijde.HalsDikte = SteekTrap.TandOpleggingBovenzijde.BerekenHalsDikte(SteekTrap.LengteBovenNetto);
            SteekTrap.IsAkkoord();
        }
    }











}
