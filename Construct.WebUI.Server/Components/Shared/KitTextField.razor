<div class="@_cssClass" style="@_style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="kit-field-label">@((MarkupString)Label)</span>
    }
    <span class="kit-field-value">@Value</span>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Width { get; set; }
    [Parameter] public bool TextOnly { get; set; }

    private string _cssClass => TextOnly
        ? "kit-field kit-field--readonly kit-field--text-only"
        : "kit-field kit-field--readonly";

    private string? _style => Width is not null ? $"min-width:{Width}" : null;
}
