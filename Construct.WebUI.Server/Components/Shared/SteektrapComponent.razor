@if (Model.TandOpleggingBovenzijde != null)
{
    <h6>Oplegneus</h6>
    <TrapNeusComponent @bind-Model="Model.TandOpleggingBovenzijde" />
}











@code {
    [Parameter, EditorRequired]
    public SteekTrapEntity Model { get; set; }  
    [Parameter]
    public EventCallback<SteekTrapEntity> ModelChanged { get; set; }

    private BetonContext? _beton
    {
        get
        {
            var beton = Model.Materiaal as BetonContext;
            return beton;
        }
    }

    private BetonStaalContext _betonstaal => _beton?.BetonStaal ?? new();



}

