@using Construct.Domain.Entities
@using System.Globalization

<div style="width: 100%; max-width: 800px; margin: 20px auto; padding: 20px; border: 2px solid #ff6b6b; background: #fff5f5;">
    <h3 style="margin: 0 0 10px 0; color: #ff6b6b;">🔧 Debug SVG Component</h3>
    
    <svg viewBox="@GetViewBox()" 
         preserveAspectRatio="xMidYMid meet" 
         style="width: 100%; max-height: 400px; height: auto; border: 1px solid #333; background: white;">
        
        <defs>
            <marker id="arrowhead-debug" markerWidth="10" markerHeight="7" 
                    refX="9" refY="3.5" orient="auto-start-reverse">
                <polygon points="0 0, 10 3.5, 0 7" fill="#ff6b6b" />
            </marker>
            <marker id="circle-cross-debug" markerWidth="8" markerHeight="8" 
                    refX="4" refY="4" orient="auto">
                <circle cx="4" cy="4" r="3" fill="none" stroke="#ff6b6b" stroke-width="1"/>
                <line x1="1" y1="4" x2="7" y2="4" stroke="#ff6b6b" stroke-width="1"/>
                <line x1="4" y1="1" x2="4" y2="7" stroke="#ff6b6b" stroke-width="1"/>
            </marker>
        </defs>

        @foreach (var element in BuildDebugElements())
        {
            @((MarkupString)element.Render())
        }
    </svg>
    
    <div style="margin-top: 10px; padding: 10px; background: #f8f9fa; border-radius: 4px; font-family: monospace; font-size: 12px;">
        <div><strong>Expected:</strong> &lt;----TEXT BOVEN LIJN----&gt;</div>
        <div><strong>ViewBox:</strong> @GetViewBox()</div>
        <div><strong>Rect:</strong> 400 x 500 mm</div>
        <div><strong>Marge:</strong> @Marge mm</div>
    </div>
</div>

@code {
    private double Marge => 80;
    private double RectWidth => 400;
    private double RectHeight => 500;
    private double Scale => 0.8;

    private string GetViewBox()
    {
        var totalWidth = RectWidth + (Marge * 2) + 100;
        var totalHeight = RectHeight + (Marge * 2) + 100;
        return $"0 0 {totalWidth.ToString("F0", CultureInfo.InvariantCulture)} {totalHeight.ToString("F0", CultureInfo.InvariantCulture)}";
    }

    private List<BaseSvg> BuildDebugElements()
    {
        var elements = new List<BaseSvg>();

        // Rechthoek 400x500
        elements.Add(new SvgRect
        {
            X = Marge,
            Y = Marge,
            Width = RectWidth,
            Height = RectHeight,
            Fill = "#e3f2fd",
            Stroke = "#1976d2",
            StrokeWidth = 2
        });

        // Tekst in het midden
        var textMidden = new SvgText
        {
            X = Marge + RectWidth / 2,
            Y = Marge + RectHeight / 2,
            Text = "TEST",
            Anchor = "middle",
            DominantBaseLine = "middle",
            Pts = 12,
            Scale = Scale,
            Fill = "#1976d2"
        };
        elements.Add(textMidden);

        // Maatlijn onder (horizontaal)
        var dimOnder = new SvgDimLine
        {
            X1 = Marge,
            Y1 = Marge + RectHeight,
            X2 = Marge + RectWidth,
            Y2 = Marge + RectHeight,
            Offset = -40,
            Mode = DimLineMode.Horizontal,
            ShowExtensionLines = true,
            StrokeColor = "#ff6b6b",
            StrokeWidth = 1.5,
            Scale = Scale,
            Text = "ONDER HORIZONTAAL",
            MarkerStart = "arrowhead-debug",
            MarkerEnd = "arrowhead-debug"
        };
        elements.Add(dimOnder);

        // Maatlijn rechts (verticaal)
        var dimRechts = new SvgDimLine
        {
            X1 = Marge + RectWidth,
            Y1 = Marge,
            X2 = Marge + RectWidth,
            Y2 = Marge + RectHeight,
            Offset = -40,
            Mode = DimLineMode.Vertical,
            ShowExtensionLines = true,
            StrokeColor = "#4caf50",
            StrokeWidth = 1.5,
            Scale = Scale,
            Text = "RECHTS VERTICAAL",
            MarkerStart = "circle-cross-debug",
            MarkerEnd = "circle-cross-debug"
        };
        elements.Add(dimRechts);

        // Extra test: Horizontale maatlijn van rechts naar links
        var dimReverseHorizontaal = new SvgDimLine
        {
            X1 = Marge + RectWidth,
            Y1 = Marge,
            X2 = Marge,
            Y2 = Marge,
            Offset = 40,
            Mode = DimLineMode.Horizontal,
            ShowExtensionLines = true,
            StrokeColor = "#ff9800",
            StrokeWidth = 1.5,
            Scale = Scale,
            Text = "BOVEN (REVERSED)",
            MarkerStart = "arrowhead-debug",
            MarkerEnd = "arrowhead-debug"
        };
        elements.Add(dimReverseHorizontaal);

        // Extra test: Verticale maatlijn van onder naar boven
        var dimReverseVerticaal = new SvgDimLine
        {
            X1 = Marge,
            Y1 = Marge + RectHeight,
            X2 = Marge,
            Y2 = Marge,
            Offset = 40,
            Mode = DimLineMode.Vertical,
            ShowExtensionLines = true,
            StrokeColor = "#9c27b0",
            StrokeWidth = 1.5,
            Scale = Scale,
            Text = "LINKS (REVERSED)",
            MarkerStart = "circle-cross-debug",
            MarkerEnd = "circle-cross-debug"
        };
        elements.Add(dimReverseVerticaal);

        return elements;
    }
}