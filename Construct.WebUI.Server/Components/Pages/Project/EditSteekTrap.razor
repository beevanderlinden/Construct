    private async Task MaakDemo(string plotlyId)
    {
        // test voor laden frame2d
        if (SteekTrap == null) return;

        // reset
        GeometryService.Reset();
        GeometryService.PlotlyId = plotlyId;

        GeometryModel geometry = new();
        int id = 1;
        geometry.Sections.Add(new(id++, $"RH1000x{SteekTrap.SchilDikte:0}"));
        geometry.Sections.Add(new(id++, $"RH1000x{SteekTrap.DikteBoven:0}"));

        id = 1;
        foreach (var p in SteekTrap.GetHartlijn())
        {
            geometry.Nodes.Add(new(id++, p.X * 0.001, p.Y * 0.001));
        }




        double trapQg = -SteekTrap.GetPermanenteBelasting();


        double bordesQg = -SteekTrap.GetPermanenteBelastingBordes();

        id = 1;
        for (int i = 0; i < geometry.Nodes.Count() -1; i++)
        {
            int j = i + 1;
            // trap of bordes?
            var q = -1.0;
            var section = geometry.Sections[0];
            if (geometry.Nodes[i].Z != geometry.Nodes[j].Z)
            {
                q = trapQg;
                section = geometry.Sections[0];

            }
            else
            {
                q = bordesQg;
                section = geometry.Sections[1];
            }

            // voeg staaf toe aan de geometrie
            geometry.Members.Add(
                new()
                {
                    Id = id++,
                    StartNode = geometry.Nodes[i],
                    EndNode = geometry.Nodes[j],
                    Section = section
                }
            );

            // voeg lijnlast toe aan de staaf
            geometry.MemberForces.Add(new() { 
                Id = geometry.MemberForces.Count + 1, 
                StartMagnitude = q, 
                EndMagnitude = q, 
                Member = geometry.Members[i], 
                Type = MemberForceModel.MemberForceType.QProjZ });


        }
        id = 1;
        geometry.Supports.Add(new() { Id = id++, Node = geometry.Nodes.First(), Dof = SupportModel.DofEnum.Ux | SupportModel.DofEnum.Uz });
        geometry.Supports.Add(new() { Id = id++, Node = geometry.Nodes.Last(), Dof = SupportModel.DofEnum.Uz });




        GeometryService.Model = geometry;



        await ChartService.UpdateChartAsync(GeometryService);

    }



