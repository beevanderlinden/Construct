    {
        var filteredContexten = contexten.Where(ch => ch != null).ToArray();

        return filteredContexten
        .Where(c => c.Meldingen != null)
        .Any(c => c.Meldingen.Any(m => m.Type == MeldingType.Waarschuwing)) ? Color.Warning : Color.Success;
