                            <FluentNumberField @bind-Value="SteekTrap.WelMaatVertikaal">

                            </FluentNumberField>
                        </KaskonInputContainer>





                        <hr />





                        <FluentSwitch @bind-Value="IsBovenzijdeAanwezig" CheckedMessage="oplegneus" UncheckedMessage="oplegneus n.v.t." />
                        @if (SteekTrap.TandOpleggingBovenzijde != null)
                        {

                            <EurocodeInputNumber Key="@K.TandLengte"
                                                 Unit="mm"
                                                 StringFormat="0"
