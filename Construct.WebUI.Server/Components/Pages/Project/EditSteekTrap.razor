                        </EurocodeInputNumber>



                        <EurocodeInputContainer Key="Wapening">
                            <FluentTextField @bind-Value="SteekTrap.WapeningSchil.Tekst"></FluentTextField>
                        </EurocodeInputContainer>

                        <EurocodeInputNumber Key="AsToe" Unit="mm²/m" StringFormat="0" ReadOnly="true" Value="SteekTrap.WapeningSchil.As" MinValue="@SteekTrap.MomentSchil.AsRequired" />
                        <EurocodeInputNumber Key="@K.AsBen" Unit="mm²/m" StringFormat="0" ReadOnly="true" Value="SteekTrap.MomentSchil.AsRequired" />


                        <h6>Details (trede)</h6>




                        <KaskonInputContainer Label="welmaat">
