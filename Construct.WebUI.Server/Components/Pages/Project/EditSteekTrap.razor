                            {
                                case SteekTrapTypeEnum.TrapBordesTrap:
                                case SteekTrapTypeEnum.TrapBordesTrapBordes:
                                case SteekTrapTypeEnum.BordesTrapBordesTrapBordes:
                                case SteekTrapTypeEnum.BordesTrapBordesTrap:
                                    <FluentNumberField Step="1" @bind-Value="@SteekTrap.OptredeAantal2"><span class="fluent-input-label">aantal optreden (2e trap)</span></FluentNumberField>
                                    break;
                            }


                            // bordes onder
                            if (SteekTrap.SteekTrapType == SteekTrapTypeEnum.BordesTrap ||
                            SteekTrap.SteekTrapType == SteekTrapTypeEnum.BordesTrapBordes ||
                            SteekTrap.SteekTrapType == SteekTrapTypeEnum.BordesTrapBordesTrap
                            )
                            {
                                <FluentNumberField Step="100" @bind-Value="@SteekTrap.LengteOnder">Lengte bordes onder [mm]</FluentNumberField>
                                <FluentNumberField Step="10" @bind-Value="@SteekTrap.DikteOnder">Dikte bordes onder [mm]</FluentNumberField>
                            }
                            // tussen bordes
                            if (SteekTrap.SteekTrapType == SteekTrapTypeEnum.TrapBordesTrap ||
                            SteekTrap.SteekTrapType == SteekTrapTypeEnum.BordesTrapBordesTrap
                            )
                            {
                                <FluentNumberField Step="100" @bind-Value="@SteekTrap.LengteTussen">Lengte bordes tussen [mm]</FluentNumberField>
                                <FluentNumberField Step="10" @bind-Value="@SteekTrap.DikteTussen">Dikte bordes tussen [mm]</FluentNumberField>
                            }



                            // bordes boven
                            if (SteekTrap.SteekTrapType == SteekTrapTypeEnum.TrapBordes ||
                            SteekTrap.SteekTrapType == SteekTrapTypeEnum.BordesTrapBordes ||
                            SteekTrap.SteekTrapType == SteekTrapTypeEnum.TrapBordesTrapBordes
