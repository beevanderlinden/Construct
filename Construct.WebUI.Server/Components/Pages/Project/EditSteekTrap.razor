@code {
    string activeId = "accordion-1";
    bool uitgebreid = false;
    private SteekTrapContextWrapper? WrapperModel { get; set; }
    string ViewBox => SteekTrap != null ? $"-200 -{200 + SteekTrap.HoogteTotaal} {400 + SteekTrap.LengteTotaal} {400 + SteekTrap.HoogteTotaal}" : "-200 -200 400 400";

    FluentAccordionItem? changed;

    private void HandleOnAccordionItemChange(FluentAccordionItem item)
    {
        changed = item;
    }

    private List<SteekTrapTypeEnum> excludedSteekTrapTypen { get; set; } = [
        SteekTrapTypeEnum.TrapBordes, 
        SteekTrapTypeEnum.BordesTrap,
        SteekTrapTypeEnum.BordesTrapBordes, 
        SteekTrapTypeEnum.TrapBordesTrap, 
        SteekTrapTypeEnum.BordesTrapBordesTrap,
        SteekTrapTypeEnum.TrapBordesTrapBordes, 
        SteekTrapTypeEnum.BordesTrapBordesTrapBordes,

    ];


    private void DoorbuigingBijwerken()
    {
        if (SteekTrap == null) return;
        SteekTrap.DoorbuigingContext.LengteMM = SteekTrap.LengteSchuin;
        SteekTrap.DoorbuigingContext.Lijnlast = SteekTrap.Krachten.Gk * SteekTrap.FactorProjectieZToLocalZ;
        SteekTrap.DoorbuigingContext.D = SteekTrap.SchilDikte - SteekTrap.WapeningSchil.ZRef;
        SteekTrap.DoorbuigingValidatie.BerekenEnValideer();
