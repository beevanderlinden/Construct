    private Icon GetIcon(params BaseEurocodeContext[] contexten)
    {
        var items = contexten.Where(c => c != null).ToArray();
        return items
            .Where(x => x.Meldingen != null)
            .Any(x => x.Meldingen.Any(m => m.Type == MeldingType.Waarschuwing))
            ? new Icons.Regular.Size24.ErrorCircle()
            : new Icons.Regular.Size24.CheckmarkCircle();
    }

