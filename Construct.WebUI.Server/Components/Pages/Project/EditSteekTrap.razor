                <FluentTab Id="tab-Toetsen" Label="Toetsen">
                    <Header>
                        <FluentIcon Value="@(new Icons.Regular.Size28.Lightbulb())" Color="Color.Accent"></FluentIcon>Toetsen
                    </Header>

                    <Content>
                        <FluentAccordion ExpandMode="AccordionExpandMode.Multi" ActiveId="@activeId" OnAccordionItemChange="HandleOnAccordionItemChange">


                            <FluentAccordionItem Heading="Doorbuiging">
                                @* <FluentIcon Value="@(new Icons.Regular.Size24.Check())" Color="Color.Accent" Slot="start" /> *@
                                @* <FluentButton OnClick="DoorbuigingBijwerken">Bijwerken</FluentButton> *@
                                @* Akkoord: @SteekTrap.Doorbuiging.IsValidated *@
                                @* <EurocodeRazorClassLibrary.Shared.MyGridFor Model="@SteekTrap.DoorbuigingValidatie" ReadOnly="true" /> *@

                                <button @onclick="@(() => SteekTrap.Bijwerken())">Bijwerken</button>

                                <p>w<sub>max</sub> = @SteekTrap.DoorbuigingValidatie.Wmax.ToString("0.#") mm | toelaatbaar = @SteekTrap.DoorbuigingValidatie.GrenswaardeEind.ToString("0.#") mm | (UC=@SteekTrap.DoorbuigingValidatie.UnityCheckEind.ToString("0.00")) </p>
                                <p>w<sub>bijk</sub> = @SteekTrap.DoorbuigingValidatie.Wbijk.ToString("0.#") mm | toelaatbaar = @SteekTrap.DoorbuigingValidatie.GrenswaardeBijkomend.ToString("0.#") mm | (UC=@SteekTrap.DoorbuigingValidatie.UnityCheckBijkomend.ToString("0.00"))</p>
                                
                                <p>w<sub>1</sub> = @SteekTrap.DoorbuigingValidatie.W1.ToString("0.#") mm</p>

                                @if (!SteekTrap.DoorbuigingValidatie.IsValidated)
                                {
                                    <p class="warning">Doorbuiging niet akkoord.</p>
                                }
                               


                                <FluentIcon Value="@GetIcon(SteekTrap.DoorbuigingValidatie.IsValidated)" Color="GetIconColor(SteekTrap.DoorbuigingValidatie.IsValidated)" Slot="end" />
                            </FluentAccordionItem>


