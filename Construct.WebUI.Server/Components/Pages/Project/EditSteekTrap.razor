                                @* <FluentIcon Value="@(new Icons.Regular.Size24.Check())" Color="Color.Accent" Slot="start" /> *@
                                @* <EurocodeRazorClassLibrary.Shared.MyGridFor @bind-Model="SteekTrap.DekkingBoven" /> *@

                                <EurocodeRazorClassLibrary.Beton.EurocodeBetonDuurzaamheid @bind-Model="@SteekTrap.DekkingBoven" OnStateChanged="StateHasChanged" />



                                <FluentIcon Value="@GetIcon(SteekTrap.DekkingBoven)" Color="GetIconColor(SteekTrap.DekkingBoven)" Slot="end" />
                            </FluentAccordionItem>

                            <FluentAccordionItem Expanded="false" Heading="Moment wapening">
                                @* <FluentIcon Value="@(new Icons.Regular.Size24.Check())" Color="Color.Accent" Slot="start" /> *@
                                @* <EurocodeRazorClassLibrary.Shared.MyGridFor @bind-Model="SteekTrap.MomentSchil" /> *@

                                <EurocodeRazorClassLibrary.Beton.BuigingBasicComponent @bind-Model="@SteekTrap.MomentSchil" />
                                <FluentIcon Value="@GetIcon(SteekTrap.MomentSchil)" Color="GetIconColor(SteekTrap.MomentSchil)" Slot="end" />
                            </FluentAccordionItem>

                            <FluentAccordionItem Expanded="false" Heading="Scheurwijdte">
                                @* <FluentIcon Value="@(new Icons.Regular.Size24.Check())" Color="Color.Accent" Slot="start" /> *@
                               @*  <EurocodeRazorClassLibrary.Shared.MyGridFor 
                                @bind-Model="SteekTrap.Scheurwijdte" 
                                ShowNonEditables=true                       
                                /> *@


                                <EurocodeBetonScheurwijdteComponent Model="@SteekTrap.Scheurwijdte"></EurocodeBetonScheurwijdteComponent>
                                <FluentIcon Value="@GetIcon(SteekTrap.Scheurwijdte)" Color="GetIconColor(SteekTrap.Scheurwijdte)" Slot="end" />
                            </FluentAccordionItem>

                            <FluentAccordionItem Expanded="false" Heading="Dwarskracht">
                                @if (SteekTrap.Dwarskracht.IsDwarskrachtWapeningBenodigd())
                                {
                                    <FluentIcon Value="@GetIcon(false)" Color="Color.Warning" Slot="end" />

                                    <span>Let op! Dwarskrachtwapening noodzakelijk</span>
                                }
                                else
                                {
                                    <span>Dwarskracht akkoord, geen dwarskrachtwapening nodig.</span>
                                    <FluentIcon Value="@GetIcon(true)" Color="Color.Success" Slot="end" />

                                }
                                @* <FluentIcon Value="@(new Icons.Regular.Size24.Check())" Color="@Color.Accent" Slot="start" /> *@
                                <EurocodeRazorClassLibrary.Beton.EurocodeBetonDwarskrachtComponent Model="@SteekTrap.Dwarskracht" />
                            </FluentAccordionItem>

                         

                            <FluentAccordionItem Expanded="false" Heading="Oplegspanningen">
                                @* <FluentIcon Value="@(new Icons.Regular.Size24.Check())" Color="@Color.Accent" Slot="start" /> *@
                                @if (SteekTrap.TandOpleggingBovenzijde != null)
                                {
                                    <FluentCard Height="auto">
                                        <div>
                                            De nominale opleglengte <i>a</i> is @SteekTrap.TandOpleggingBovenzijde.Oplegging.GetOplegLengteNominmaal().ToString("0") mm. <br />
                                            De minimale tandlangte is <i>a + voeg</i> =
                                            @SteekTrap.TandOpleggingBovenzijde.Oplegging.OplegLengteNominaal.ToString("0") + @SteekTrap.TandOpleggingBovenzijde.VoegX.ToString()  =
                                            @SteekTrap.TandOpleggingBovenzijde.MinimaleTandLengte.ToString("0") mm.<br />
                                            De toegepaste tandlengte is @SteekTrap.TandOpleggingBovenzijde.TandLengte mm.

                                            <br />
                                            @if (SteekTrap.TandOpleggingBovenzijde.MinimaleTandLengte > SteekTrap.TandOpleggingBovenzijde.TandLengte)
                                            {
                                                <b style="color:red;">⚠️ Toegepaste tandlengte (@SteekTrap.TandOpleggingBovenzijde.TandLengte mm) te klein.</b>
                                                <FluentIcon Value="@GetIcon(!true)" Color="GetIconColor(!true)" Slot="end" />
                                                //OpleggingHeeftAandachtNodig = true;

                                            }
                                            else
                                            {
                                                <b style="color:darkgreen">✅ Tandlengte akkoord</b>
                                                <FluentIcon Value="@GetIcon(true)" Color="GetIconColor(true)" Slot="end" />
                                                //OpleggingHeeftAandachtNodig = false;

                                            }
                                        </div>
                                    </FluentCard>



                                    <EurocodeBetonOpleggingComponent ReadOnlyFields="ReadOnlyFields"
                                                                     @bind-Model="@SteekTrap.TandOpleggingBovenzijde.Oplegging"></EurocodeBetonOpleggingComponent>
                                    <FluentIcon Value="@GetIcon(SteekTrap.TandOpleggingBovenzijde.OplegLengteAkkoord)" Color="GetIconColor(SteekTrap.TandOpleggingBovenzijde.OplegLengteAkkoord)" Slot="end" />

                                }
                                else
                                {
                                    <div>Beton nok niet van toepassing.</div>
                                }
                            </FluentAccordionItem>

                            @if (SteekTrap.TandOpleggingBovenzijde != null)
                            {
                                <FluentAccordionItem Expanded="false" Heading="Oplegneus">
                                    @* <FluentIcon Value="@(new Icons.Regular.Size24.Check())" Color="@Color.Accent" Slot="start" /> *@

                                    @if (SteekTrap.TandOpleggingBovenzijde != null)
                                    {
                                        @foreach (var ec in SteekTrap.TandOpleggingBovenzijde.GetToetsen()
                                                                    .Where(t => t != null)
                                                                    .Where(t => t.Meldingen?.Any(m => m.Type == MeldingType.Waarschuwing) == true))
                                        {
                                            <EurocodeMeldingenComponent Meldingen="@ec.Meldingen"
                                                                        FilterTypes="MeldingType.Waarschuwing" />
                                        }

                                        <TrapNeusComponent @bind-Model="SteekTrap.TandOpleggingBovenzijde" />



                                        <FluentIcon Value="@GetIcon(TandBovenAkkoord)"
                                                    Color="GetIconColor(TandBovenAkkoord)"
                                                    Slot="end" />

                                    }


                                </FluentAccordionItem>
                            }


                        </FluentAccordion>

                    </Content>

                </FluentTab>

                <FluentTab Id="tab-Samenvatting" Label="Summary">
                    <Header>
                        <FluentIcon Value="@(new Icons.Regular.Size24.ReadingList())"></FluentIcon>Samenvatting
                    </Header>
                    <Content>
                        <SteektrapComponent @bind-Model="@SteekTrap" />
                    </Content>
                </FluentTab>

            </FluentTabs>

        </div>

        <div class="right-column">
            <div style="font-weight:600; font-size:1em; text-align:center;">
                @SteekTrap.Merk
            </div>
            <TrapSvgBAK @bind-Model=SteekTrap Style="width:auto; height:auto; border:solid 0px;" />

        </div>
    </div>

    <style>
        .two-column-container {
            display: grid;
            grid-template-columns: 1fr 600px;
