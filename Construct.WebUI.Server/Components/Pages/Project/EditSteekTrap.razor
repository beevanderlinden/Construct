    private bool TandBovenAkkoord
    {
        get
        {



            if (SteekTrap?.TandOpleggingBovenzijde == null)
                return true; // geen tand boven, dus akkoord


            if (SteekTrap.TandOpleggingBovenzijde.TotaleWapeningBenodigd > SteekTrap.TandOpleggingBovenzijde.WapeningAlgemeen.As)
            {
                return false;
            }


            return !SteekTrap.TandOpleggingBovenzijde
                .GetToetsen()
                .Any(ctx => ctx != null &&
            ctx.Meldingen?.Any(m => (m.Type & MeldingType.Waarschuwing) != 0) == true);
        }
    }



