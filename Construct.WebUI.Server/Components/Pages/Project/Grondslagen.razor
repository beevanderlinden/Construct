@using Microsoft.FluentUI.AspNetCore.Components


<KaskonInputContainer Label="norm" LabelPosition="@_labelPosition">
    <FluentSelectEnum Placeholder="Selecteer..."
                      TEnum="Eurocode.Grondslagen.NationaleBijlageEnum" Style="max-width:120mm"
                      ShowDescription="true" @bind-EnumSelectedValue="@Model.NationaleBijlage" />
</KaskonInputContainer>

@if (ShowReadOnlyFields)
{
    <KaskonInputContainer Label="<i>ξ</i>" LabelPosition="@_labelPosition">
        <FluentTextField Value="@Model.Xi.ToString("0.00")" Disabled="true" />
    </KaskonInputContainer>
}


<KaskonInputContainer Label="gevolgklasse" LabelPosition="@_labelPosition">
    <FluentSelectEnum Placeholder="Selecteer..."
                      TEnum="Eurocode.Grondslagen.GevolgklasseEnum" Style="max-width:120mm"
                      ShowDescription="false"
                      @bind-EnumSelectedValue="@Model.Gevolgklasse" />
</KaskonInputContainer>

@if (ShowReadOnlyFields)
{
    <KaskonInputContainer Label="betrouwbaarheidsklasse" LabelPosition="@_labelPosition">
        <FluentTextField Value="@Model.Betrouwbaarheidsklasse.ToString()" Disabled="true" />
    </KaskonInputContainer>

    <KaskonInputContainer Label="<i>K<sub>FI</sub></i>" LabelPosition="@_labelPosition">
        <FluentTextField Value="@Model.Kfi.ToString("0.0")" Disabled="true" />
    </KaskonInputContainer>
}


<KaskonInputContainer Label="ontwerplevensduur" LabelPosition="@_labelPosition">
    <FluentSelectEnum TEnum="Eurocode.Grondslagen.OntwerpLevensduurEnum" Style="max-width:120mm"
                      @bind-EnumSelectedValue="@Model.OntwerpLevensduur" />
</KaskonInputContainer>














@code {
    [Parameter]
    public Eurocode.Grondslagen.GrondslagenContext Model { get; set; } = new();

    [Parameter]
    public EventCallback<Eurocode.Grondslagen.GrondslagenContext> ModelChanged { get; set; }

    [Parameter] public bool ShowReadOnlyFields { get; set; } = true;

    private KaskonLabelPosition _labelPosition = KaskonLabelPosition.Top;


    async Task UpdateModel()
    {
        await ModelChanged.InvokeAsync(Model);
    }

       

}
