        table.Rows.Add([new() { Markdown = "kwaliteitsbeheersing?" }, new(d1.IsKwaliteitsBeheersing.ToEmoji("ja", "nee")), new(d2.IsKwaliteitsBeheersing.ToEmoji("ja", "nee"))]);

        table.Rows.Add([new() { Markdown = "korrelafmeting" }, new(d1.GrootsteKorrelDiameterUserFriendlyName), new(d2.GrootsteKorrelDiameterUserFriendlyName)]);


