    private void UpdateCoverPage()
    {
        if (ProjectState?.CurrentProject is not ProjectEntity proj)
        {
            return;
        }


        if (proj.Documenten == null || !proj.Documenten.Any())
        {
            Console.WriteLine("Geen documenten gevonden in project.");
            return;
        }

        var myDocument = ProjectState?.CurrentProject?.Documenten.FirstOrDefault();
        if (myDocument == null)
        {
            Console.WriteLine("Geen document gevonden in project.");
            return;
        }



        cover.Author = myDocument.Author;
        cover.Title = myDocument.Title;
        cover.Subtitle = myDocument.Subtitle;
        //cover.CheckedBy = myDocument.CheckedBy;

        cover.RevisionContent.Revisions = myDocument.Revisions.ToList();

        //Projectlabels zijn FIXED
        if (myDocument.ProjectLabels != null && myDocument.ProjectLabels.Count >= 2)
        {
            myDocument.ProjectLabels[0].StringValue = ProjectState?.CurrentProject?.ProjectInfo?.Nummer ?? "NULL";
            myDocument.ProjectLabels[1].StringValue = ProjectState?.CurrentProject?.ProjectInfo?.Naam ?? "NULL";
        }
        var lblDocNr = myDocument.DocumentLabels.FirstOrDefault(l => l.Label.Equals("documentnummer"));
        if (lblDocNr != null)
        {
            lblDocNr.StringValue = myDocument.DocumentNumber;
        }
        else
        {
            myDocument.DocumentLabels.Add(new CommonLibrary.Models.LabelWithStringValue("documentnummer", myDocument.DocumentNumber));
        }


        cover.ProjectLabels = myDocument.ProjectLabels ?? [];
        cover.DocumentLabels = myDocument.DocumentLabels ?? [];


        // afbeeldingen
        cover.CompanyLogoPath = Path.Combine(WebHostEnvironment.WebRootPath, "images", "logos", "kaskon.nl.jpg");

    }

    private async Task GenerateDocuments()
    {
        Log.StartBusy("Verzamel document gegevens");

        // set cover
        UpdateCoverPage();

        // maak documenten
        isLoading = true;
        SvgImageCache cache = new();
        this.content = await GenerateDocumentContent();

        Log.WriteLine("Genereer Migradoc.document");
        this.document = GetDocument(content, cache);
        if (document == null) return;

        Log.WriteLine("Genereer Html");
        this.Html = ExportFactory.Services.HtmlCreator.GenerateHtmlFromDocument(document);
        isLoading = false;
        cache.Cleanup();

        await Task.Delay(20);
        Log.StopBusy("Document gereed");
    }

