    /// <summary>
    /// Formatteert een waarde met wetenschappelijke notatie in markdown formaat
    /// </summary>
    /// <param name="value">De waarde om te formatteren</param>
    /// <param name="powerOf10">De macht van 10 (bijv. 3 voor ×10³, -6 voor ×10⁻⁶)</param>
    /// <param name="unit">De eenheid (bijv. "mm³" of "mm^3^")</param>
    /// <param name="format">Het format voor de waarde (default "0.#")</param>
    /// <returns>Geformatteerde string zoals "123.5 ×10^3^ mm^3^"</returns>
    private string FormatWithPower(double value, int powerOf10, string unit, string format = "0.#")
    {
        // Pas de waarde aan met de macht van 10
        double adjustedValue = value * Math.Pow(10, -powerOf10);

        // Formatteer de waarde
        string formattedValue = adjustedValue.ToString(format);

        // Als powerOf10 = 0, geen wetenschappelijke notatie
        if (powerOf10 == 0)
            return $"{formattedValue} {unit}";

        // Zorg dat unit al markdown heeft (^)
        string formattedUnit = unit.Contains("^") ? unit : unit;

        // Return met wetenschappelijke notatie
        return $"{formattedValue} ·10^{powerOf10}^ {formattedUnit}";
    }

