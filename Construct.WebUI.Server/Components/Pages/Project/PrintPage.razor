    private async Task DownloadAsync()
    {
        isLoading = true;
        try
        {
            if (binaryContent != null)
            {
                await FileDownloadService.DownloadAsync(fileName, contentType, binaryContent);
            }
            else if (!string.IsNullOrEmpty(stringContent))
            {
                await FileDownloadService.DownloadStringAsync(fileName, contentType, stringContent);
            }
            else
            {
                Console.Error.WriteLine("Geen content opgegeven voor download.");
            }
        }
        finally
        {
            isLoading = false;
        }
    }




    private async Task DownloadRtfAsync()
    {
        isLoading = true;

        this.content = await GenerateDocumentContent();



        SvgImageCache cache = new SvgImageCache();


        this.document = GetDocument(content, cache, false, true);

        if (document == null)  
            return;


        stringContent = ExportFactory.Services.MigraDocCreator.ExportToRtfString(document);
        fileName = "MijnRapport.rtf";
        binaryContent = null; 

        await DownloadAsync();

        isLoading = false;
        cache.Cleanup();


        await Task.CompletedTask;
    }

    private async Task DownloadPdfAsync()
    {
        isLoading = true;
        content = await GenerateDocumentContent();
        SvgImageCache cache = new();
        document = GetDocument(content, cache);

        if (document == null) return;
        binaryContent = ExportFactory.Services.MigraDocCreator.ExportToPdfBytes(document);
        fileName = "MijnRapport.pdf";

        await DownloadAsync();
        isLoading = false;
        cache?.Cleanup();
        await Task.CompletedTask;
    }

    private async Task TestMarkdownDocumentAsync()
    {
        isLoading = true;
        try
        {
            var mdFilePath = Path.Combine(WebHostEnvironment.ContentRootPath, "Documentation", "PrintPage-Refactoring-Analysis.md");

            if (!System.IO.File.Exists(mdFilePath))
            {
                ToastService.ShowError($"MD bestand niet gevonden: {mdFilePath}");
                return;
            }

            var markdownContent = await File.ReadAllTextAsync(mdFilePath);

            // Maak een test document met alleen het markdown bestand
            DocumentContent testContent = new()
            {
                PageMarginSetting = DocumentContent.PageMarginAndPageNumberSettingsEnum.Gecentreerd,
                Font = new("roboto", "3mm"),
                DocumentInfo = new MigraDoc.DocumentObjectModel.DocumentInfo()
                {
                    Author = "Test",
                    Title = "Markdown Test",
                    Subject = "Test van MD parsing"
                }
            };

            var section = new SectionContent();
            section.Elements.Add(new HeadingContent("Markdown Document Test", 1));

            // split
            var parts = Regex.Split(
                markdownContent,
                @"(?<=^#+.*$)|\r?\n\s*\r?\n",
                RegexOptions.Multiline
            )
            .Where(p => !string.IsNullOrWhiteSpace(p))
            .ToList();

            foreach (var part in parts)
            {
                section.Elements.Add(new ParagraphContent(part));
            }
            //section.Elements.Add(new ParagraphContent(markdownContent));
            testContent.Sections.Add(section);

            // Genereer HTML
            SvgImageCache cache = new();
            this.document = GetDocument(testContent, cache);

            if (document == null)
            {
                ToastService.ShowError("Document generatie mislukt");
                return;
            }

            this.Html = ExportFactory.Services.HtmlCreator.GenerateHtmlFromDocument(document);


            ToastService.ShowSuccess($"MD document geladen en geconverteerd naar HTML ({markdownContent.Length} chars)");




            stringContent = ExportFactory.Services.MigraDocCreator.ExportToRtfString(document);
            fileName = "TestMarkdown.rtf";
            binaryContent = null;

            await DownloadAsync();

            isLoading = false;
            cache.Cleanup();


            await Task.CompletedTask;


        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Fout bij laden MD: {ex.Message}");
            Log.WriteLine($"Error: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }

