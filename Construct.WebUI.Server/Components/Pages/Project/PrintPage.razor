    private MigraDoc.DocumentObjectModel.Document GetDocument(DocumentContent content, SvgImageCache cache, bool createToc = false, bool isRtfContent = false)
    {
        MigraDoc.DocumentObjectModel.Document document = new();
        try
        {
            document = ExportFactory.Services.MigraDocCreator.GenerateDocument(content, cache, createToc, isRtfContent);
            return document;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            ToastService.ShowError("MigraDoc.Document generatie mislukt: " + ex.Message);

            if (ex.InnerException != null)
            {
                Console.WriteLine(ex.InnerException.Message);
                ToastService.ShowError("InnerException: " + ex.InnerException.Message);
            }

            return document;
        }
    }   



