    public bool ValidateProject(DocumentContent content)
    {
        if (content == null)
        {
            Console.WriteLine("Geen content");
            return false;
        }

        if (ProjectState?.CurrentProject is not ProjectEntity proj)
        {
            return false;
        }


        if (proj.ProjectInfo == null)
        {
            Console.WriteLine("Geen project info gevonden");
            return false;
        }

        if (content.DocumentInfo == null)
        {
            content.DocumentInfo = new();
        }

        return true;
    }







    private async Task<DocumentContent> GenerateDocumentContent(bool createToc = !true)
    {
        PageNr = 0;
        if (ProjectState?.CurrentProject != null)
        {
            var proj = ProjectState.CurrentProject;

            document = new();
            DocumentContent content = new(); // maak een nieuwe context. (migradoc heeft boomstructuur en kan niet met gewijzigde content omgaan, alleen clones of nieuwe content)
            content.PageMarginSetting = DocumentContent.PageMarginAndPageNumberSettingsEnum.Gecentreerd; // marge links werkt niet goed in RTF, dus even zo.
            content.CoverPage = cover;
            content.Font = new("roboto", "3mm");

            // Mapping voor voorblad
            UpdateCoverPage(); PageNr++;

            if (!ValidateProject(content)) 
                return content;


            string toastMessage = "Document genereren...";
            Stopwatch stopWatch = new();
            stopWatch.Start();

            PrepareDocument(content);
            SetCoverPage(content);

            SectionContent section = new();
            ParagraphContent par = new();
            TableContent table = new();





            SetUitgangspunten(content, proj.ProjectInfo.Grondslagen, proj.Assemblages);

            foreach (AssemblageEntity a in proj.Assemblages.OrderBy(a=>a.Merk))
            {
                // haal zoveel mogelijk uit de base
                if (a != null)
                {
                    a.Bijwerken();

                    section = new SectionContent();
                    string title = $"<span class='titel'>{a.Merk}</span> <span class='subtitel'>{a.Naam}</span>";
                    section.Elements.Add(new HeadingContent(title, 1));
                    section.Elements.Add(new HeadingContent(GetHeaderHtml(content.PageHeader, PageNr++), 3));

                    a.Belastingen.BelastingGevallen.AddToSection(section, isDraaiTabel: !true, "Belastinggevallen", "Kop 3");
                    a.Belastingen.BelastingCombinaties.AddToSection(section, isDraaiTabel: !true, "Belastingcombinaties", "Kop 3");


                    section.AddParagraph("Materialen", "Kop 3");
                    var materialen = new List<BaseMateriaal>() { a.Materiaal };
                    section.Elements.Add(GetTableContentMaterialen(materialen));



                    if (a.AssemblageType == AssemblageEntity.AssemblageTypeEnum.BetonAssemblage)
                    {
                        // dekking en duurzaamheid
                        section.AddParagraph("Dekking en duurzaamheid", "Kop 3");

                        // ✅ Cast naar BetonAssemblageEntity om PlaatDekking te kunnen gebruiken
                        if (a is BetonAssemblageEntity betonAssemblage)
                        {
                            section.Elements.Add(GetTableContentDekkingOpt(betonAssemblage.PlaatDekking));
                        }
                    }

                    // als het een ligger is dan specifieke ligger data
                    if (a is LiggerEntity ligger)
                    {
                        section.AddParagraph("Profielen", "Kop 3");
                        var profielen = new List<BaseProfiel>() { ligger.Profiel };
                        section.Elements.Add(GetTableContentProfielen(profielen));

                        par = new ParagraphContent();
                        Construct.Domain.Entities.BoundingBox boundingBox = new();

                        var svgWidth = 180.0;
                        var svgWidthPixels = svgWidth * 96.0 / 25.4;
                        var maxHeightPx = 100.0 * 96.0 / 25.4;
                        string svgStyle = $"position:relative; display:block; margin-left:auto; margin-right:auto; width: {svgWidthPixels:0}; height: auto; max-height: {maxHeightPx:0}";

                        //string xml = SvgGenerator.GenerateBordesSvgXml(bordes, boundingBox, svgWidthPixels, 9999, svgStyle);
                        //par.Markdown = xml;
                        //section.Elements.Add(par);

                        svgStyle = $"position:relative; display:block; margin-left:auto; margin-right:auto; width: {svgWidthPixels:0}; height: 30mm;";

                        var svgDocs = ligger.Beam.ToSvgDocumentsOpt((int)svgWidthPixels, 9999, svgStyle, ligger.Beam.LoadContext?.BelastingGevallen, [(Eurocode.Belastingen.BelastingCombinatieTypeEnum.Fundamenteel_A | Eurocode.Belastingen.BelastingCombinatieTypeEnum.Fundamenteel_B)], []);

                        foreach (var svgDoc in svgDocs)
                        {
                            svgDoc.AddToSection(section, ligger.Beam);
                        }

                        content.Sections.Add(section);

                        var sl2 = new SectionContent()
                        {

                        };

                        sl2.AddParagraph($"{a.Merk} (vervolg)", "Kop 1");
                        sl2.Elements.Add(new HeadingContent(GetHeaderHtml(content.PageHeader, PageNr++), 3));



                        // stel het is een stalen
                        if (ligger.Materiaal is StaalContext staal || 
                            ligger.Materiaal is HoutContext hout)
                        {
                            sl2.AddParagraph($"Profiel {ligger.Profiel.Naam} [mm]", "Kop 3");
                            var tblProfiel = GetTableProfiel(ligger.Profiel);
                            sl2.Elements.Add(tblProfiel);


                            sl2.AddParagraph("Snedekrachten", "Kop 3");
                            var tblSnedekrachten = BeamResultsHelper.GetTabelSnedeKrachten(ligger.Beam);
                            sl2.Elements.Add(tblSnedekrachten);


                            sl2.AddParagraph("Snede-toetsen", "Kop 3");
                            var staalSnedeToetsen = BeamResultsHelper.GetTabelSnedeToetsen(
                                ligger.Beam, 
                                ligger.Profiel, 
                                ligger.Materiaal,
                                sectionClass: 1
                            );
                            sl2.Elements.Add(staalSnedeToetsen);
                        }

                        content.Sections.Add(sl2);

                    }



                    if (a is SteekTrapEntity tr)
                    {
                        // geometrie en belasting
                        section.AddParagraph("Geometrie", "Kop 3");
                        section.Elements.Add(GetTableGeometrie(tr));
                    }

                }


                if (a is BordesEntity bordes)
                {
                    //section = new SectionContent();
                    par = new ParagraphContent();
                    Construct.Domain.Entities.BoundingBox boundingBox = new();

                    var svgWidth = 180.0;
                    var svgWidthPixels = svgWidth * 96.0 / 25.4;
                    var maxHeightPx = 100.0 * 96.0 / 25.4;
                    string svgStyle = $"position:relative; display:block; margin-left:auto; margin-right:auto; width: {svgWidthPixels:0}; height: auto; max-height: {maxHeightPx:0}";

                    string xml = SvgGenerator.GenerateBordesSvgXml(bordes, boundingBox, svgWidthPixels, 9999, svgStyle);
                    par.Markdown = xml;
                    section.Elements.Add(par);

                    svgStyle = $"position:relative; display:block; margin-left:auto; margin-right:auto; width: {svgWidthPixels:0}; height: 30mm;";

                    foreach (var strook in bordes.Stroken)
                    {
                        boundingBox.Reset();

                        string title = $"<span class='titel'>{a.Merk} (vervolg)</span> <span class='subtitel'>{strook.Naam}</span>";
                        section.AddHeading(title, "Kop 1");
                        section.Elements.Add(new HeadingContent(GetHeaderHtml(content.PageHeader, PageNr++), 3));
                        section.AddParagraph(strook.Naam.ToUpperInvariant(), "Kop 3");


                        var svgDocs = strook.Beam.ToSvgDocumentsOpt((int)svgWidthPixels, 9999, svgStyle, a.Belastingen.BelastingGevallen, [(Eurocode.Belastingen.BelastingCombinatieTypeEnum.Fundamenteel_A | Eurocode.Belastingen.BelastingCombinatieTypeEnum.Fundamenteel_B)], []);

                        foreach (var svgDoc in svgDocs)
                        {
                            svgDoc.AddToSection(section, strook.Beam);
                        }

                        section.Elements.Add(new ParagraphContent("Dwarskrachtwapening", "Kop 3"));
                        bool dwarskrachtWapeningBenodigd = false;


                        foreach (var vk in strook.DwarskrachtCollectie)
                        {
                            if (vk.IsDwarskrachtWapeningBenodigd())
                                dwarskrachtWapeningBenodigd = true;
                        }

                        var vResult = strook.DwarskrachtCollectie.OrderByDescending(r => r.Ved).FirstOrDefault();
                        if (dwarskrachtWapeningBenodigd)
                        {
                            if (vResult != null)
                            {
                                par = new($"⚠️ Let op *V~Ed~* ({vResult?.Ved:0.#} kN) is groter dan *V~Rd,c~* ({vResult?.DwarskrachtWeerstand:0.#} kN), dwarskrachtwapening benodigd: *A~sw,req~* = {vResult?.AswBerekend:0} mm²/m¹ ");
                                var benodigdeBreedte = vResult?.Ved / vResult?.DwarskrachtWeerstandBeton * strook.Profiel.BreedteDwarskracht * 1.1; // 110% voor

                                if (benodigdeBreedte <= 500)
                                {
                                    par.Markdown += $"\r\n💡 Advies: Pas de strookbreedte aan (benodigd is circa {benodigdeBreedte:0} mm)";
                                    //strook.BetonV.AddToSection(section);
                                }
                                else
                                {
                                    par.Markdown += $"\r\n💡 Advies: Pas de plaatdikte aan.";

                                }

                            }


                        }
                        else
                        {
                            par = new($"✅ *V~Ed~* ({vResult?.Ved:0.#} kN) is kleiner dan *V~Rd,c~* ({vResult?.DwarskrachtWeerstandBeton:0.#} kN), **geen dwarskrachtwapening nodig**");
                        }
                        section.Elements.Add(par);


                        if (strook.BendingResults.Count > 0)
                        {
                            strook.BendingResults.AddToSection(section, isDraaiTabel: false, title: null, style: "Kop 3");
                        }
                        if (strook.ScheurwijdteCollectie.Count > 0)
                        {
                            strook.ScheurwijdteCollectie.AddToSection(section, isDraaiTabel: false, title: null, style: "Kop 3");
                        }

                    }


                    if (bordes.Tand != null)
                    {

                        var tand = bordes.Tand;

                        // de diameter is gelijk aan de verdeelwapening, we berekenen de hohmaat (maximaal 150mm)
                        bordes.Tand.WapeningAlgemeen.Tekst = $"Ø{bordes.DetailWapeningDiameter:0.#}-{bordes.DetailWapeningHoh}";


                        tand.Bijwerken();
                        tand.BuigingHals.BerekenEnValideer();
                        tand.BuigingTand.BerekenEnValideer();


                        string titleTand = $"<span class='titel'>{a.Merk} (vervolg)</span>";
                        section.AddHeading(titleTand, "Kop 1");
                        section.Elements.Add(new HeadingContent(GetHeaderHtml(content.PageHeader, PageNr++), 3));
                        section.AddHeading("Trapoplegging tand", "Kop 3");

                        // Bereken maximale fundamentele waarde voor Trap1
                        var t1 = bordes.Trap1;
                        var t2 = bordes.Trap2;
                        double maxTrap1 = bordes.BerekenMaximaleFundamenteleWaarde(t1.Reacties.G, t1.Reacties.Q, bordes.Belastingen.BelastingCombinaties);
                        double maxTrap2 = bordes.BerekenMaximaleFundamenteleWaarde(t1.Reacties.G, t1.Reacties.Q, bordes.Belastingen.BelastingCombinaties);

                        var maatgevend = maxTrap1 > maxTrap2 ? t1 : t2;
                        section.AddParagraph("Berekening en wapening is **per strekkende meter**");
                        section.AddParagraph($"Reactie uit trap : *R<sub>Gk</sub>* = {maatgevend.Reacties.G:0.#} kN en *R<sub>Qk</sub>* = {maatgevend.Reacties.Q:0.#} kN zodat *R<sub>Ed</sub>* = {Math.Max(maxTrap1, maxTrap2):0.#} kN");
                        section.AddParagraph($"Ophangkracht : *F<sub>ophang,Ed</sub>* = {tand.OphangKracht:0.#} kN (factor voor ophangkracht = {tand.FactorOphangKracht:0.#}), *A~s,req,ophang~* = {tand.OphangWapeningHalsBenodigd:0} mm²");



                        // Tand
                        section.AddParagraph("Momentwapening tand", "Kop 4");
                        section.AddParagraph($"- afmetingen : *b* = {tand.ProfielTand.B:0} mm | *h* = {tand.ProfielTand.H:0} mm | *L~tand~* = {tand.TandLengte:0} mm | *a~b~* = {tand.LengteOplegmateriaal:0} mm | *l* = {tand.ArmVoorTand:0} mm | *l~ov~* = {tand.OverspanningVoorTand:0} mm | *a* = {tand.BuigingTand.LengteMaatBijGedrongenLiggerInMM} mm | *z* = {tand.BuigingTand.Z:0.#} mm");
                        section.AddParagraph($"- krachten :  *F~Ed~* = {tand.OplegReactie:0.0 kN} | *H~Ed~* = {tand.ReactieHorizontaal:0.0 kN} ({tand.PercentageHorizontaleBelasting:0%} van oplegreactie) | *M~Ed~* = { tand.MomentVoorTand:0.0 kNm}");
                        section.AddParagraph($"- wapening : *A~s,req~* = {tand.BuigingTand.AsRequired:0} mm² | *A~s,prov~* = {tand.BuigingTand.AsApplied:0} mm²");

                        tand.BuigingTand.AddToSection(section, false);

                        // Dwarskracht
                        // de V~Ed,red~ moet onder V~Rd,c~ blijven (uitgangspunt is geen beugels)
                        // 
                        section.AddParagraph($"Dwarskracht tand", "Kop 4");
                        if (Math.Abs(tand.DwarskrachtTand.Ved) > tand.DwarskrachtTand.DwarskrachtWeerstandBeton)
                        {
                            section.Elements.Add(tand.DwarskrachtTand.ToMigraDocTable());

                            section.AddParagraph("**Let op! dwarskrachtwapening nodig in tand, niet akkoord**");
                            section.AddParagraph($"A~sw,ben~ = {tand.DwarskrachtTand.AswBenPerMeter:0} mm²/m¹");

                            foreach (var melding in tand.DwarskrachtTand.Meldingen)
                            {
                                section.AddParagraph(melding.ToMarkupString().Value);
                                section.AddParagraph(melding.ToString());
                            }
                        }
                        else
                        {
                            section.AddParagraph($"Dwarskracht *V~Ed~* = {Math.Abs(tand.DwarskrachtTand.Ved):0.0 kN} is kleiner dan *V~Rd,c~* ({tand.DwarskrachtTand.DwarskrachtWeerstandBeton:0.0 kN}), geen dwarskrachtwapening nodig.");
