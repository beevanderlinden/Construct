@using System.Collections.Generic
@using CommonLibrary.Models
@using Eurocode.HoutConstructies
@using Eurocode.StaalConstructies
@inject IToastService ToastService
@inject IDialogService DialogService


<FluentCard AreaRestricted="false">
    <h1>Project materialen</h1>
    <div class="table-wrap">
        
        <table class="ec-table col-head">
            <thead>
                <tr>
                    <th>type</th>
                    <th>kwaliteit</th>
                    <th>E-modulus</th>
                    <th>s.g.</th>
                    <th>aantal</th>
                    <th>acties</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var materiaal in Project.Materialen.Values.OfType<BaseMateriaal>())
                {
                    <tr>
                        <td>
                            @materiaal.Type.ToString()
                        </td>
                        <td>
                            @if (materiaal is StaalContext staalContext)
                            {
                                <select @onchange="@((ChangeEventArgs e) => UpdateStaalKwaliteit(staalContext, (string)e.Value!))" class="form-select form-control">
                                    <option value="S235" selected="@(staalContext.StaalKwaliteit == StaalKwaliteitEnum.S235)">S235</option>
                                    <option value="S275" selected="@(staalContext.StaalKwaliteit == StaalKwaliteitEnum.S275)">S275</option>
                                    <option value="S355" selected="@(staalContext.StaalKwaliteit == StaalKwaliteitEnum.S355)">S355</option>
                                    <option value="S450" selected="@(staalContext.StaalKwaliteit == StaalKwaliteitEnum.S450)">S450</option>
                                </select>
                            }
                            else if (materiaal is HoutContext houtContext)
                            {
                                <select @onchange="@((ChangeEventArgs e) => UpdateHoutKwaliteit(houtContext, (string)e.Value!))" class="form-select form-control">
                                    <option value="C18" selected="@(houtContext.Kwaliteit == Houtkwaliteit.C18)">C18</option>
                                    <option value="C24" selected="@(houtContext.Kwaliteit == Houtkwaliteit.C24)">C24</option>
                                    <option value="C30" selected="@(houtContext.Kwaliteit == Houtkwaliteit.C30)">C30</option>
                                    <option value="C40" selected="@(houtContext.Kwaliteit == Houtkwaliteit.C40)">C40</option>
                                    <option value="C50" selected="@(houtContext.Kwaliteit == Houtkwaliteit.C50)">C50</option>
                                    <option value="D30" selected="@(houtContext.Kwaliteit == Houtkwaliteit.D30)">D30</option>
                                    <option value="D40" selected="@(houtContext.Kwaliteit == Houtkwaliteit.D40)">D40</option>
                                    <option value="D50" selected="@(houtContext.Kwaliteit == Houtkwaliteit.D50)">D50</option>
                                    <option value="D60" selected="@(houtContext.Kwaliteit == Houtkwaliteit.D60)">D60</option>
                                    <option value="D70" selected="@(houtContext.Kwaliteit == Houtkwaliteit.D70)">D70</option>
                                </select>
                            }
                            else if (materiaal is BetonContext betonContext)
                            {
                                <select @onchange="@((ChangeEventArgs e) => UpdateBetonKlasse(betonContext, (string)e.Value!))" class="form-select form-control">
                                    <option value="C12_15" selected="@(betonContext.Betonsterkteklasse == BetonsterkteklasseEnum.C12_15)">C12/15</option>
                                    <option value="C16_20" selected="@(betonContext.Betonsterkteklasse == BetonsterkteklasseEnum.C16_20)">C16/20</option>
                                    <option value="C20_25" selected="@(betonContext.Betonsterkteklasse == BetonsterkteklasseEnum.C20_25)">C20/25</option>
                                    <option value="C25_30" selected="@(betonContext.Betonsterkteklasse == BetonsterkteklasseEnum.C25_30)">C25/30</option>
                                    <option value="C30_37" selected="@(betonContext.Betonsterkteklasse == BetonsterkteklasseEnum.C30_37)">C30/37</option>
                                    <option value="C35_45" selected="@(betonContext.Betonsterkteklasse == BetonsterkteklasseEnum.C35_45)">C35/45</option>
                                    <option value="C40_50" selected="@(betonContext.Betonsterkteklasse == BetonsterkteklasseEnum.C40_50)">C40/50</option>
                                    <option value="C45_55" selected="@(betonContext.Betonsterkteklasse == BetonsterkteklasseEnum.C45_55)">C45/55</option>
                                    <option value="C50_60" selected="@(betonContext.Betonsterkteklasse == BetonsterkteklasseEnum.C50_60)">C50/60</option>
                                    <option value="C60_75" selected="@(betonContext.Betonsterkteklasse == BetonsterkteklasseEnum.C60_75)">C60/75</option>
                                    <option value="C80_95" selected="@(betonContext.Betonsterkteklasse == BetonsterkteklasseEnum.C80_95)">C80/95</option>
                                    <option value="C90_105" selected="@(betonContext.Betonsterkteklasse == BetonsterkteklasseEnum.C90_105)">C90/105</option>


                                </select>
                            }
                            else
                            {
                                @materiaal.Naam
                            }
                        </td>
                        <td>
                            @materiaal.E.ToString("0")
                        </td>
                        <td>
                            @materiaal.SoortelijkGewicht.ToString("0 kg/m³")
                        </td>
                        <td>
                            @{
                                var assemblagesVanDitMateriaal = Project.Assemblages.Where(a => a.Materiaal?.Id == materiaal.Id).ToList();
                                var aantal = assemblagesVanDitMateriaal.Count();
                                var merkArray = assemblagesVanDitMateriaal.Select(a => a.Merk);
                                var merken = string.Join(", ", merkArray);


                            }
                            @aantal st.  (@merken)
                            



                        </td>

                        <td>
                            <button class="btn"
                                    @onclick="() => VerwijderMateriaal(materiaal.Id)">
                                ✖️
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>


    </div>
</FluentCard>

<FluentButton id="btnAddMaterial" 
              IconStart="@(new Icons.Regular.Size24.AddSquare())"
              Appearance="Appearance.Accent" 
              OnClick="@(() => openAddMenu = !openAddMenu)">
    Materiaal toevoegen
</FluentButton>

<FluentMenu @bind-Open="@openAddMenu" Width="250px">
    <FluentMenuItem OnClick="@VoegBetonToe">
        <span slot="start">
            <FluentIcon Value="@(new Icons.Regular.Size20.Cube())" Color="Color.Neutral" />
        </span>
        Beton
    </FluentMenuItem>
    <FluentMenuItem OnClick="@VoegStaalToe">
        <span slot="start">
            <FluentIcon Value="@(new Icons.Regular.Size20.BuildingFactory())" Color="Color.Neutral" />
        </span>
        Staal
    </FluentMenuItem>
    <FluentMenuItem OnClick="@VoegHoutToe">
        <span slot="start">
            <FluentIcon Value="@(new Icons.Regular.Size20.LeafThree())" Color="Color.Neutral" />
        </span>
        Hout
    </FluentMenuItem>
</FluentMenu>

@code{

    [Parameter, EditorRequired] public ProjectEntity Project { get; set; } = default!;

    private bool openAddMenu = false;

    private void VoegStaalToe()
    {
        var kwaliteit = BepaalNieuweStaalKwaliteit();
        Project.VoegMateriaalToe(new StaalContext()
        {
            StaalKwaliteit = kwaliteit
        });
        openAddMenu = false;
        ToastService.ShowSuccess($"Staal {kwaliteit} toegevoegd");
        StateHasChanged();
    }

    private void VoegHoutToe()
    {
        var kwaliteit = BepaalNieuweHoutKwaliteit();
        Project.VoegMateriaalToe(new HoutContext()
        {
            Kwaliteit = kwaliteit
        });
        openAddMenu = false;
        ToastService.ShowSuccess($"Hout {kwaliteit} toegevoegd");
        StateHasChanged();
    }

    private void VoegBetonToe()
    {
        var kwaliteit = BepaalNieuweBetonKwaliteit();
        Project.VoegMateriaalToe(new BetonContext()
        {
            Betonsterkteklasse = kwaliteit
        });
        openAddMenu = false;
        ToastService.ShowSuccess($"Beton {kwaliteit} toegevoegd");
        StateHasChanged();
    }

    // ✅ Bepaal de volgende hogere staal kwaliteit die nog niet in project zit
    private StaalKwaliteitEnum BepaalNieuweStaalKwaliteit()
    {
        var bestaandeKwaliteiten = Project.Materialen.Values
            .OfType<StaalContext>()
            .Select(s => s.StaalKwaliteit)
            .ToHashSet();

        // Alle mogelijke kwaliteiten van laag naar hoog
        StaalKwaliteitEnum[] alleKwaliteiten = [
            StaalKwaliteitEnum.S235,
            StaalKwaliteitEnum.S275,
            StaalKwaliteitEnum.S355,
            StaalKwaliteitEnum.S450
        ];

        // Vind hoogste bestaande kwaliteit
        StaalKwaliteitEnum? hoogste = null;
        foreach (var k in alleKwaliteiten.Reverse())
        {
            if (bestaandeKwaliteiten.Contains(k))
            {
                hoogste = k;
                break;
            }
        }

        // Als er nog geen staal is, neem de laagste
        if (hoogste == null)
            return StaalKwaliteitEnum.S235;

        // Zoek de eerstvolgende hogere kwaliteit
        bool gepasseerd = false;
        foreach (var k in alleKwaliteiten)
        {
            if (gepasseerd && !bestaandeKwaliteiten.Contains(k))
                return k;
            
            if (k == hoogste.Value)
                gepasseerd = true;
        }

        // Geen hogere kwaliteit meer beschikbaar, neem de hoogste
        return alleKwaliteiten[^1];
    }

    // ✅ Bepaal de volgende hogere hout kwaliteit die nog niet in project zit
    private Houtkwaliteit BepaalNieuweHoutKwaliteit()
    {
        var bestaandeKwaliteiten = Project.Materialen.Values
            .OfType<HoutContext>()
            .Select(h => h.Kwaliteit)
            .ToHashSet();

        // Alle mogelijke kwaliteiten van laag naar hoog
        Houtkwaliteit[] alleKwaliteiten = [
            Houtkwaliteit.C18,
            Houtkwaliteit.C24,
            Houtkwaliteit.C30,
            Houtkwaliteit.C40,
            Houtkwaliteit.C50,
            Houtkwaliteit.D30,
            Houtkwaliteit.D40,
            Houtkwaliteit.D50,
            Houtkwaliteit.D60,
            Houtkwaliteit.D70
        ];

        // Vind hoogste bestaande kwaliteit
        Houtkwaliteit? hoogste = null;
        foreach (var k in alleKwaliteiten.Reverse())
        {
            if (bestaandeKwaliteiten.Contains(k))
            {
                hoogste = k;
                break;
            }
        }

        // Als er nog geen hout is, neem C24
        if (hoogste == null)
            return Houtkwaliteit.C24;

        // Zoek de eerstvolgende hogere kwaliteit
        bool gepasseerd = false;
        foreach (var k in alleKwaliteiten)
        {
            if (gepasseerd && !bestaandeKwaliteiten.Contains(k))
                return k;
            
            if (k == hoogste.Value)
                gepasseerd = true;
        }

        // Geen hogere kwaliteit meer beschikbaar, neem de hoogste
        return alleKwaliteiten[^1];
    }

    // ✅ Bepaal de volgende hogere beton kwaliteit die nog niet in project zit
    private BetonsterkteklasseEnum BepaalNieuweBetonKwaliteit()
    {
        var bestaandeKwaliteiten = Project.Materialen.Values
            .OfType<BetonContext>()
            .Select(b => b.Betonsterkteklasse)
            .ToHashSet();

        // Alle mogelijke kwaliteiten van laag naar hoog
        BetonsterkteklasseEnum[] alleKwaliteiten = [
            BetonsterkteklasseEnum.C12_15,
            BetonsterkteklasseEnum.C16_20,
            BetonsterkteklasseEnum.C20_25,
            BetonsterkteklasseEnum.C25_30,
            BetonsterkteklasseEnum.C30_37,
            BetonsterkteklasseEnum.C35_45,
            BetonsterkteklasseEnum.C40_50,
            BetonsterkteklasseEnum.C45_55,
            BetonsterkteklasseEnum.C50_60,
            BetonsterkteklasseEnum.C60_75,
            BetonsterkteklasseEnum.C80_95,
            BetonsterkteklasseEnum.C90_105
        ];

        // Vind hoogste bestaande kwaliteit
        BetonsterkteklasseEnum? hoogste = null;
        foreach (var k in alleKwaliteiten.Reverse())
        {
            if (bestaandeKwaliteiten.Contains(k))
            {
                hoogste = k;
                break;
            }
        }

        // Als er nog geen beton is, neem C20/25
        if (hoogste == null)
            return BetonsterkteklasseEnum.C20_25;

        // Zoek de eerstvolgende hogere kwaliteit
        bool gepasseerd = false;
        foreach (var k in alleKwaliteiten)
        {
            if (gepasseerd && !bestaandeKwaliteiten.Contains(k))
                return k;
            
            if (k == hoogste.Value)
                gepasseerd = true;
        }

        // Geen hogere kwaliteit meer beschikbaar, neem de hoogste
        return alleKwaliteiten[^1];
    }

    private void UpdateStaalKwaliteit(StaalContext staalContext, string kwaliteit)
    {
        if (Enum.TryParse<StaalKwaliteitEnum>(kwaliteit, out var staalKwaliteit))
        {
            staalContext.StaalKwaliteit = staalKwaliteit;
            StateHasChanged();
            ToastService.ShowSuccess($"Staalkwaliteit bijgewerkt naar {kwaliteit}");
        }
    }

    private void UpdateHoutKwaliteit(HoutContext houtContext, string kwaliteit)
    {
        if (Enum.TryParse<Houtkwaliteit>(kwaliteit, out var houtKwaliteit))
        {
            houtContext.Kwaliteit = houtKwaliteit;
            StateHasChanged();
            ToastService.ShowSuccess($"Houtkwaliteit bijgewerkt naar {kwaliteit}");
        }
    }

    private void UpdateBetonKlasse(BetonContext betonContext, string klasse)
    {
        if (Enum.TryParse<BetonsterkteklasseEnum>(klasse, out var betonKlasse))
        {
            betonContext.Betonsterkteklasse = betonKlasse;
            StateHasChanged();
            ToastService.ShowSuccess($"Betonsterkteklasse bijgewerkt naar {klasse}");
        }
    }

    private async Task VerwijderMateriaal(Guid id)
    {
        // Zoek het materiaal op
        if (!Project.Materialen.TryGetValue(id, out var materiaal))
        {
            ToastService.ShowError("Materiaal niet gevonden");
            return;
        }

        // Check of materiaal in gebruik is
        var assemblagesMetDitMateriaal = Project.Assemblages
            .Where(a => a.Materiaal?.Id == id)
            .ToList();

        if (assemblagesMetDitMateriaal.Any())
        {
            // Toon waarschuwing met lijst van assemblages
            var assemblageNamen = string.Join(", ", assemblagesMetDitMateriaal.Select(a => a.Merk));
            
            var dialog = await DialogService.ShowWarningAsync(
                $"Dit materiaal ({materiaal.UserFriendlyName}) wordt gebruikt in {assemblagesMetDitMateriaal.Count} assemblage(s): {assemblageNamen}",
                "Je kunt dit materiaal niet verwijderen"                
            );

            _ = await dialog.Result;
            return;
        }

        // Verwijder materiaal
        Project.VerwijderMateriaal(id);
        StateHasChanged();
    }


}
