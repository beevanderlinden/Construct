@page "/"
@attribute [Authorize]
@using Construct.Domain
@using Construct.WebUI.Server.Components.Debug
@using Construct.WebUI.Server.Components.Pages.Project
@inject IJSRuntime JS
@inject IProjectStateService ProjectState
@inject IFileService FileService
@inject IToastService ToastService
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Env

<PageTitle>Home</PageTitle>

<h1>Construct</h1>

Welkom bij Construct. Engineer hier uw prefab betonelementen.



<h2>Snelle stappen</h2>

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
    <FluentButton OnClick="NaarNieuwProject" 
                  IconStart="@(new Icons.Regular.Size24.DocumentAdd())">
        Nieuw project
    </FluentButton>
    
    <FluentButton OnClick="NaarOpenProject"
                  IconStart="@(new Icons.Regular.Size24.FolderOpen())">
        Open project
    </FluentButton>
    
    
</FluentStack>






@* <FluentButton OnClick="LaadProjectVanLocalStorage">Ga verder waar ik gebleven was</FluentButton> *@

@code {


    private bool showDefaultsPopup = false;


    private void OpenDefaultsPopup()
    {
        showDefaultsPopup = true;
    }

    private async Task OnDefaultsPopupClose()
    {
        showDefaultsPopup = false;
        await Task.CompletedTask;
    }

    private async Task OnSelectDefaultProject(ProjectFileInfo projectInfo)
    {
        showDefaultsPopup = false;
        if (projectInfo != null)
        {
            var bytes = Convert.FromBase64String(projectInfo.Base64);
            var project = FileService.LoadFromBytes<Construct.Domain.Entities.ProjectEntity>(bytes);
            if (project != null)
            {
                project.InitAll();
                ProjectState.SetProject(project);
                ToastService.ShowSuccess($"Default project '{Path.GetFileName(projectInfo.FilePath)}' geladen.");
                NavigationManager.NavigateTo("/project/info");
            }
            else
            {
                ToastService.ShowError("Kon project niet laden.");
            }
        }
        await Task.CompletedTask;
    }

    private void NaarNieuwProject()
    {
        NavigationManager.NavigateTo("/File/newProjectSaveFile");
    }

    private void NaarOpenProject()
    {
        NavigationManager.NavigateTo("/File/open");
    }

    // Dit werkt niet, nakijken.
    private async Task LaadProjectVanLocalStorage()
    {
        try
        {
            if (ProjectState is null)
            {
                ToastService.ShowError("Geen projectstate aanwezig");
                return;
            }

            await ProjectState?.LoadProjectFromLocalStorageAsync();


            

            

            // Ga naar projectpagina
            //NavigationManager.NavigateTo("/Project/info");
        }
        catch (JSDisconnectedException)
        {
            ToastService.ShowError("Geen verbinding aanwezig,De applicatie is nog aan het verbinden met de server. Probeer het over enkele seconden opnieuw. ");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Er ging iets mis: {ex.Message}");
        }
    }
}
