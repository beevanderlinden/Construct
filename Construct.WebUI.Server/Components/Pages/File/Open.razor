@code
{
    [CascadingParameter] public ProjectEntity? ProjectEntity { get; set; }
    [CascadingParameter] public IProjectStateService? ProjectState { get; set; }

    private bool progressRingVisible = false;

    protected override void OnInitialized()
    {
        if (ProjectState != null)
        {
            ProjectState.OnProjectChanged += StateHasChanged;
        }
    }

    public void Dispose()
    {
        if (ProjectState != null)
        {
            ProjectState.OnProjectChanged -= StateHasChanged;
        }
    }

    private JsonSerializerOptions jsonOptions = new()
        {
            WriteIndented = true,
            ReferenceHandler = ReferenceHandler.IgnoreCycles,
            NumberHandling = JsonNumberHandling.AllowNamedFloatingPointLiterals,
            PropertyNameCaseInsensitive = true,
        };

    //int ProgressPercent = 0;
    FluentInputFileEventArgs[] Files = Array.Empty<FluentInputFileEventArgs>();

    private async Task OnCompletedAsync(IEnumerable<FluentInputFileEventArgs> files)
    {
        progressRingVisible = true;
        Files = files.ToArray();

        // For the demo, delete these files.
        foreach (var file in Files)
        {
            file.LocalFile?.Delete();

            string? result = null;
            var stream = file.Stream;
            if (stream != null)
            {
                var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                ms.Position = 0;
                StreamReader reader = new(ms);
                result = await reader.ReadToEndAsync();

                if (result != null)
                {
                    //var options = new JsonSerializerOptions

                    // var settings = new JsonSerializerSettings
                    //     {
                    //         TypeNameHandling = TypeNameHandling.Auto,
                    //         ReferenceLoopHandling = ReferenceLoopHandling.Ignore,
                    //         Formatting = Formatting.Indented,


                    //     };
                    //var jsonProject = JsonConvert.DeserializeObject<Domain.Entities.ProjectEntity>(result, settings);

                    var jsonProject = System.Text.Json.JsonSerializer.Deserialize<Construct.Domain.Entities.ProjectEntity>(result, jsonOptions);



                    if (jsonProject != null)
                    {
                        jsonProject.InitAll();
                        ProjectState?.SetProject(jsonProject); //🏭 gebruik ProjectStateService
                        Console.WriteLine($"Project geladen : {jsonProject}");

                    }

                }


            }









        }

        // Wait before to reset the progress bar.
        await Task.Delay(80);
        //ProgressPercent = 0;
        progressRingVisible = false;
        // refresh aka
        StateHasChanged();

        // Ververs door naar de home pagina te gaan.
        NavManager.NavigateTo("/");

    }



    async Task<MemoryStream> ToMemoryStreamAsync(Stream stream)
    {
        var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        ms.Position = 0;
        return ms;
    }

    private async void LoadFile(InputFileChangeEventArgs e)
    {
        string? result = null;
        var stream = e.File.OpenReadStream(long.MaxValue);
        var memoryStream = await ToMemoryStreamAsync(stream);
        StreamReader reader = new(memoryStream);
        result = await reader.ReadToEndAsync();

        if (result != null)
        {
            var jsonProject = JsonConvert.DeserializeObject<Construct.Domain.Entities.ProjectEntity>(result);
            if (jsonProject != null)
            {
                //jsonProject;
                //
                // inspecteer
                //var info = ProjectInfoViewModel;
                //projectStatus.Project = Project;
                //projectStatus.ProjectInfo = new ProjectInfoModel() {
                //    ProjectName = Project.ProjectInfo.Naam,
                //    ProjectNumber = Project.ProjectInfo.Nummer
                //};
            }



            StateHasChanged();
        }



    }



}





