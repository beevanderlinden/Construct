    private void ToetsM(InternalForces krachten, string positie)
    {
        // Update moment in berekening via Snedekrachten
        bendingResults = new();
        bendingResults.PosLabel = positie;
        bendingResults.Beton = betonContext;
        bendingResults.Wapening = wapeningBoven; // Aanname: negatief moment = bovenwapening
        bendingResults.Profiel = new Profielen.Beton.BetonProfiel
        {
            Breedte = breedte,
            Hoogte = hoogte,
        };
        bendingResults.Snedekrachten = new SectionForces();
        bendingResults.Snedekrachten.My = (krachten.My);
        
        // Forceer herberekening en validatie
        bendingResults.BerekenEnValideer();
        
        bendingResultsOnder = new();
        bendingResultsOnder.PosLabel = positie;
        bendingResultsOnder.Beton = betonContext;
        bendingResultsOnder.Wapening = wapeningOnder; // Positief moment = onderwapening
        bendingResultsOnder.Profiel = new Profielen.Beton.BetonProfiel(breedte, hoogte);
        bendingResultsOnder.Snedekrachten = new SectionForces();
        bendingResultsOnder.Snedekrachten.My = (krachten.My);
        
        // Forceer herberekening en validatie
        bendingResultsOnder.BerekenEnValideer();
        
        // Bepaal welke wapening maatgevend is (boven of onder) op basis van teken moment
        if (krachten.My > 0)
        {
            selectedBendingResult = bendingResults;
            bendingDetailsTitle = $"Momentweerstand - {positie}";
        }
        else
        {
            selectedBendingResult = bendingResultsOnder;
            bendingDetailsTitle = $"Momentweerstand - {positie}";
        }
        
        showBendingDetails = true;
    }
    
    private void ToetsV(InternalForces krachten, string positie)
    {
        // Update dwarskracht in berekening
        shearResult = new()
        {
            Beton = betonContext,
            Profiel = new Profielen.Beton.BetonProfiel(breedte, hoogte),
            AsLangs = wapeningBoven.As + wapeningOnder.As,
            NutHoogte = hoogte - wapeningBoven.ZRef,
            AswToegepast = beugelWapening.Asw
        };
        
        // Update snedekrachten met de specifieke dwarskracht
        shearResult.Snedekrachten = new SectionForces();
        shearResult.Snedekrachten.Vz = Math.Abs(krachten.Vz);
        
        // Forceer herberekening en validatie
        shearResult.BerekenEnValideer();
        
        bendingDetailsTitle = $"Dwarskrachtweerstand - {positie}";
        showShearDetails = true;
    }
    
