    private void UpdateZijwapening()
    {
        if (toonZijwapening && aantalZijwapening > 0)
        {
            wapeningZijLinks ??= new();
            wapeningZijLinks.Tekst = $"{aantalZijwapening}r{diameterZijwapening}";
            wapeningZijLinks.ReferentieLengte = hoogte;
            wapeningZijLinks.DekkingToegepast = beugelWapening.DekkingLinks + beugelWapening.Diameter;

          
            wapeningZijRechts ??= new();
            wapeningZijRechts.Tekst = $"{aantalZijwapening}r{diameterZijwapening}";
            wapeningZijRechts.ReferentieLengte = hoogte;
            wapeningZijRechts.DekkingToegepast = beugelWapening.DekkingRechts + beugelWapening.Diameter;
           
        }
        else
        {
            wapeningZijLinks = null;
            wapeningZijRechts = null;
        }
    }
    
    private void ResetToDefault()
    {
        breedte = 300;
        hoogte = 400;
        
        // Reset BetonContext
        betonContext = new()
        {
            Betonsterkteklasse = BetonsterkteklasseEnum.C30_37,
        };
        
