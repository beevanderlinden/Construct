    private DIA.OptionsContext GetLoadCaseDiagramOptions(BelastingGeval? geval)
    {
        return DIA.OptionsContext.GetFiguur(geval);
    }

    private DIA.OptionsContext GetLoadCaseDemo(BelastingGeval? geval)
    {
        return DIA.OptionsContext.GetDiagram(geval, DIA.DiagramType.ShearForceVz);
    }

    private DIA.OptionsContext GetLoadCaseDemoM(BelastingGeval? geval)
    {
        return DIA.OptionsContext.GetDiagram(geval, DIA.DiagramType.BendingMomentMy);
    }


    private IEnumerable<DIA.OptionsContext> GetCombinationDiagrams(
    BelastingCombinatieTypeEnum type)
    {
        switch (type)
        {
            case BelastingCombinatieTypeEnum.Fundamenteel_A:
            case BelastingCombinatieTypeEnum.Fundamenteel_B:
            case (BelastingCombinatieTypeEnum.Fundamenteel_A | BelastingCombinatieTypeEnum.Fundamenteel_B):
                return new[]
                {
                DIA.OptionsContext.GetDiagram(type, DIA.DiagramType.BendingMomentMy),
                 DIA.OptionsContext.GetDiagram(type, DIA.DiagramType.ShearForceVz),
                };
            default:
                return new[]
                {
                DIA.OptionsContext.GetDiagram(type, DIA.DiagramType.BendingMomentMy),
                DIA.OptionsContext.GetDiagram(type, DIA.DiagramType.DeflectionW),
                };

        }
    }





    private string? _activeTabId = "tab1";
    FluentTab? activeTab;
    private void HandleOnTabChange(FluentTab tab)
    {
        activeTab = tab;
    }

    async Task BijwerkenAsync()
    {
        Beam.Compute();
        if (BeamChanged.HasDelegate)
        {
            await BeamChanged.InvokeAsync(Beam); // informeert ouder
        }
    }
   

    async Task AddPointLoad(BelastingGeval lc)
    {
        Mechanica.SimpleBeam.PointLoad pl = new(Beam.Length / 2.0, -10)
        {
            LoadCase = lc, 
            Name = $"F{Beam.Loads.OfType<PointLoad>().Count()+1}"
        };
        Beam.Loads.Add(pl);
        await BijwerkenAsync();
    }

    async Task AddDistributedLoad(BelastingGeval lc)
    {
        Mechanica.SimpleBeam.DistributedLoad distributedLoad = new(0, Beam.Length, -10) 
        { 
            LoadCase = lc, 
            Name = $"DL{Beam.Loads.OfType<DistributedLoad>().Count()+1}" 
        };
        Beam.Loads.Add(distributedLoad);
        await BijwerkenAsync();
    }

    async Task DeleteLoad(ILoad load)
    {
        Beam.Loads.Remove(load);
        await BijwerkenAsync();
    }


    private void ProfielGekozen(IProfiel profiel)
    {
        if (profiel == null) return;
        Beam.Profiel = (BaseProfiel)profiel;
    }

    // Tabellen worden nu tegenereerd via BeamResultsHelper (gedeelde logica)
    // Zie: Construct.WebUI.Server\Components\Beam\BeamResultsHelper.cs
   
