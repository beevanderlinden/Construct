@using System.ComponentModel.DataAnnotations
@using System.Collections.Generic
@using CommonLibrary.Models
@using Construct.Application.Services
@using Construct.WebUI.Server.Helpers
@using Eurocode.HoutConstructies
@using Eurocode.StaalConstructies
@using Microsoft.AspNetCore.Components
@using Eurocode.Belastingen
@using Mechanica.SimpleBeam
@using System.Globalization
@using DIA = Construct.Application.Diagrams
@using CommonLibrary.Interfaces





<div>
    <FluentTabs @bind-ActiveTabId="_activeTabId" OnTabChange="HandleOnTabChange" Size="TabSize.Medium" >

        <FluentTab Id="tab1" Label="geometrie">
            <Content>
                <BeamDiagram @bind-Beam="Beam"
                             Options="@GetLoadCaseDiagramOptions(null)" />


                @if (CanEdit)
                {
                    <KaskonInputContainer Label="schema">
                        <FluentSelectEnum TEnum="SchemaType" @bind-EnumSelectedValue="@Beam.Schematisering" LabelPosition="LabelPosition.Top" />
                    </KaskonInputContainer>

                    <KaskonInputContainer Label="lengte">
                        <FluentNumberField @bind-Value="Beam.Length" TValue="double" Step="0.1" Min="0" Max="40"></FluentNumberField>
                    </KaskonInputContainer>



                    <KaskonInputContainer Label="profiel">
                        <FluentTextField Disabled="true" Value="@Beam.Profiel?.Naam"></FluentTextField>
                    </KaskonInputContainer>


                    <KaskonInputContainer Label="grade">
                        <FluentTextField Disabled="true" Value="@Beam.Materiaal?.Naam"></FluentTextField>
                    </KaskonInputContainer>

                    <KaskonInputContainer Label="EI">
                        <FluentTextField Disabled="true" Value="@(Beam.EI.ToString("E"))"></FluentTextField>
                    </KaskonInputContainer>
                }

                


                @if (Beam.Profiel is BaseProfiel p)
                {

                    @* <BaseProfielView Profiel="p" /> *@

                }
               

                @if (Beam.Materiaal is BaseMateriaal m)
                {
                    var tblMateriaal = BeamResultsHelper.GetTabelMateriaalEigenschappen([m]);
                    
                    <TableContentRenderer 
                        Table="tblMateriaal"
                        Title="Materiaal eigenschappen"  />

                    if (m is BetonContext beton)
                    {
                        var tbl = BeamResultsHelper.GetTabelMateriaalEigenschappen([beton]);
                        <TableContentRenderer Table = "tbl" />
                    }
                    if (m is StaalContext staal)
                    {
                        var tbl = BeamResultsHelper.GetTabelMateriaalEigenschappen([staal]);
                        <TableContentRenderer Table="tbl" />
                    }
                    if (m is HoutContext hout)
                    {
                        var tbl = BeamResultsHelper.GetTabelMateriaalEigenschappen([hout]);
                        <TableContentRenderer Table="tbl" />
                    }
                }
            </Content>
        </FluentTab>
       
        @if (Beam.LoadContext != null)
        {
            @foreach (var lc in Beam.LoadContext.BelastingGevallen)
            {
                <FluentTab Id="@($"tab-lc-{lc.Id}")" Label="@lc.Naam">
                    <Content>
                        <BeamDiagram @bind-Beam="Beam"
                                     Options="@GetLoadCaseDiagramOptions(lc)" />

                        <BeemLoadCase @bind-Beam="Beam"
                                      LoadCase="lc" />
           
                    </Content>
                </FluentTab>
            }

            @foreach (var tab in _combiTabGroups)
            {
                <FluentTab Id="@($"tab-{tab.Key}")" Label="@tab.Key">
                    <Content>
                        

                        @foreach (var diagram in GetCombinationDiagrams(tab.Value))
                        {
                            if (Beam.IsDirty)
                            {
                                <FluentButton OnClick="BijwerkenAsync"
                                                Style="z-index:9999;">
                                    Bijwerken
                                </FluentButton>
                            }
                            <BeamDiagram @bind-Beam="Beam"
                                            Options="diagram"
                                            Height="200px" />
                        }
                       
                        @if (tab.Key.ToLower().StartsWith("fun") && Beam.Profiel is BaseProfiel profiel && Beam.Materiaal is BaseMateriaal materiaal)
                        {
                            var tblKrachten = BeamResultsHelper.GetTabelSnedeKrachten(Beam, maxRows: 10);
                            var tblToetsen = BeamResultsHelper.GetTabelSnedeToetsen(Beam, profiel, materiaal, sectionClass: 1, maxRows: 10);

                            
                            <TableContentRenderer Table="tblKrachten" 
                                                  Title="Snedekrachten" />


                            @if (profiel is IHoutProfiel || profiel is IStaalProfiel)
                            {
                                <TableContentRenderer Table="tblToetsen"
                                                      Title="Snede-toetsen" />
                            }

                            @if (materiaal is BetonContext beton)
                            {
                                var tblM = BeamResultsHelper.GetTabelBendingResults(Beam, profiel, beton);
                                <TableContentRenderer Table="tblM.Hoofd" Title="Momentwapening" />

                                

                            }




                        }
                        



                    </Content>
                </FluentTab>
            }
        }
       
    </FluentTabs>
</div>


<div>
    @if (Beam.IsDirty)
    {
        <FluentButton OnClick="BijwerkenAsync">Bijwerken</FluentButton>

    }
    else{
        <FluentButton OnClick="BijwerkenAsync">Bijwerken</FluentButton>

    }
</div>



   

  



   





