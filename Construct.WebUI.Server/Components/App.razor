<!DOCTYPE html>
<html lang="en">





<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="Construct.WebUI.Server.styles.css" />
    @* <link rel="stylesheet" href="_content/Microsoft.FluentUI.AspNetCore.Components/fluentui.css" /> *@
    <link rel="stylesheet" href="css/custom.css" />

   


    <link rel="icon" type="image/png" href="favicon.ico" /> <!-- Kan ook een png bestand gebruiken -->
    <HeadOutlet />
</head>

<body>

    <!-- Set the default team ("mode" overrides the 'storage-name') prevent blinking -->
    @* <script src="_content/Microsoft.FluentUI.AspNetCore.Components/js/loading-theme.js" type="text/javascript"></script> *@
    @* <loading-theme storage-name="theme"></loading-theme> *@
    <!-- End -->

    <Routes @rendermode="InteractiveServer" /> <!-- Noodzakelijk !! voor interactiviteit vanuit Fluent aanwijzing -->
    <script src="js/scripts.js?v=@DateTime.Now.Ticks"></script>

   
    <script src="js/usePlotly.js?v=@DateTime.Now.Ticks"></script>
    <script src="js/gl-matrix.js?v=@DateTime.Now.Ticks"></script>
    <script src="js/filesystem.js?v=@DateTime.Now.Ticks"></script>
    <script src="js/dirInterop.js?v=@DateTime.Now.Ticks"></script>
    <script src="js/idb.min.js"></script> <!-- Idb library voor dirInterop (hosted locally to avoid tracking prevention issues) -->

    @* <script src="https://cdn.plot.ly/plotly-latest.min.js"></script> *@
    <script src="https://cdn.plot.ly/plotly-2.32.0.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gl-matrix/3.4.3/gl-matrix-min.js"></script>

    <script src="_framework/blazor.web.js"></script>
    <script src="js/svgHelpers.js"></script>


   

</body>

</html>
