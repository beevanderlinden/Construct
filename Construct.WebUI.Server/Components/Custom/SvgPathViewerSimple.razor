<svg xmlns="http://www.w3.org/2000/svg"
     style="width:100%; height:auto; border:1px solid lightgray; overflow:visible;">
    <g transform="translate(@Margin,@Margin)">
        @foreach (var path in Paths)
        {
            <path d="@path" fill="lightgray" stroke="black" stroke-width="2" />
        }
    </g>
</svg>

@code {
    [Parameter, EditorRequired] public IEnumerable<string> Paths { get; set; } = [];
    [Parameter] public double Margin { get; set; } = 50;
}
