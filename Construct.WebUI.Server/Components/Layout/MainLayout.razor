@using Construct.Application.Interfaces
@using Construct.Domain
@using Construct.WebUI.Server.Components.Pages.Project
@using Construct.WebUI.Server.Shared.ViewModels
@using Microsoft.Extensions.Hosting


@inherits LayoutComponentBase
@implements IDisposable
@inject IDialogService DialogService
@inject IHostEnvironment Environment
@inject IProjectStateService ProjectState
@inject IFileService FileService
@inject ILogService LogService


<HeadContent>
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="Construct.WebUI.Server.styles.css" />
    <link rel="stylesheet" href="css/custom.css?v=@DateTime.Now.Ticks" />

    <link rel="icon" type="image/png" href="favicon.ico" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>

    <!-- KaTeX -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>

    <!-- Popper + Tippy -->
    <script src="https://unpkg.com/@@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://unpkg.com/tippy.js@6/dist/tippy-bundle.umd.min.js"></script>

    <!-- Jouw script -->
    <script src="js/formula-tooltips.js"></script>



</HeadContent>


<FluentDesignTheme StorageName="theme" /> 

<PageTitle>CONSTRUCT®</PageTitle>

<CascadingAuthenticationState>
    <CascadingValue Value="ProjectState.CurrentProject" IsFixed="false">
    <CascadingValue Value="ProjectState">

        <FluentLayout>
            <FluentHeader>
                <FluentStack Orientation="Orientation.Horizontal" Width="100%" VerticalAlignment="VerticalAlignment.Center">
                    <FluentStack Orientation="Orientation.Horizontal" Width="100px" Class="hide-on-phoneX">
                        <div>
                            CONSTRUCT®
                        </div>
                    </FluentStack>
                    <FluentSpacer />
                    <FluentStack Class="hide-on-phoneX" HorizontalAlignment="HorizontalAlignment.End">
                        <MgtLogin />
                    </FluentStack>
                    <FluentSpacer />
                </FluentStack>
            </FluentHeader>

            <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%" HorizontalGap="0">
                <NavMenu />
                <FluentBodyContent Class="body-content">
                    <div class="content">
                        @Body
                    </div>
                </FluentBodyContent>
            </FluentStack>


              


             <FluentFooter Style="height:20px; padding:5px;">
                    <span class="log-footer">🧾 @_lastLine</span>
                    <FluentSpacer />
                    <span>@ProjectState?.CurrentProject?.ProjectInfo?.ToString()</span>
                    <FluentSpacer />

                    <span class="log-footer">📨
                        
                        @if (LogService.IsBusy)
                        {
                            <div class="spinner" />
                        
                            <span>Working...</span>
                        }
                        else
                        {
                            <span>Ready</span>
                        }

                    </span>
                    <FluentSpacer />
                    <UndoRedoComponent />

            </FluentFooter> 

        </FluentLayout>


        <FluentDialogProvider />
        <FluentMenuProvider />
        <FluentToastProvider MaxToastCount="10" />
        <FluentMessageBarProvider />
        <FluentTooltipProvider />

    </CascadingValue>
</CascadingValue>
</CascadingAuthenticationState>


