<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code
{
    private string? _lastLine;
    private Guid InstanceId = Guid.NewGuid();
    private int RenderCount;

  

   




    protected override void OnAfterRender(bool firstRender)
    {
        RenderCount++;

        if (!firstRender)return;

        ProjectState.OnProjectChanged += StateHasChanged;

        _lastLine = LogService.LastLine;
        LogService.LogUpdated += OnLogUpdated;
        LogService.WriteLine("[OnAfterRender] Applicatie opgestart");
    }

    //protected override bool ShouldRender()
    //{
        //Console.WriteLine($"[{InstanceId}] ShouldRender called. _lastLine='{_lastLine}'");
    //    return true; // for diagnostic purposes
    //}

   


    public void Dispose()
    {
        ProjectState.OnProjectChanged -= StateHasChanged;
        LogService.LogUpdated -= OnLogUpdated;
    }

    public void CreateNewProject()
    {
        ProjectEntity newProject = new() { ProjectInfo = new() { Naam = "MyProject", Nummer = "9999", Plaatsnaam = "ROTTERDAM"} };
        ProjectState.SetProject(newProject);
    }


    private void OnLogUpdated(string message)
    {
        _lastLine = message;
        InvokeAsync(StateHasChanged);
    }


    private async Task ShowSettingAsync()
    {
        await DialogService.ShowPanelAsync<Pages.Settings>(new DialogParameters() { 
            Title = "Settings", 
            Alignment = HorizontalAlignment.Right, 
            SecondaryAction = null });

    }

   
}
