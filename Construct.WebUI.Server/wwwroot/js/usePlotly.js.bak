    //const maxZ = geometry.nodes.max(n => n.z);
    //const ninZ = geometry.nodes.min(n => n.z);

    //const dx = maxX - minX;
    //const dz = maxZ - minZ;

    //const maxSize = max(dx, dz);

    // maximale magnitude
    //const maxStart = geometry.memberForces.max(n => n.startMagnitude);
    //const maxEnd = geometry.memberForces.max(n => n.endMagnitude);

    //const minStart = geometry.memberForces.min(n => n.startMagnitude);
    //const minEnd = geometry.memberForces.min(n => n.endMagnitude);

    //const max = max(abs(max(maxStart, maxEnd)), abs(min(minStart, minEnd)));

    // het grootste figuur is 20mm
    // uitgaande van een A4 breedte circa 200mm en figuren niet hoger dan 200mm
    // stel een geometrie van 12m dan is schaal 200/12000 = 
    

    memberForces.map(createMemberForce);



    const newArray = memberForces.map(createMemberForce);

    return newArray;


   


}



function getMemberForceTest(memberForce) {



    const { mat2, vec2 } = glMatrix;

    // verplaats eerst naar startNode


    const theta = Math.PI / 2;
    const rotationMatrix = mat2.fromRotation(mat2.create(), theta);
    // Define the original point
    const point = vec2.fromValues(1, 0);

    // Create a vector to store the rotated point
    const rotatedPoint = vec2.create();

    // Apply the rotation matrix to the point
    vec2.transformMat2(rotatedPoint, point, rotationMatrix);



}

